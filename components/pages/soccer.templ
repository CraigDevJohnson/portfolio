package pages

import "portfolio/components/layouts"
import "portfolio/components/partials"

type SoccerProps struct {
	GoogleMessage     string
	GoogleMessageKind string
}

templ Soccer(props SoccerProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Soccer Schedule Download - Craig Johnson",
		Page:  "soccer",
	}) {
		<!-- Hero with animated orbs -->
		<section class="page-hero soccer-hero">
			<div class="soccer-hero-bg" aria-hidden="true">
				<div class="soccer-hero-orb soccer-hero-orb-1"></div>
				<div class="soccer-hero-orb soccer-hero-orb-2"></div>
				<div class="soccer-hero-orb soccer-hero-orb-3"></div>
			</div>
			<div class="hero-header">
				<div class="hero-badge">
					<span class="hero-badge-dot" aria-hidden="true"></span>
					Schedule Tool
				</div>
				<h1>Soccer Schedule Download</h1>
				<p class="lead">
					Never miss a game again. Pull live schedules from
					<a href="https://www.letsplaysoccer.com/4?lang=en" target="_blank" rel="noopener noreferrer">
						Let's Play Soccer
					</a>
					and export them to your favorite calendar app or add them directly to Google Calendar in seconds.
				</p>
			</div>
		</section>
		<!-- How It Works -->
		<section class="soccer-how-it-works">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>How It Works</span>
			</div>
			<div class="how-it-works-grid">
				<div class="step-card">
					<div class="soccer-icon-wrap">
						<span class="step-icon">🔍</span>
					</div>
					<span class="step-number">Step 1</span>
					<h3 class="step-title">Sign In On LPS</h3>
					<p class="step-desc">Open your own Let's Play Soccer account in the browser and keep that tab signed in</p>
				</div>
				<div class="step-card">
					<div class="soccer-icon-wrap">
						<span class="step-icon">⚡</span>
					</div>
					<span class="step-number">Step 2</span>
					<h3 class="step-title">Import Your Access</h3>
					<p class="step-desc">Copy the bearer JWT from DevTools, then import it below to discover your linked players automatically</p>
				</div>
				<div class="step-card">
					<div class="soccer-icon-wrap">
						<span class="step-icon">📅</span>
					</div>
					<span class="step-number">Step 3</span>
					<h3 class="step-title">Fetch And Export</h3>
					<p class="step-desc">Load schedules for your discovered players, then export an .ics file or add selected games directly to Google Calendar</p>
				</div>
			</div>
		</section>
		<!-- Features -->
		<section class="soccer-features">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Built For Players</span>
			</div>
			<div class="features-grid">
				<div class="feature-card">
					<div class="soccer-icon-wrap">
						<span class="feature-icon">🎯</span>
					</div>
					<h3 class="feature-title">Automatic Player Discovery</h3>
					<p class="feature-desc">Import your bearer JWT and the app will discover the linked players available in that authenticated LPS session</p>
				</div>
				<div class="feature-card">
					<div class="soccer-icon-wrap">
						<span class="feature-icon">🔄</span>
					</div>
					<h3 class="feature-title">Session-Only Import</h3>
					<p class="feature-desc">Your imported JWT stays in an encrypted HttpOnly cookie for the current browser session only</p>
				</div>
				<div class="feature-card">
					<div class="soccer-icon-wrap">
						<span class="feature-icon">📱</span>
					</div>
					<h3 class="feature-title">Google Or Universal Calendar</h3>
					<p class="feature-desc">Add selected games directly to Google Calendar or keep using ICS with Apple Calendar, Outlook, and more</p>
				</div>
			</div>
		</section>
		<!-- Schedule Tool -->
		<section class="soccer-content">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Fetch Schedules</span>
			</div>
			<div class="soccer-unified-card">
				if props.GoogleMessage != "" {
					<div class={ "soccer-login-message soccer-login-message-" + props.GoogleMessageKind } role="status">
						{ props.GoogleMessage }
					</div>
				}
				<div class="unified-header">
					<div class="unified-form-section">
						<div class="soccer-manual-entry soccer-input-section">
							<h3>Manual team IDs</h3>
							<form
								id="fetch-form"
								class="fetch-form"
								hx-post="/soccer/fetch"
								hx-target="#games-container"
								hx-swap="innerHTML"
								hx-indicator="#loading-indicator, .soccer-manual-submit-indicator"
								hx-disabled-elt="find button[type='submit']"
								autocomplete="off"
							>
								<div class="form-group">
									<label for="team_codes" class="form-label">Team IDs</label>
									<div class="input-row">
										<input
											id="team_codes"
											name="team_codes"
											class="text-input"
											type="text"
											placeholder="e.g. 479691, 479147"
											pattern="\d+([\s,;]+\d+)*"
											required
											aria-describedby="team-codes-hint"
										/>
										<button type="submit" class="btn btn-primary fetch-btn btn-loading" data-loading-button>
											<span class="btn-text">Fetch Schedules</span>
											<span class="btn-loading-indicator soccer-manual-submit-indicator htmx-indicator" aria-hidden="true"></span>
										</button>
									</div>
									<div id="team-codes-hint" class="form-hint">
										Supports
										<em>Let&apos;s Play Soccer</em>
										teams only. Enter numeric team IDs separated by commas.
									</div>
								</div>
							</form>
						</div>
						<div
							id="soccer-auth-panel"
							class="soccer-auth-panel soccer-auth-panel-loading"
							hx-get="/soccer/session"
							hx-trigger="load"
							hx-swap="outerHTML"
						>
							<div class="soccer-google-shell soccer-input-section">
								<div class="soccer-google-copy">
									<h3>Google Calendar connection</h3>
									<p>Connect Google Calendar, choose a destination calendar, and load schedules for discovered players from the JWT import tools below.</p>
								</div>
								<p class="soccer-panel-loading-state">Loading Google Calendar connection...</p>
							</div>
							<div class="soccer-auth-shell soccer-input-section">
								<div class="soccer-auth-copy">
									<h3>JWT import access</h3>
									<p>Paste a bearer JWT from your signed-in Let&apos;s Play Soccer browser session to discover linked players automatically and refresh stale player access when needed.</p>
								</div>
								<p class="soccer-panel-loading-state">Loading import options...</p>
							</div>
						</div>
					</div>
					<div class="unified-info-section">
						<div class="info-inline">
							<h3>How to Import Access</h3>
							<ol>
								<li>
									Visit
									<a
										href="https://www.letsplaysoccer.com/4?lang=en"
										target="_blank"
										rel="noopener noreferrer"
									>
										Let's Play Soccer
									</a>
								</li>
								<li>Sign in there first, then open browser DevTools and inspect an authenticated network request</li>
								<li>Copy the bearer JWT from the Authorization header or response data you can already see</li>
									<li>Paste the JWT into the import dialog and click Import. If the discovered player list looks stale, clear import and import again with a fresh JWT.</li>
							</ol>
						</div>
					</div>
				</div>
				<div id="loading-indicator" class="loading-indicator htmx-indicator">
					<div class="spinner"></div>
					<span>Fetching schedules...</span>
				</div>
				<div id="games-container" class="games-container" aria-live="polite">
					<div class="empty-state">
						<p>Import player access or enter team codes above to fetch schedules. Then download an .ics file or add selected games directly to Google Calendar.</p>
					</div>
				</div>
				<div id="subscribe-section" class="subscribe-section" style="display: none">
					<label class="subscribe-checkbox">
						<input id="email-updates-checkbox" type="checkbox"/>
						<span>Subscribe to email updates for schedule changes</span>
					</label>
					<form
						id="subscribe-form"
						class="subscribe-form"
						hx-post="/soccer/subscribe"
						hx-target="#subscribe-result"
						hx-swap="innerHTML"
						hx-indicator=".soccer-subscribe-submit-indicator"
						hx-disabled-elt="find button[type='submit']"
						style="display: none"
					>
						<div class="email-row">
							<input
								id="subscription-email"
								name="email"
								class="text-input email-input"
								type="email"
								placeholder="your@email.com"
								required
								aria-label="Email address for schedule updates"
							/>
							<button type="submit" class="btn btn-primary btn-loading" data-loading-button>
								<span class="btn-text">Subscribe</span>
								<span class="btn-loading-indicator soccer-subscribe-submit-indicator htmx-indicator" aria-hidden="true"></span>
							</button>
						</div>
						<div id="subscribe-result" class="subscribe-result"></div>
					</form>
				</div>
			</div>
		</section>
		@partials.SoccerLoginModal(partials.SoccerLoginModalProps{})
	}
}
