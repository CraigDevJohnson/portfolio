package partials

import "fmt"
import "portfolio/types"

type SoccerPlayerSelectProps struct {
	Players []types.LPSPlayer
}

templ SoccerPlayerSelect(props SoccerPlayerSelectProps) {
	<form
		id="soccer-player-select-form"
		class="soccer-player-select-form"
		hx-post="/soccer/fetch"
		hx-target="#games-container"
		hx-swap="innerHTML"
		hx-indicator="#loading-indicator"
	>
		<fieldset class="soccer-player-fieldset">
			<legend>Choose discovered players</legend>
			<p class="soccer-player-hint">Select one or more discovered players to fetch upcoming games.</p>
			<div class="soccer-player-list">
				for _, player := range props.Players {
					<label class="soccer-player-option">
						<input type="checkbox" name="player_ids" value={ fmt.Sprintf("%d", player.UPlayerID) } checked/>
						<span class="soccer-player-option-copy">
							<span class="soccer-player-name">{ player.FirstName + " " + player.LastName }</span>
							<span class="soccer-player-meta">Discovered player</span>
							if player.IsMainPlayer {
								<span class="soccer-player-badge">Primary</span>
							}
						</span>
					</label>
				}
			</div>
			<button type="submit" class="btn btn-primary soccer-player-submit">Fetch Player Schedules</button>
		</fieldset>
	</form>
}
