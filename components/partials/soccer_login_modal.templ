package partials

type SoccerLoginModalProps struct {
}

templ SoccerLoginModal(props SoccerLoginModalProps) {
	<div id="soccer-login-modal" class="soccer-login-modal" hidden>
		<div class="soccer-login-backdrop" data-close-login-modal></div>
		<div
			class="soccer-login-dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="soccer-login-title"
			aria-describedby="soccer-login-description"
			tabindex="-1"
		>
			<div class="soccer-login-header">
				<h2 id="soccer-login-title">Import Let&apos;s Play Soccer access</h2>
				<button type="button" class="soccer-modal-close" aria-label="Close import dialog" data-close-login-modal>
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<p id="soccer-login-description" class="soccer-login-description">
				Paste the bearer JWT and manual player IDs from your own signed-in Let&apos;s Play Soccer browser session.
			</p>
			<ol class="soccer-login-instructions">
				<li>Sign in on letsplaysoccer.com in another tab.</li>
				<li>Open browser DevTools, inspect an authenticated request, and copy the bearer JWT.</li>
				<li>Copy one or more player IDs from the same request path or payload.</li>
			</ol>
			<form
				id="soccer-login-form"
				class="soccer-login-form"
				hx-post="/soccer/import"
				hx-target="#soccer-login-feedback"
				hx-swap="innerHTML"
				autocomplete="off"
			>
				<div class="form-group">
					<label for="soccer-import-jwt" class="form-label">Bearer JWT</label>
					<textarea
						id="soccer-import-jwt"
						name="jwt"
						class="text-input"
						rows="5"
						spellcheck="false"
						required
						aria-required="true"
						aria-describedby="soccer-import-jwt-hint"
						placeholder="Bearer eyJhbGciOi..."
					></textarea>
					<p id="soccer-import-jwt-hint" class="soccer-login-note">You can paste the full Authorization header value or only the JWT.</p>
				</div>
				<div class="form-group">
					<label for="soccer-import-player-ids" class="form-label">Player IDs</label>
					<textarea
						id="soccer-import-player-ids"
						name="player_ids"
						class="text-input"
						rows="3"
						spellcheck="false"
						required
						aria-required="true"
						aria-describedby="soccer-import-player-ids-hint"
						placeholder="12345, 67890"
					></textarea>
					<p id="soccer-import-player-ids-hint" class="soccer-login-note">Separate IDs with commas, spaces, or new lines.</p>
				</div>
				<p class="soccer-login-note">
					This server stores the imported JWT only in an encrypted HttpOnly cookie for the current browser session and clears it when you choose Clear import.
				</p>
				<div id="soccer-login-feedback" class="soccer-login-feedback" aria-live="polite"></div>
				<div class="soccer-login-actions">
					<button type="button" class="btn soccer-secondary-btn" data-close-login-modal>
						Cancel
					</button>
					<button type="submit" class="btn btn-primary">
						Import access
					</button>
				</div>
			</form>
		</div>
	</div>
}
