package partials

import (
	"fmt"
	"portfolio/types"
	"strings"
)

type SoccerLoginStateProps struct {
	Session *types.SessionData
	SwapOOB bool
}

func soccerUserDisplayName(session *types.SessionData) string {
	if session == nil {
		return ""
	}

	fullName := strings.TrimSpace(session.User.FirstName + " " + session.User.LastName)
	if fullName != "" {
		return fullName
	}
	if session.User.Email != "" {
		return session.User.Email
	}
	return "Let's Play Soccer user"
}

templ SoccerLoginState(props SoccerLoginStateProps) {
	<div
		id="soccer-login-state"
		class="soccer-login-state"
		if props.SwapOOB {
			hx-swap-oob="innerHTML"
		}
	>
		if props.Session == nil {
			<div class="soccer-login-panel">
				<div>
					<h3>Link your Let's Play Soccer account</h3>
					<p>Sign in once to auto-discover your players and pull live upcoming schedules.</p>
				</div>
				<button
					type="button"
					class="btn btn-primary soccer-login-btn"
					data-soccer-login-open
					aria-controls="soccer-login-modal"
					aria-haspopup="dialog"
				>
					Connect account
				</button>
			</div>
		} else {
			<div class="soccer-login-panel soccer-login-panel-active">
				<div>
					<span class="soccer-login-pill">Connected</span>
					<h3>{ fmt.Sprintf("Welcome, %s", soccerUserDisplayName(props.Session)) }</h3>
					<p>Choose one or more linked players below to fetch live schedules.</p>
				</div>
				<form
					class="soccer-logout-form"
					hx-post="/soccer/logout"
					hx-target="#soccer-session-loader"
					hx-swap="none"
				>
					<button type="submit" class="btn btn-secondary">Log out</button>
				</form>
			</div>
		}
	</div>
}
