package partials

import "portfolio/types"

type SoccerLoginStateProps struct {
	Authenticated  bool
	UserName       string
	Players        []types.LPSPlayer
	LoginAvailable bool
	SwapOOB        bool
}

templ SoccerLoginState(props SoccerLoginStateProps) {
	<div
		id="soccer-auth-panel"
		class="soccer-auth-panel"
		if props.SwapOOB {
			hx-swap-oob="outerHTML"
		}
	>
		if props.Authenticated {
			<div class="soccer-auth-summary">
				<div>
					<p class="soccer-auth-status">Imported</p>
					<p class="soccer-auth-user">Bearer JWT saved for this browser session. Choose which imported player IDs to fetch below.</p>
				</div>
				<button
					type="button"
					class="btn soccer-secondary-btn"
					hx-post="/soccer/logout"
					hx-target="#soccer-auth-panel"
					hx-swap="outerHTML"
				>
					Clear import
				</button>
			</div>
			@SoccerPlayerSelect(SoccerPlayerSelectProps{Players: props.Players})
		} else if props.LoginAvailable {
			<div class="soccer-auth-summary">
				<div>
					<p class="soccer-auth-status">No import active</p>
					<p class="soccer-auth-user">Paste a bearer JWT and one or more manual player IDs from your signed-in Let&apos;s Play Soccer browser session.</p>
				</div>
				<button type="button" class="btn btn-primary" data-open-login-modal>
					Import access
				</button>
			</div>
		} else {
			<div class="soccer-auth-unavailable" role="status">
				<p>JWT import is unavailable until the session encryption key is configured on the server.</p>
			</div>
		}
	</div>
}
