# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Markdown settings (trailing spaces can be significant for hard line breaks)
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = 80

# Go files — use tabs to align with gofmt and the Go toolchain (necessary exception)
[*.go]
indent_style = tab
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Lock files and binary assets
[*.lock]
trim_trailing_whitespace = false
insert_final_newline = false

[*.png]
charset = binary

[*.jpg]
charset = binary

[*.gif]
charset = binary
