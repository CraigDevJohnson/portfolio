#!/usr/bin/env bash

# Proves what a visitor sees of site identity in one browser session: public
# pages through shared navigation, the Sign in entry carrying the page the
# visitor came from to the sign-in landing, the signed-in account in shared
# navigation, and the visible and enforced difference between public and
# granted Soccer actions. Account states are preview fixtures and LPS is the
# preview fake. The preview never initializes site Cognito, so this proof
# never completes sign-in: it does not prove sign-in return or account state
# from a session a sign-in produced. Only the internal/app route tests with
# fake Cognito prove those.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
CONTROL="$SCRIPT_DIR/control-portfolio"
STEPS="$SCRIPT_DIR/site-account"
SOCCER_STEPS="$SCRIPT_DIR/soccer-access"
PWCLI="${PORTFOLIO_PWCLI:-/Users/craigjohnson/.codex/skills/playwright/scripts/playwright_cli.sh}"

fail() {
  printf 'prove-site-account: %s\n' "$*" >&2
  exit 1
}

: "${VERIFY_RUN_ID:?set VERIFY_RUN_ID to the launched verification run}"
[[ "$VERIFY_RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail 'invalid VERIFY_RUN_ID'
command -v npx >/dev/null 2>&1 || fail 'npx is required by the Playwright CLI wrapper'
[[ -x "$PWCLI" ]] || fail "Playwright CLI wrapper is not executable: $PWCLI"

RUN_ROOT="$REPO_ROOT/output/playwright/verify-portfolio/$VERIFY_RUN_ID"
STATE_DIR="$RUN_ROOT/state"
EVIDENCE_DIR="$RUN_ROOT/evidence/site-account"
VERIFY_URL="$(<"$STATE_DIR/url")"
SESSION="${PORTFOLIO_PW_SESSION:-portfolio-$VERIFY_RUN_ID}"
TRANSCRIPT="$EVIDENCE_DIR/browser-commands.log"
ASSERTIONS="$EVIDENCE_DIR/assertions.txt"

mkdir -p "$EVIDENCE_DIR"
printf '%s\n' "$SESSION" >"$STATE_DIR/browser-session"
: >"$TRANSCRIPT"
: >"$ASSERTIONS"

run_pw() {
  {
    printf '\n$ playwright-cli --session %q' "$SESSION"
    printf ' %q' "$@"
    printf '\n'
  } >>"$TRANSCRIPT"
  "$PWCLI" --session "$SESSION" "$@" 2>&1 | tee -a "$TRANSCRIPT"
}

# Run one step; its assertions throw, which the CLI reports as an error.
step() {
  local name="$1"
  shift
  printf '\n## %s\n' "$name" >>"$ASSERTIONS"
  local output status=0
  output="$(run_pw run-code "$@")" || status=$?
  printf '%s\n' "$output" | tee -a "$ASSERTIONS"
  if ((status != 0)) || grep -q '^### Error' <<<"$output"; then
    fail "step failed: $name; see $ASSERTIONS"
  fi
}

capture() {
  run_pw snapshot --filename "$EVIDENCE_DIR/$1.md" >/dev/null
  run_pw screenshot --filename "$EVIDENCE_DIR/$1.png" --full-page >/dev/null
}

"$CONTROL" doctor | tee "$EVIDENCE_DIR/doctor.txt"

run_pw open "$VERIFY_URL/"
run_pw resize 1440 1000
capture 00-home-before

step 'Public pages through shared navigation (no sign-in configured)' --filename "$STEPS/01-public-navigation.js"
capture 01-public-navigation-home-after

step 'Sign in entry carries the return destination (preview fixture; sign-in not completed)' --filename "$STEPS/02-sign-in-entry.js"
capture 02-sign-in-landing

step 'Signed-in account in shared navigation (preview fixture, not a signed-in session)' --filename "$STEPS/03-signed-in-account.js"
capture 03-signed-in-account

for fixture in soccer-signed-out soccer-ungranted soccer-granted; do
  step "Soccer grant state: $fixture (preview identity)" "$(sed "s/__FIXTURE__/$fixture/" "$SOCCER_STEPS/01-grant-state.js")"
  capture "04-$fixture"
done

step 'Direct private Soccer requests from the production entry' --filename "$SOCCER_STEPS/02-direct-requests.js"
capture 05-production-soccer-signed-out

run_pw resize 390 844
run_pw goto "$VERIFY_URL/__preview/account/signed-in"
run_pw screenshot --filename "$EVIDENCE_DIR/06-signed-in-account-compact.png" --full-page >/dev/null
step 'Compact signed-in account page fits the viewport' "async page => { const width = await page.evaluate(() => ({ inner: window.innerWidth, scroll: document.documentElement.scrollWidth })); if (width.scroll > width.inner) throw new Error('horizontal overflow at compact width: ' + JSON.stringify(width)); return width }"

run_pw requests | tee "$EVIDENCE_DIR/browser-requests.txt" >/dev/null
run_pw console warning | tee "$EVIDENCE_DIR/browser-console-warning.txt" >/dev/null

(
  cd "$EVIDENCE_DIR"
  find . -type f ! -name manifest.sha256 -print | LC_ALL=C sort | while IFS= read -r artifact; do
    shasum -a 256 "$artifact"
  done
) >"$EVIDENCE_DIR/manifest.sha256"

printf 'site-account proof captured at %s (preview account fixtures and fake LPS; sign-in was not completed, and live Cognito, LPS, and Google were not tested)\n' "$EVIDENCE_DIR"
