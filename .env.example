# Copy this file to .env for Docker Compose. `task run` and
# `task portal-preview` also load the same file when it exists.

# Required for soccer JWT import and encrypted session cookies.
# Generate a value with: openssl rand -hex 32
LPS_SESSION_KEY=

# Optional: override the upstream LPS API base URL for local testing.
LPS_API_BASE_URL=

# Docker Compose needs the container listener on all interfaces. `task run`
# will also bind on all interfaces while it loads this value from .env.
APP_BIND_ALL=true

# Optional logging overrides.
LOG_ADD_SOURCE=false
LOG_FORMAT=json
LOG_LEVEL=info

# Optional: enable Google Calendar connection, selection, add, and result sync.
CLIENT_ID_KEY=
CLIENT_SECRET_KEY=
GOOGLE_CONNECTION_TABLE_NAME=
# Optional: write imported soccer session baselines to DynamoDB.
SOCCER_SESSION_TABLE_NAME=

# Optional site-wide invited Google identity, independent of management AWS clients.
# Generate a separate value for each environment with: openssl rand -hex 32
SITE_SESSION_KEY=
# Cognito hosted UI HTTPS origin and separate user-pool issuer.
SITE_COGNITO_DOMAIN=
SITE_COGNITO_ISSUER=
# Public Cognito client with Google federation and authorization-code + PKCE.
SITE_COGNITO_CLIENT_ID=
# Register the callback exactly at /auth/callback and HTTPS logout landing at /sign-in.
SITE_COGNITO_REDIRECT_URI=
SITE_COGNITO_LOGOUT_URI=
# Reviewed environment-specific email-to-page grants, for example:
# {"craigdevjohnson@gmail.com":["soccer","management"]}
SITE_INVITATIONS_JSON=
# Permit a registered HTTP loopback callback only for local development.
SITE_ALLOW_LOCAL_CALLBACK=false

# Optional: enable the protected EC2 management portal.
# `task portal-preview` sets this automatically for its loopback-only mock.
# A non-loopback listener logs a warning and leaves preview routes disabled.
MGMT_LOCAL_PREVIEW=false
# Generate with: openssl rand -hex 32
MGMT_SESSION_KEY=
# Cognito hosted UI HTTPS origin, for example https://portal.auth.us-east-1.amazoncognito.com
MGMT_COGNITO_DOMAIN=
# User-pool issuer, separate from hosted UI; for example:
# https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
MGMT_COGNITO_ISSUER=
# Cognito app client ID configured for authorization-code + PKCE.
MGMT_COGNITO_CLIENT_ID=
# Required for sign-in: OAuth callback URI registered with Cognito.
# For example: https://example.com/callback
MGMT_COGNITO_REDIRECT_URI=
# Required HTTPS Cognito logout return URI, for example https://example.com/login.
MGMT_COGNITO_LOGOUT_URI=
# Required comma-separated exact bare email addresses. Only verified emails match.
MGMT_ALLOWED_EMAILS=
# Permit an HTTP loopback callback only when it is also registered with Cognito.
# Logout remains HTTPS. This is separate from the mock portal preview.
MGMT_ALLOW_LOCAL_CALLBACK=false
# Optional AWS region for EC2 and CloudWatch; defaults to us-east-1.
MGMT_AWS_REGION=

# Optional: local AWS auth for configured Google connection and Soccer baseline
# DynamoDB stores.
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
