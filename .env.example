# Copy this file to .env for Docker Compose. `task run` and
# `task portal-preview` also load the same file when it exists.

# Required for soccer JWT import and encrypted session cookies.
# Generate a value with: openssl rand -hex 32
LPS_SESSION_KEY=

# Optional: override the upstream LPS API base URL for local testing.
LPS_API_BASE_URL=

# Docker Compose needs the container listener on all interfaces. `task run`
# will also bind on all interfaces while it loads this value from .env.
APP_BIND_ALL=true

# Optional logging overrides.
LOG_ADD_SOURCE=false
LOG_FORMAT=json
LOG_LEVEL=info

# Optional: enable Google Calendar connection, selection, add, and result sync.
CLIENT_ID_KEY=
CLIENT_SECRET_KEY=
GOOGLE_CONNECTION_TABLE_NAME=
# Optional: write imported soccer session baselines to DynamoDB.
SOCCER_SESSION_TABLE_NAME=

# Optional: enable the protected EC2 management portal.
# `task portal-preview` sets this automatically for its loopback-only mock.
# A non-loopback listener logs a warning and leaves preview routes disabled.
MGMT_LOCAL_PREVIEW=false
# Generate with: openssl rand -hex 32
MGMT_SESSION_KEY=
# Cognito hosted UI HTTPS origin, for example https://portal.auth.us-east-1.amazoncognito.com
MGMT_COGNITO_DOMAIN=
# Cognito app client ID configured for authorization-code + PKCE.
MGMT_COGNITO_CLIENT_ID=
# Required for sign-in: OAuth callback URI registered with Cognito.
# For example: https://example.com/auth/callback
MGMT_COGNITO_REDIRECT_URI=
# Optional Cognito logout return URI.
MGMT_COGNITO_LOGOUT_URI=
# Optional AWS region for EC2 and CloudWatch; defaults to us-east-1.
MGMT_AWS_REGION=

# Optional: local AWS auth for configured Google connection and Soccer baseline
# DynamoDB stores.
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
