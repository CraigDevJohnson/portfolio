{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProdStateList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::portfolio-tofu-state-180294223248",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "s3:prefix": [
            "portfolio-lambda-http-api/prod/terraform.tfstate",
            "portfolio-lambda-http-api/prod/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ProdState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::portfolio-tofu-state-180294223248/portfolio-lambda-http-api/prod/terraform.tfstate",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ProdLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::portfolio-tofu-state-180294223248/portfolio-lambda-http-api/prod/terraform.tfstate.tflock",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ProdRoleRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::180294223248:role/portfolio-lambda-prod-execution",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ProdRoleSetup",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::180294223248:role/portfolio-lambda-prod-execution",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::180294223248:policy/portfolio/boundaries/PortfolioLambdaExecutionBoundary"
        }
      }
    },
    {
      "Sid": "ProdPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::180294223248:role/portfolio-lambda-prod-execution",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ProdLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:CreateAlias",
        "lambda:GetAlias",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:PublishVersion",
        "lambda:PutFunctionConcurrency",
        "lambda:TagResource",
        "lambda:UpdateAlias",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:us-west-2:180294223248:function:portfolio-lambda-prod",
        "arn:aws:lambda:us-west-2:180294223248:function:portfolio-lambda-prod:*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ProdApiInvoke",
      "Effect": "Allow",
      "Action": "lambda:AddPermission",
      "Resource": "arn:aws:lambda:us-west-2:180294223248:function:portfolio-lambda-prod:live",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "lambda:Principal": "apigateway.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ProdApiCreate",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-west-2::/apis",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2",
          "apigateway:Request/ApiName": "portfolio-lambda-prod-http"
        }
      }
    },
    {
      "Sid": "ProdApiRead",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:us-west-2::/apis/*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2",
          "apigateway:Resource/ApiName": "portfolio-lambda-prod-http"
        }
      }
    },
    {
      "Sid": "ProdTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-2:180294223248:table/portfolio-lambda-prod-google-connections",
        "arn:aws:dynamodb:us-west-2:180294223248:table/portfolio-lambda-prod-soccer-sessions"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ProdLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-west-2:180294223248:log-group:/aws/lambda/portfolio-lambda-prod",
        "arn:aws:logs:us-west-2:180294223248:log-group:/aws/lambda/portfolio-lambda-prod:*",
        "arn:aws:logs:us-west-2:180294223248:log-group:/aws/apigateway/portfolio-lambda-prod/access",
        "arn:aws:logs:us-west-2:180294223248:log-group:/aws/apigateway/portfolio-lambda-prod/access:*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ProdAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:TagResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:us-west-2:180294223248:alarm:portfolio-lambda-prod-api-5xx",
        "arn:aws:cloudwatch:us-west-2:180294223248:alarm:portfolio-lambda-prod-api-latency",
        "arn:aws:cloudwatch:us-west-2:180294223248:alarm:portfolio-lambda-prod-lambda-duration",
        "arn:aws:cloudwatch:us-west-2:180294223248:alarm:portfolio-lambda-prod-lambda-errors",
        "arn:aws:cloudwatch:us-west-2:180294223248:alarm:portfolio-lambda-prod-lambda-throttles"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        }
      }
    },
    {
      "Sid": "ParameterMetadata",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-09-28T06:43:37Z"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}
