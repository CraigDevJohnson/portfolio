package partials

import (
	"fmt"

	"portfolio/types"
)

type ExperienceKitStagesProps struct {
	Experiences []types.Experience
}

templ ExperienceKitStages(props ExperienceKitStagesProps) {
	{{ overview := buildExperienceOverview(props.Experiences) }}
	{{ stages := buildCareerStages(props.Experiences) }}
	<div class="experience-kit-stages space-y-8 sm:space-y-10">
		<section class="experience-kit-shell overflow-hidden p-0">
			<div class="relative overflow-hidden px-6 py-8 sm:p-10 lg:p-12">
				<div class="absolute inset-0 bg-[url('/static/images/backgrounds/experience-hero.jpg')]" aria-hidden="true"></div>
				<div class="relative space-y-7 sm:space-y-8">
					<p class="experience-kit-eyebrow">Experience</p>
					<div class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr] xl:items-end">
						<div class="space-y-4">
							<h2 class="experience-kit-title max-w-4xl">The Three Eras</h2>
							<p class="experience-kit-copy max-w-3xl">A chaptered view of my career progression, from foundational support and systems growth to cloud engineering and technical leadership.</p>
						</div>
						<div class="experience-kit-panel-strong grid gap-4 sm:grid-cols-3">
							<div>
								<p class="experience-kit-eyebrow">Years active</p>
								<p class="experience-kit-counter" data-counter data-target-year={ fmt.Sprintf("%d", overview.CareerStartYear) }>0</p>
							</div>
							<div>
								<p class="experience-kit-eyebrow">Roles</p>
								<p class="experience-kit-counter" data-counter data-target={ fmt.Sprintf("%d", overview.TotalRoles) }>0</p>
							</div>
							<div>
								<p class="experience-kit-eyebrow">Technologies</p>
								<p class="experience-kit-counter" data-counter data-target={ fmt.Sprintf("%d", overview.TotalTechnologies) }>0</p>
							</div>
						</div>
					</div>
					<nav aria-label="Jump to career stage">
						<ul class="flex flex-wrap gap-3">
							for _, stage := range stages {
								<li>
									<a href={ templ.SafeURL("#" + stage.ID) } class="experience-kit-action">{ stage.Title }</a>
								</li>
							}
						</ul>
					</nav>
				</div>
			</div>
		</section>

		<section class="experience-summary grid gap-4 sm:gap-5 md:grid-cols-2 xl:grid-cols-4">
			for _, technology := range overview.SpotlightTechnologies {
				<article class="experience-kit-panel space-y-3">
					<p class="experience-kit-eyebrow">Highlighted tool</p>
					<h3 class="experience-kit-heading">{ technology }</h3>
					<p class="experience-kit-muted text-sm leading-6">Repeated often enough across the career to become part of the throughline for this page.</p>
				</article>
			}
		</section>

		for _, stage := range stages {
			<section id={ stage.ID } class="experience-kit-shell overflow-hidden">
				<div class="grid lg:grid-cols-[0.72fr_1.28fr]">
					<div class="experience-kit-border space-y-5 border-b p-6 sm:p-8 lg:border-b-0 lg:border-r">
						<p class="experience-kit-eyebrow">{ stage.Range }</p>
						<h3 class="experience-kit-stage-title">{ stage.Title }</h3>
						<p class="experience-kit-muted text-base leading-7">{ stage.Summary }</p>
						<div class="flex flex-wrap gap-2">
							for _, role := range stage.Experiences {
								<span class="experience-kit-chip">{ role.Position }</span>
							}
						</div>
					</div>
					<div class="grid gap-4 p-6 sm:p-8 md:grid-cols-2">
						for _, role := range stage.Experiences {
							<article class="experience-kit-panel-strong space-y-4">
								<div class="space-y-1">
									<p class="experience-kit-eyebrow">{ role.Duration }</p>
									<h4 class="experience-kit-role-title">{ role.Position }</h4>
									<p class="experience-kit-accent-strong text-sm font-semibold uppercase tracking-[0.12em]">{ role.Company }</p>
								</div>
								<p class="experience-kit-muted text-sm leading-7">{ role.Responsibilities }</p>
								<div class="flex flex-wrap gap-2">
									for _, technology := range role.Technologies {
										<span class="experience-kit-chip">{ technology }</span>
									}
								</div>
							</article>
						}
					</div>
				</div>
			</section>
		}

		@ExperienceKitFooterActions(ExperienceKitFooterActionsProps{
			Heading:     "Want to see the work that sits behind these stages?",
			Description: "Explore the projects and technical skills that support the same progression across systems, automation, and cloud leadership.",
		})
	</div>
}
