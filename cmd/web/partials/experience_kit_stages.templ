package partials

import (
	"fmt"

	"portfolio/types"
)

type ExperienceKitStagesProps struct {
	Experiences []types.Experience
}

templ ExperienceKitStages(props ExperienceKitStagesProps) {
	{{ overview := buildExperienceOverview(props.Experiences) }}
	{{ stages := buildCareerStages(props.Experiences) }}
	<div class="experience-kit-stages space-y-6 sm:space-y-8">
		<section class="experience-kit-shell overflow-hidden p-0">
			<div class="relative overflow-hidden px-6 py-8 sm:px-8 sm:py-10 xl:px-10 xl:py-12">
				<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,var(--experience-accent-soft),transparent_34%),linear-gradient(135deg,var(--experience-surface-strong),transparent_70%)]" aria-hidden="true"></div>
				<div class="relative space-y-6">
					<p class="experience-kit-eyebrow">Stages / chaptered career bands</p>
					<div class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr] xl:items-end">
						<div class="space-y-4">
							<h1 class="experience-kit-title max-w-4xl">The page as three eras: foundation, systems growth, and cloud leadership.</h1>
							<p class="experience-kit-copy max-w-3xl">This direction treats the career as a set of chapters rather than a linear track. Each section has its own tone, summary, and grouped roles so the progression reads like a sequence of eras.</p>
						</div>
						<div class="experience-kit-panel-strong grid gap-4 sm:grid-cols-3">
							<div>
								<p class="experience-kit-eyebrow">Years active</p>
								<p class="text-4xl font-bold [color:var(--experience-text)]" data-counter data-target-year={ fmt.Sprintf("%d", overview.CareerStartYear) }>0</p>
							</div>
							<div>
								<p class="experience-kit-eyebrow">Roles</p>
								<p class="text-4xl font-bold [color:var(--experience-text)]" data-counter data-target={ fmt.Sprintf("%d", overview.TotalRoles) }>0</p>
							</div>
							<div>
								<p class="experience-kit-eyebrow">Technologies</p>
								<p class="text-4xl font-bold [color:var(--experience-text)]" data-counter data-target={ fmt.Sprintf("%d", overview.TotalTechnologies) }>0</p>
							</div>
						</div>
					</div>
					<nav aria-label="Jump to career stage">
						<ul class="flex flex-wrap gap-3">
							for _, stage := range stages {
								<li>
									<a href={ templ.SafeURL("#" + stage.ID) } class="experience-kit-action">{ stage.Title }</a>
								</li>
							}
						</ul>
					</nav>
				</div>
			</div>
		</section>

		<section class="experience-summary grid gap-4 md:grid-cols-2 xl:grid-cols-4">
			for _, technology := range overview.SpotlightTechnologies {
				<article class="experience-kit-panel space-y-3">
					<p class="experience-kit-eyebrow">Highlighted tool</p>
					<h2 class="text-3xl font-bold tracking-tight [color:var(--experience-text)]">{ technology }</h2>
					<p class="text-sm leading-6 [color:var(--experience-muted)]">Repeated often enough across the career to become part of the throughline for this page.</p>
				</article>
			}
		</section>

		for _, stage := range stages {
			<section id={ stage.ID } class="experience-kit-shell overflow-hidden">
				<div class="grid lg:grid-cols-[0.72fr_1.28fr]">
					<div class="space-y-5 border-b p-6 [border-color:var(--experience-border)] lg:border-b-0 lg:border-r lg:p-8">
						<p class="experience-kit-eyebrow">{ stage.Range }</p>
						<h2 class="text-4xl font-bold tracking-tight [color:var(--experience-text)]">{ stage.Title }</h2>
						<p class="text-base leading-7 [color:var(--experience-muted)]">{ stage.Summary }</p>
						<div class="flex flex-wrap gap-2">
							for _, role := range stage.Experiences {
								<span class="experience-kit-chip">{ role.Position }</span>
							}
						</div>
					</div>
					<div class="grid gap-4 p-6 md:grid-cols-2 lg:p-8">
						for _, role := range stage.Experiences {
							<article class="experience-kit-panel-strong space-y-4">
								<div class="space-y-1">
									<p class="experience-kit-eyebrow">{ role.Duration }</p>
									<h3 class="text-2xl font-semibold tracking-tight [color:var(--experience-text)]">{ role.Position }</h3>
									<p class="text-sm font-semibold uppercase tracking-[0.12em] [color:var(--experience-accent-strong)]">{ role.Company }</p>
								</div>
								<p class="text-sm leading-7 [color:var(--experience-muted)]">{ role.Responsibilities }</p>
								<div class="flex flex-wrap gap-2">
									for _, technology := range role.Technologies {
										<span class="experience-kit-chip">{ technology }</span>
									}
								</div>
							</article>
						}
					</div>
				</div>
			</section>
		}

		@ExperienceKitFooterActions(ExperienceKitFooterActionsProps{
			Heading:     "Want to see the work that sits behind these stages?",
			Description: "Explore the projects and technical skills that support the same progression across systems, automation, and cloud leadership.",
		})
	</div>
}