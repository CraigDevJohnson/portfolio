package partials

import (
	"fmt"

	"portfolio/types"
)

type ExperienceKitStagesProps struct {
	Experiences []types.Experience
}

templ ExperienceKitStages(props ExperienceKitStagesProps) {
	{{ overview := buildExperienceOverview(props.Experiences) }}
	{{ stages := buildCareerStages(props.Experiences) }}
	<div class="page-kit-page experience-kit-page experience-kit-stages space-y-8 sm:space-y-10">
		@PageHero(PageHeroProps{
			ImageURL:     "/static/images/backgrounds/experience-hero.jpg",
			ContentClass: "flex min-h-full flex-col justify-center",
		}) {
			<div class="grid gap-6 xl:grid-cols-[minmax(0,1.08fr)_minmax(20rem,0.92fr)] xl:items-end">
					@PageHeroIntro(PageHeroIntroProps{Eyebrow: "Experience", Title: "Experience in Three Eras"}) {
						<p class="page-hero-description">A chaptered view of my career progression, from foundational support and systems growth to cloud engineering and technical leadership.</p>
					}
						<div class="experience-kit-panel-strong experience-hero-stats grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
							<div>
								<p class="experience-hero-stat-label">Years active</p>
								<p class="experience-kit-counter" data-counter data-target={ fmt.Sprintf("%d", overview.CareerSpanYears) }>{ fmt.Sprintf("%d", overview.CareerSpanYears) }</p>
							</div>
							<div>
								<p class="experience-hero-stat-label">Roles</p>
								<p class="experience-kit-counter" data-counter data-target={ fmt.Sprintf("%d", overview.TotalRoles) }>{ fmt.Sprintf("%d", overview.TotalRoles) }</p>
							</div>
							<div>
								<p class="experience-hero-stat-label">Technologies</p>
								<p class="experience-kit-counter" data-counter data-target={ fmt.Sprintf("%d", overview.TotalTechnologies) }>{ fmt.Sprintf("%d", overview.TotalTechnologies) }</p>
							</div>
						</div>
					</div>
		}

		<section class="page-stats-section">
			<div class="page-kit-panel-strong space-y-4 sm:space-y-5">
				@SectionIntro(SectionIntroProps{
					Label: "Career stages",
					Title: "Jump to an era",
					Description: "Navigate to the chapter of experience most relevant to your current needs.",
					ExtraClass: "max-w-4xl",
				})
				<nav aria-label="Jump to career stage">
					<div class="experience-hero-links">
						for _, stage := range stages {
							<a href={ templ.SafeURL("#" + stage.ID) } class="experience-kit-action">{ stage.Title }</a>
						}
					</div>
				</nav>
			</div>
		</section>

		<section class="experience-summary grid gap-4 sm:gap-5 md:grid-cols-2 xl:grid-cols-4">
			<h2 class="sr-only">Recurring technologies used across career stages</h2>
			for _, technology := range overview.SpotlightTechnologies {
				<article class="experience-kit-panel space-y-2">
					<p class="experience-kit-eyebrow">Recurring technology</p>
					<h3 class="experience-kit-heading">{ technology }</h3>
				</article>
			}
		</section>

		for _, stage := range stages {
			<section id={ stage.ID } class="experience-kit-shell scroll-mt-[calc(var(--header-height)+1.25rem)] overflow-hidden">
				<div class="grid lg:grid-cols-[0.72fr_1.28fr]">
					<div class="experience-kit-border space-y-5 border-b p-6 sm:p-8 lg:border-b-0 lg:border-r">
						<p class="experience-kit-eyebrow">{ stage.Range }</p>
						<h2 class="experience-kit-stage-title">{ stage.Title }</h2>
						<p class="experience-kit-muted text-base leading-7">{ stage.Summary }</p>
						<div class="flex flex-wrap gap-2">
							for _, role := range stage.Experiences {
								<span class="experience-kit-chip">{ role.Position }</span>
							}
						</div>
					</div>
					<div class="grid gap-4 p-6 sm:p-8 md:grid-cols-2">
						for _, role := range stage.Experiences {
							<article class="experience-kit-panel-strong space-y-4">
								<div class="space-y-1">
									<p class="experience-kit-eyebrow">{ role.Duration }</p>
									<h3 class="experience-kit-role-title">{ role.Position }</h3>
									<p class="experience-kit-company text-sm font-semibold uppercase tracking-[0.12em]">{ role.Company }</p>
								</div>
								<p class="experience-kit-muted text-sm leading-7">{ role.Responsibilities }</p>
								<div class="flex flex-wrap gap-2">
									for _, technology := range role.Technologies {
										<span class="experience-kit-chip">{ technology }</span>
									}
								</div>
							</article>
						}
					</div>
				</div>
			</section>
		}

		@ExperienceKitFooterActions(ExperienceKitFooterActionsProps{
			Heading:     "Want to see the work that sits behind these stages?",
			Description: "Explore the projects and technical skills that support the same progression across systems, automation, and cloud leadership.",
		})
	</div>
}
