package partials

import "fmt"
import "portfolio/types"

type SoccerPlayerSelectProps struct {
	Players []types.LPSPlayer
}

templ SoccerPlayerSelect(props SoccerPlayerSelectProps) {
	<form
		id="soccer-player-select-form"
		class="soccer-player-select-form soccer-flow-form"
		hx-post="/soccer/discover-teams"
		hx-target="#games-container"
		hx-swap="innerHTML"
		hx-indicator="#loading-indicator, .soccer-player-submit-indicator"
		hx-disabled-elt="find button[type='submit']"
	>
		<p class="soccer-flow-step">Next step</p>
		<fieldset class="soccer-player-fieldset">
			<legend>Choose players to continue</legend>
			<p class="soccer-player-hint">Select one or more discovered players. Next you&apos;ll confirm which teams to include before schedules load.</p>
			<div class="soccer-player-list">
				for _, player := range props.Players {
					<label class="soccer-player-option">
						<input type="checkbox" name="player_ids" value={ fmt.Sprintf("%d", player.UPlayerID) } checked/>
						<span class="soccer-player-option-copy">
							<span class="soccer-player-name">{ player.FirstName + " " + player.LastName }</span>
							if player.IsMainPlayer {
								<span class="soccer-player-badge">Primary</span>
							}
						</span>
					</label>
				}
			</div>
			<button type="submit" class="btn btn-primary soccer-player-submit btn-loading" data-loading-button>
				<span class="btn-text">Continue to Team Selection</span>
				<span class="btn-loading-indicator soccer-player-submit-indicator htmx-indicator" aria-hidden="true"></span>
			</button>
		</fieldset>
	</form>
}
