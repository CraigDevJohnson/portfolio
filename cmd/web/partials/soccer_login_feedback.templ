package partials

type SoccerLoginFeedbackProps struct {
	Kind    string
	Message string
}

func feedbackRole(kind string) string {
	if kind == "error" {
		return "alert"
	}
	return "status"
}

func feedbackClasses(kind string) string {
	base := "rounded-xl border px-4 py-3 text-sm"
	if kind == "error" {
		return base + " border-secondary-500/26 bg-secondary-500/14 text-secondary-100"
	}
	if kind == "success" {
		return base + " border-primary-500/28 bg-primary-500/14 text-primary-100"
	}
	return base + " border-carbon-black-400/24 bg-carbon-black-700/55 text-carbon-black-100"
}

templ SoccerLoginFeedback(props SoccerLoginFeedbackProps) {
	<div class={ feedbackClasses(props.Kind) } role={ feedbackRole(props.Kind) }>
		{ props.Message }
	</div>
}
