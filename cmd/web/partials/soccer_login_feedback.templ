package partials

type SoccerLoginFeedbackProps struct {
	Kind    string
	Message string
}

func feedbackRole(kind string) string {
	if kind == "error" {
		return "alert"
	}
	return "status"
}

templ SoccerLoginFeedback(props SoccerLoginFeedbackProps) {
	<div class={ "soccer-login-message soccer-login-message-" + props.Kind } role={ feedbackRole(props.Kind) }>
		{ props.Message }
	</div>
}
