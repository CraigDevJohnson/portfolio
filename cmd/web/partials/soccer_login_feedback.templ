package partials

type SoccerLoginFeedbackProps struct {
	Kind    string
	Title   string
	Message string
}

func soccerFeedbackKind(kind string) FeedbackKind {
	switch kind {
	case "success":
		return FeedbackSuccess
	case "warning":
		return FeedbackWarning
	case "error", "invalid", "rejected", "upstream", "google-error":
		return FeedbackError
	default:
		return FeedbackInfo
	}
}

func soccerFeedbackTitle(props SoccerLoginFeedbackProps) string {
	if props.Title != "" {
		return props.Title
	}
	switch soccerFeedbackKind(props.Kind) {
	case FeedbackSuccess:
		return "Calendar update complete"
	case FeedbackWarning:
		return "Action needed"
	case FeedbackError:
		return "This step could not be completed"
	default:
		return "Matchday update"
	}
}

templ SoccerLoginFeedback(props SoccerLoginFeedbackProps) {
	@Feedback(FeedbackProps{
		Kind:       soccerFeedbackKind(props.Kind),
		Title:      soccerFeedbackTitle(props),
		Message:    props.Message,
		ExtraClass: "soccer-feedback",
	})
}

// SoccerPrivateAccessProps explains why private Soccer actions are withheld
// and, where site sign-in can start, offers it.
type SoccerPrivateAccessProps struct {
	Kind        FeedbackKind
	Message     string
	OfferSignIn bool
}

// SoccerPrivateAccess renders the page's private-access notice and the
// refusal an open page's private action receives in its own target.
templ SoccerPrivateAccess(props SoccerPrivateAccessProps) {
	<div class="soccer-workspace-feedback">
		@Feedback(FeedbackProps{Kind: props.Kind, Title: "Private Soccer access", Message: props.Message})
		if props.OfferSignIn {
			<a class="soccer-inline-link" href="/sign-in?return_to=%2Fsoccer">Sign in for Soccer access</a>
		}
	</div>
}
