package partials

type SoccerLoginModalProps struct {
	Preview                  bool
	Open                     bool
	HistoryCollectionEnabled bool
	Feedback                 *SoccerLoginFeedbackProps
}

templ SoccerLoginModal(props SoccerLoginModalProps) {
	<div
		id="soccer-login-modal"
		class="soccer-login-modal"
		if !props.Open {
			hidden
			aria-hidden="true"
		} else {
			aria-hidden="false"
		}
	>
		<div class="soccer-login-backdrop" role="presentation" aria-hidden="true" data-close-login-modal></div>
		<div
			class="soccer-login-dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="soccer-login-title"
			aria-describedby="soccer-login-description soccer-history-notice"
			tabindex="-1"
		>
			<div class="soccer-login-header sticky top-0 z-10 bg-[var(--bg-secondary)] pb-3">
				<h2 id="soccer-login-title">Import Let&apos;s Play Soccer access</h2>
				<button type="button" class="soccer-modal-close" aria-label="Close import dialog" data-close-login-modal>
					<span aria-hidden="true">
						@UIInlineIcon(UIIconClose)
					</span>
				</button>
			</div>
			<p id="soccer-login-description" class="soccer-login-description">
				Paste the JWT from your signed-in Let&apos;s Play Soccer browser session. After import, you&apos;ll choose players and then confirm which teams to include.
			</p>
			if props.HistoryCollectionEnabled {
				<div id="soccer-history-notice" class="soccer-history-notice" data-soccer-history-notice>
					<p class="soccer-history-notice-title">Kept indefinitely</p>
					<p>Import access looks up the teams and seasons of every player linked to this Let&apos;s Play Soccer account, including players you don&apos;t choose for the planner.</p>
					<p>This site keeps those players&apos; names and team-season links with your site account indefinitely and keeps refreshing their teams&apos; games. Your JWT stays temporary: it is never kept with this history, and Clear import or site sign-out does not delete the history.</p>
				</div>
			} else {
				<p id="soccer-history-notice" class="soccer-login-note">History collection is currently off. Import access keeps your LPS session in this browser for up to 12 hours and does not save player or team history indefinitely.</p>
			}
			<ol class="soccer-login-instructions">
				<li>Sign in on letsplaysoccer.com in another tab.</li>
				<li>Open browser DevTools, inspect an authenticated request, and copy the JWT.</li>
				<li>Click Import access to load your players, then continue to team selection.</li>
			</ol>
			<form
				id="soccer-login-form"
				class="soccer-login-form"
				if !props.Preview {
					hx-post="/soccer/import"
					hx-target="#soccer-login-feedback"
					hx-swap="innerHTML"
					hx-indicator=".soccer-login-submit-indicator"
					hx-disabled-elt="find button[type='submit']"
				}
			>
				if props.HistoryCollectionEnabled {
					<input type="hidden" name={ SoccerHistoryNoticeField } value={ SoccerHistoryNoticeIndefinite }/>
				}
				<div id="soccer-login-feedback" class="soccer-login-feedback">
					if props.Feedback != nil {
						@SoccerLoginFeedback(*props.Feedback)
					}
				</div>
				<div class="soccer-login-jwt-field">
					<label for="soccer-import-jwt" class="form-label">JWT</label>
					<textarea
						id="soccer-import-jwt"
						name="jwt"
						class="text-input min-h-28 resize-y"
						rows="5"
						spellcheck="false"
						required
						aria-required="true"
						aria-describedby="soccer-import-jwt-hint"
						placeholder="Bearer eyJhbGciOi..."
					></textarea>
					<p id="soccer-import-jwt-hint" class="soccer-login-note">You can paste the full Authorization header value or only the JWT.</p>
				</div>
				<p class="soccer-login-note">
					This server keeps the imported JWT in an encrypted HttpOnly cookie in this browser until it expires, for up to 12 hours. Only this signed-in site account with Soccer access can use it. Site sign-out or Clear import removes it.
				</p>
				@SoccerSecurityNotice(SoccerSecurityNoticeProps{Compact: false})
				<div class="soccer-login-actions sticky bottom-0 z-10 bg-[var(--bg-secondary)] pt-3">
					<button type="button" class="btn soccer-secondary-btn" data-close-login-modal>
						Cancel
					</button>
					<button
						type="submit"
						class="btn btn-primary btn-loading"
						data-loading-button
						if props.Preview {
							disabled
							aria-disabled="true"
						}
					>
						<span class="btn-text">Import access</span>
						<span class="btn-loading-indicator soccer-login-submit-indicator htmx-indicator" aria-hidden="true"></span>
					</button>
				</div>
			</form>
		</div>
	</div>
}
