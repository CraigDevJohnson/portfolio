package partials

templ SoccerLoginModal() {
	<div id="soccer-login-modal" class="soccer-login-modal" hidden aria-hidden="true">
		<div class="soccer-login-backdrop" role="presentation" aria-hidden="true" data-close-login-modal></div>
		<div
			class="soccer-login-dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="soccer-login-title"
			aria-describedby="soccer-login-description"
			tabindex="-1"
		>
			<div class="soccer-login-header">
				<h2 id="soccer-login-title">Import Let&apos;s Play Soccer access</h2>
				<button type="button" class="soccer-modal-close" aria-label="Close import dialog" data-close-login-modal>
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<p id="soccer-login-description" class="soccer-login-description">
				Paste the JWT from your signed-in Let&apos;s Play Soccer browser session. After import, you&apos;ll choose players and then confirm which teams to include.
			</p>
			<ol class="soccer-login-instructions">
				<li>Sign in on letsplaysoccer.com in another tab.</li>
				<li>Open browser DevTools, inspect an authenticated request, and copy the JWT.</li>
				<li>Click Import access to load your players, then continue to team selection.</li>
			</ol>
			<form
				id="soccer-login-form"
				class="soccer-login-form"
				hx-post="/soccer/import"
				hx-target="#soccer-login-feedback"
				hx-swap="innerHTML"
				hx-indicator=".soccer-login-submit-indicator"
				hx-disabled-elt="find button[type='submit']"
			>
				<div class="flex flex-col">
					<label for="soccer-import-jwt" class="form-label">JWT</label>
					<textarea
						id="soccer-import-jwt"
						name="jwt"
						class="text-input min-h-28 resize-y"
						rows="5"
						spellcheck="false"
						required
						aria-required="true"
						aria-describedby="soccer-import-jwt-hint"
						placeholder="Bearer eyJhbGciOi..."
					></textarea>
					<p id="soccer-import-jwt-hint" class="soccer-login-note">You can paste the full Authorization header value or only the JWT.</p>
				</div>
				<p class="soccer-login-note">
					This server stores the imported JWT only in an encrypted HttpOnly cookie for the current browser session and clears it when you choose Clear import.
				</p>
        <div class="rounded-xl border border-accent-500/25 bg-accent-500/15 p-4" role="alert">
          <p class="m-0 text-sm font-medium leading-relaxed text-accent-200">
            Player Discovery uses the JWT (<a class="font-medium text-accent-100 underline-offset-4 hover:underline" href="https://en.wikipedia.org/wiki/JSON_Web_Token" target="_blank" rel="noopener noreferrer">JSON web token</a>)
            from your signed-in <u><em>Let&apos;s Play Soccer</em></u> account, which gives full access to your account (only used to query players/teams/schedules/results).
          </p>
        </div>
				<div id="soccer-login-feedback" class="soccer-login-feedback" aria-live="polite"></div>
				<div class="soccer-login-actions">
					<button type="button" class="btn soccer-secondary-btn" data-close-login-modal>
						Cancel
					</button>
					<button type="submit" class="btn btn-primary btn-loading" data-loading-button>
						<span class="btn-text">Import access</span>
						<span class="btn-loading-indicator soccer-login-submit-indicator htmx-indicator" aria-hidden="true"></span>
					</button>
				</div>
			</form>
		</div>
	</div>
}
