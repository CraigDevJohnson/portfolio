package partials

import "portfolio/types"

type SoccerLoginStateProps struct {
	Authenticated           bool
	Players                 []types.LPSPlayer
	LoginAvailable          bool
	GoogleAvailable         bool
	GoogleConnected         bool
	GoogleCalendarSummary   string
	SelectedGoogleCalendarID string
	GoogleCalendars         []types.GoogleCalendarOption
	SwapOOB                 bool
}

func showSoccerDiscoverySection(props SoccerLoginStateProps) bool {
	return props.Authenticated || props.LoginAvailable
}

func showSoccerGoogleSection(props SoccerLoginStateProps) bool {
	return props.GoogleConnected || props.GoogleAvailable || len(props.GoogleCalendars) > 0 || props.SelectedGoogleCalendarID != ""
}

templ SoccerLoginState(props SoccerLoginStateProps) {
	<div
		id="soccer-auth-panel"
		class="soccer-auth-panel"
		if props.SwapOOB {
			hx-swap-oob="outerHTML"
		}
	>
		if showSoccerDiscoverySection(props) {
			<div class="soccer-option-group soccer-option-group--fetch-secondary">
			<div class="soccer-option-group-header">
				<p class="soccer-option-group-label">Discovery fetch path</p>
				<p class="soccer-option-group-copy">Use import access only when you want player discovery before you confirm teams and load the schedule.</p>
			</div>
			<div class="soccer-auth-shell soccer-input-section soccer-input-import">
				<div class="soccer-auth-copy">
					<div class="soccer-section-header">
						<span class="soccer-section-step" aria-hidden="true">1B</span>
						<div>
							<h3>Player Discovery</h3>
						</div>
					</div>
					<p class="soccer-section-intro">Import the JWT from your signed-in
            <a href="https://www.letsplaysoccer.com/4?lang=en" target="_blank" rel="noopener noreferrer">
							Let&apos;s Play Soccer
						</a> browser session when you want to discover linked players first, then choose which teams to include.
          </p>
          <div class="jwt-import-warning">
            <p>
              Player Discovery uses the JWT (<a href="https://en.wikipedia.org/wiki/JSON_Web_Token" target="_blank" rel="noopener noreferrer">JSON web token</a>)
              from your signed-in <u><em>Let&apos;s Play Soccer</em></u> account, which gives full access to your account (only used to query players/teams/schedules/results).
            </p>
          </div>
				</div>
				<div class="soccer-auth-summary">
					if props.Authenticated {
						<div>
							<p class="soccer-auth-status">Imported</p>
							<p class="soccer-auth-user">Access is saved for this browser session. Choose players below, then confirm which teams to include before fetching schedules. To refresh the player list, clear import and import again.</p>
						</div>
						<button
							type="button"
							class="btn soccer-secondary-btn btn-loading"
							hx-post="/soccer/logout"
							hx-target="#soccer-auth-panel"
							hx-swap="outerHTML"
							hx-disabled-elt="this"
							data-loading-button
						>
							<span class="btn-text">Clear import</span>
							<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
						</button>
					} else {
						<div>
							<p class="soccer-auth-status">No import active</p>
							<p class="soccer-auth-user">Import a JWT when you want the app to discover linked players. You&apos;ll choose players first, then confirm teams before schedules load.</p>
						</div>
						<button type="button" class="btn btn-primary" data-open-login-modal>
							Import access
						</button>
					}
				</div>
				if props.Authenticated {
					@SoccerPlayerSelect(SoccerPlayerSelectProps{Players: props.Players})
				}
			</div>
			</div>
		}
		if showSoccerGoogleSection(props) {
			<div class="soccer-option-group soccer-option-group--follow-up">
			<div class="soccer-option-group-header">
				<p class="soccer-option-group-label">Download or sync after fetch</p>
				<p class="soccer-option-group-copy">Once the schedule loads, save it as an .ics file or connect Google Calendar for direct adds and result sync.</p>
			</div>
			<div class="soccer-google-shell soccer-input-section soccer-input-google">
				<div class="soccer-google-copy">
					<div class="soccer-section-header">
						<span class="soccer-section-step" aria-hidden="true">2</span>
						<div>
							<h3>Google Calendar Connection</h3>
						</div>
					</div>
					<p class="soccer-section-intro">Connect once to save a destination calendar and add selected matches without downloading an .ics file.</p>
				</div>
					<div class="soccer-auth-summary">
						if props.GoogleConnected {
							<div>
								<p class="soccer-auth-status">Google Calendar connected</p>
								if props.GoogleCalendarSummary != "" {
									<p class="soccer-auth-user">Selected calendar: { props.GoogleCalendarSummary }</p>
								} else {
									<p class="soccer-auth-user">Your Google Calendar connection is ready. Choose a destination calendar below.</p>
								}
							</div>
							<div class="input-row">
								<a href="/soccer/google/connect" class="btn soccer-secondary-btn btn-loading" data-loading-link>
									<span class="btn-text">Reconnect Google</span>
									<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
								</a>
								<button
									type="button"
									class="btn soccer-secondary-btn btn-loading"
									hx-post="/soccer/google/disconnect"
									hx-target="#soccer-auth-panel"
									hx-swap="outerHTML"
									hx-disabled-elt="this"
									data-loading-button
								>
									<span class="btn-text">Disconnect</span>
									<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
								</button>
							</div>
						} else {
							<div>
								<p class="soccer-auth-status">Google Calendar not connected</p>
								<p class="soccer-auth-user">Connect Google Calendar once to add selected games directly without downloading an .ics file.</p>
							</div>
							<a href="/soccer/google/connect" class="btn btn-primary btn-loading" data-loading-link>
								<span class="btn-text">Connect Google Calendar</span>
								<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
							</a>
						}
					</div>
				if props.GoogleConnected && len(props.GoogleCalendars) > 0 {
						<form
							class="fetch-form"
							hx-post="/soccer/google/calendar"
							hx-target="#soccer-auth-panel"
							hx-swap="outerHTML"
							hx-indicator=".soccer-google-save-indicator"
							hx-disabled-elt="find select, find button[type='submit']"
						>
							<div class="form-group">
								<label for="soccer-google-calendar" class="form-label">Google Calendar</label>
								<div class="input-row">
									<select id="soccer-google-calendar" name="calendar_id" class="text-input">
										for _, calendar := range props.GoogleCalendars {
											<option value={ calendar.ID } if calendar.ID == props.SelectedGoogleCalendarID { selected }>
												if calendar.Primary {
													{ calendar.Summary + " (Primary)" }
												} else {
													{ calendar.Summary }
												}
											</option>
										}
									</select>
									<button type="submit" class="btn soccer-secondary-btn btn-loading" data-loading-button>
										<span class="btn-text">Save calendar</span>
										<span class="btn-loading-indicator soccer-google-save-indicator htmx-indicator" aria-hidden="true"></span>
									</button>
								</div>
							</div>
						</form>
					}
			</div>
			</div>
		}
		if !showSoccerDiscoverySection(props) && !showSoccerGoogleSection(props) {
			<div class="soccer-auth-unavailable" role="status">
				<p>Manual team lookup and ICS download are ready now. Player discovery and direct Google Calendar adds will appear automatically when those integrations are configured on the server.</p>
			</div>
		}
	</div>
}
