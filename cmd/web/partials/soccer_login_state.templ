package partials

import "portfolio/types"

type SoccerLoginStateProps struct {
	Authenticated           bool
	Players                 []types.LPSPlayer
	LoginAvailable          bool
	GoogleAvailable         bool
	GoogleConnected         bool
	GoogleCalendarSummary   string
	SelectedGoogleCalendarID string
	GoogleCalendars         []types.GoogleCalendarOption
	SwapOOB                 bool
}

func showSoccerDiscoverySection(props SoccerLoginStateProps) bool {
	return props.Authenticated || props.LoginAvailable
}

func showSoccerGoogleSection(props SoccerLoginStateProps) bool {
	return props.GoogleConnected || props.GoogleAvailable || len(props.GoogleCalendars) > 0 || props.SelectedGoogleCalendarID != ""
}

templ SoccerLoginState(props SoccerLoginStateProps) {
	<div
		id="soccer-auth-panel"
		class="flex min-w-0 flex-col gap-4"
		if props.SwapOOB {
			hx-swap-oob="outerHTML"
		}
	>
		if showSoccerDiscoverySection(props) {
			<div class="flex flex-col gap-4">
			<div class="flex flex-col gap-1">
				<p class="m-0 text-xs font-semibold uppercase tracking-[0.08em] text-primary-100">Recommended fetch path</p>
				<p class="m-0 text-sm leading-relaxed text-copy-muted">Import access first when you want the app to discover your linked players before you confirm teams and load the schedule.</p>
			</div>
			<div class="page-kit-step-card page-kit-step-card-primary max-sm:p-4">
				<div class="soccer-auth-copy">
					<div class="flex items-center gap-4 max-md:items-start">
						<span class="page-kit-step-badge page-kit-step-badge-primary" aria-hidden="true">1</span>
						<div>
							<h3 class="m-0 text-base font-semibold uppercase tracking-[0.08em] text-primary-100">Import access &amp; discover players</h3>
						</div>
					</div>
						<p class="px-4 py-2 text-sm leading-relaxed text-copy-secondary">Import the JWT from your signed-in
            <a class="font-medium text-primary-200 underline-offset-4 hover:text-primary-100 hover:underline" href="https://www.letsplaysoccer.com/4?lang=en" target="_blank" rel="noopener noreferrer">
							Let&apos;s Play Soccer
						</a> browser session when you want to discover linked players first, then choose which teams to include.
          </p>
					<div class="page-kit-panel px-4 py-4">
            <p class="m-0 text-sm font-medium leading-relaxed text-accent-200">
							Player Discovery uses the JWT (<a class="font-medium text-accent-100 underline decoration-current underline-offset-4" href="https://en.wikipedia.org/wiki/JSON_Web_Token" target="_blank" rel="noopener noreferrer">JSON web token</a>)
              from your signed-in <u><em>Let&apos;s Play Soccer</em></u> account, which gives full access to your account (only used to query players/teams/schedules/results).
            </p>
          </div>
				</div>
				<div class="flex flex-wrap items-center justify-between gap-4 max-md:flex-col max-md:items-stretch">
					if props.Authenticated {
						<div>
							<p class="text-xs font-semibold uppercase tracking-[0.08em] text-primary-100">Imported</p>
							<p class="text-sm text-copy-secondary">Access is saved for this browser session. Choose players below, then confirm which teams to include before fetching schedules. To refresh the player list, clear import and import again.</p>
						</div>
						<button
							type="button"
							class="btn soccer-secondary-btn btn-loading"
							hx-post="/soccer/logout"
							hx-target="#soccer-auth-panel"
							hx-swap="outerHTML"
							hx-disabled-elt="this"
							data-loading-button
						>
							<span class="btn-text">Clear import</span>
							<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
						</button>
					} else {
						<div>
							<p class="text-xs font-semibold uppercase tracking-[0.08em] text-primary-100">No import active</p>
							<p class="text-sm text-copy-secondary">Import a JWT when you want the app to discover linked players. You&apos;ll choose players first, then confirm teams before schedules load.</p>
						</div>
						<button type="button" class="btn btn-primary" data-open-login-modal>
							Import access
						</button>
					}
				</div>
				if props.Authenticated {
					@SoccerPlayerSelect(SoccerPlayerSelectProps{Players: props.Players})
				}
			</div>
			</div>
		}
		if showSoccerGoogleSection(props) {
			<div class="flex flex-col gap-4 border-t page-kit-border pt-6">
			<div class="flex flex-col gap-1">
				<p class="m-0 text-xs font-semibold uppercase tracking-[0.08em] text-primary-100">Download or sync after fetch</p>
				<p class="m-0 text-sm leading-relaxed text-copy-muted">Once the schedule loads, save it as an .ics file or connect Google Calendar for direct adds and result sync.</p>
			</div>
			<div class="page-kit-step-card page-kit-step-card-secondary max-sm:p-4">
				<div class="soccer-google-copy">
					<div class="flex items-center gap-4 max-md:items-start">
						<span class="page-kit-step-badge page-kit-step-badge-secondary" aria-hidden="true">2</span>
						<div>
							<h3 class="m-0 text-base font-semibold uppercase tracking-[0.08em] text-primary-100">Google Calendar Connection</h3>
						</div>
					</div>
					<p class="px-4 py-2 text-sm leading-relaxed text-copy-secondary">Connect once to save a destination calendar and add selected matches without downloading an .ics file.</p>
				</div>
					<div class="flex flex-wrap items-center justify-between gap-4 max-md:flex-col max-md:items-stretch">
						if props.GoogleConnected {
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.08em] text-primary-100">Google Calendar connected</p>
								if props.GoogleCalendarSummary != "" {
									<p class="text-sm text-copy-secondary">Selected calendar: { props.GoogleCalendarSummary }</p>
								} else {
									<p class="text-sm text-copy-secondary">Your Google Calendar connection is ready. Choose a destination calendar below.</p>
								}
							</div>
							<div class="flex gap-4 max-md:flex-col">
								<a href="/soccer/google/connect" class="btn soccer-secondary-btn btn-loading" data-loading-link>
									<span class="btn-text">Reconnect Google</span>
									<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
								</a>
								<button
									type="button"
									class="btn soccer-secondary-btn btn-loading"
									hx-post="/soccer/google/disconnect"
									hx-target="#soccer-auth-panel"
									hx-swap="outerHTML"
									hx-disabled-elt="this"
									data-loading-button
								>
									<span class="btn-text">Disconnect</span>
									<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
								</button>
							</div>
						} else {
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.08em] text-primary-100">Google Calendar not connected</p>
								<p class="text-sm text-copy-secondary">Connect Google Calendar once to add selected games directly without downloading an .ics file.</p>
							</div>
							<a href="/soccer/google/connect" class="btn btn-primary btn-loading" data-loading-link>
								<span class="btn-text">Connect Google Calendar</span>
								<span class="btn-loading-indicator htmx-indicator" aria-hidden="true"></span>
							</a>
						}
					</div>
				if props.GoogleConnected && len(props.GoogleCalendars) > 0 {
						<form
							class="fetch-form"
							hx-post="/soccer/google/calendar"
							hx-target="#soccer-auth-panel"
							hx-swap="outerHTML"
							hx-indicator=".soccer-google-save-indicator"
							hx-disabled-elt="find select, find button[type='submit']"
						>
							<div class="flex flex-col">
								<label for="soccer-google-calendar" class="form-label">Google Calendar</label>
								<div class="flex gap-4 max-md:flex-col">
									<select id="soccer-google-calendar" name="calendar_id" class="text-input flex-1">
										for _, calendar := range props.GoogleCalendars {
											<option value={ calendar.ID } if calendar.ID == props.SelectedGoogleCalendarID { selected }>
												if calendar.Primary {
													{ calendar.Summary + " (Primary)" }
												} else {
													{ calendar.Summary }
												}
											</option>
										}
									</select>
									<button type="submit" class="btn soccer-secondary-btn btn-loading max-md:w-full" data-loading-button>
										<span class="btn-text">Save calendar</span>
										<span class="btn-loading-indicator soccer-google-save-indicator htmx-indicator" aria-hidden="true"></span>
									</button>
								</div>
							</div>
						</form>
					}
			</div>
			</div>
		}
		if !showSoccerDiscoverySection(props) && !showSoccerGoogleSection(props) {
			<div class="page-kit-panel p-4" role="status">
				<p>Manual team lookup and ICS download are ready now. Player discovery and direct Google Calendar adds will appear automatically when those integrations are configured on the server.</p>
			</div>
		}
	</div>
}
