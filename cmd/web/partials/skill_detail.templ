package partials

import "portfolio/types"

type SkillDetailProps struct {
	Skill types.Skill
}

templ SkillDetail(props SkillDetailProps) {
	<div class="page-kit-detail-card skill-detail-card">
		<button class="page-kit-icon-button skill-detail-close absolute right-3 top-3 h-9 w-9 text-lg leading-none" aria-label="Close detail" type="button" data-close-detail>&times;</button>
		<div class="skill-detail-content flex flex-col gap-5 text-left sm:flex-row sm:items-start sm:gap-6">
			<div class="skill-detail-icon page-kit-panel flex h-16 w-16 shrink-0 items-center justify-center self-start p-0">
				@skillAsset(props.Skill, props.Skill.Name, "flex h-full w-full items-center justify-center", "h-10 w-10")
			</div>
			<div class="skill-detail-info min-w-0 flex-1">
				<h4 class="skill-detail-name mb-1 text-xl font-bold text-copy-primary">{ props.Skill.Name }</h4>
				if props.Skill.Category != "" {
					<span class={ categoryTagClasses(props.Skill.Category) + " mb-3" }>{ props.Skill.Category }</span>
				}
				<div class="skill-detail-proficiency mb-3 flex flex-col gap-3 md:flex-row md:items-center">
					<div class={ proficiencyBadgeClasses(props.Skill.Proficiency, false) }>
						{ props.Skill.Proficiency }
					</div>
					<div class="proficiency-bar h-1.5 w-full max-w-[12.5rem] overflow-hidden rounded bg-carbon-black-800">
						<div class={ proficiencyFillClasses(props.Skill.Proficiency) }></div>
					</div>
				</div>
				if props.Skill.Description != "" {
					<p class="skill-detail-desc mb-3 text-sm leading-relaxed text-copy-secondary">{ props.Skill.Description }</p>
				}
				if props.Skill.Link != "" {
					<a href={ templ.SafeURL(props.Skill.Link) } target="_blank" rel="noopener noreferrer" class="skill-detail-link group inline-flex items-center gap-1 text-sm font-medium text-primary-100 transition hover:text-accent-200">
						Learn More
						<span class="link-arrow transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
					</a>
				}
			</div>
		</div>
	</div>
}
