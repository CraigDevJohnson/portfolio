package partials

import "portfolio/types"

type SkillDetailProps struct {
	Skill types.Skill
}

templ SkillDetail(props SkillDetailProps) {
	<div class="skill-detail-card relative mt-6 rounded-2xl border border-white/12 border-l-4 border-l-primary-400 bg-[linear-gradient(135deg,rgba(0,30,51,0.22)_0%,rgba(36,0,14,0.16)_52%,rgba(255,255,255,0.02)_100%)] px-6 py-5 shadow-panel animate-[card-fade-in_0.3s_ease-out]">
		<button class="skill-detail-close absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center rounded-md border border-white/10 bg-transparent text-lg leading-none text-copy-muted transition hover:border-primary-400/30 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-label="Close detail" type="button" data-close-detail>&times;</button>
		<div class="skill-detail-content flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
			<div class="skill-detail-icon flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/5">
				@skillAsset(props.Skill, props.Skill.Name, "flex h-full w-full items-center justify-center", "h-10 w-10")
			</div>
			<div class="skill-detail-info min-w-0 flex-1">
				<h4 class="skill-detail-name mb-1 text-xl font-bold text-copy-primary">{ props.Skill.Name }</h4>
				if props.Skill.Category != "" {
					<span class={ categoryTagClasses(props.Skill.Category) + " mb-3" }>{ props.Skill.Category }</span>
				}
				<div class="skill-detail-proficiency mb-3 flex flex-col gap-3 sm:flex-row sm:items-center">
					<div class={ proficiencyBadgeClasses(props.Skill.Proficiency, false) }>
						{ props.Skill.Proficiency }
					</div>
					<div class="proficiency-bar h-1.5 w-full max-w-[12.5rem] overflow-hidden rounded bg-white/8">
						<div class={ proficiencyFillClasses(props.Skill.Proficiency) }></div>
					</div>
				</div>
				if props.Skill.Description != "" {
					<p class="skill-detail-desc mb-3 text-sm leading-relaxed text-copy-secondary">{ props.Skill.Description }</p>
				}
				if props.Skill.Link != "" {
					<a href={ templ.SafeURL(props.Skill.Link) } target="_blank" rel="noopener noreferrer" class="skill-detail-link group inline-flex items-center gap-1 text-sm font-medium text-primary-100 transition hover:text-secondary-200">
						Learn More
						<span class="link-arrow transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
					</a>
				}
			</div>
		</div>
	</div>
}
