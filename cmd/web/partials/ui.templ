package partials

type CTALink struct {
	Href     string
	Label    string
	External bool
}

templ SectionLabel(label string) {
	<div class="page-kit-section-label">
		<span class="page-kit-section-label-line" aria-hidden="true"></span>
		<span class="page-kit-eyebrow">{ label }</span>
	</div>
}

templ PageCTA(title string, subtitle string, primary CTALink, secondary CTALink) {
	<section class="page-kit-panel-strong page-kit-footer-cta relative overflow-hidden px-5 py-8 text-center sm:px-8 sm:py-10 lg:py-12">
		<div class="pointer-events-none absolute left-1/2 top-1/2 h-[15rem] w-[min(28rem,90%)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-radial from-primary-400/18 to-transparent" aria-hidden="true"></div>
		<div class="relative z-10 mx-auto flex max-w-[38rem] flex-col items-center gap-3 sm:gap-4">
			<h2 class="page-kit-heading text-2xl sm:text-3xl">{ title }</h2>
			<p class="page-kit-copy max-w-2xl">{ subtitle }</p>
			<div class="mt-2 flex w-full flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
				<a
					href={ templ.SafeURL(primary.Href) }
					class="page-kit-action page-kit-action-primary w-full justify-center sm:w-auto sm:min-w-[11rem]"
					if primary.External {
						target="_blank"
						rel="noopener noreferrer"
					}
				>
					<span>{ primary.Label }</span>
					<span class="btn-icon" aria-hidden="true">→</span>
				</a>
				<a
					href={ templ.SafeURL(secondary.Href) }
					class="page-kit-action w-full justify-center sm:w-auto sm:min-w-[11rem]"
					if secondary.External {
						target="_blank"
						rel="noopener noreferrer"
					}
				>{ secondary.Label }</a>
			</div>
		</div>
	</section>
}
