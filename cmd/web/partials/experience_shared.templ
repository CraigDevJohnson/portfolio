package partials

type ExperienceKitFooterActionsProps struct {
	Heading     string
	Description string
}

templ ExperienceKitFooterActions(props ExperienceKitFooterActionsProps) {
	@PageCTA(
		props.Heading,
		props.Description,
		CTALink{Href: "/projects", Label: "View Projects"},
		CTALink{Href: "/skills", Label: "Review Skills"},
	)
}
