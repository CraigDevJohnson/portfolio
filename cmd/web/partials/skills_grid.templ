package partials

import (
	"fmt"
	"net/url"
	"portfolio/types"
	"strings"
)

type SkillsGridProps struct {
	Categories     []types.SkillCategory
	FeaturedSkills []types.Skill
}

type SkillsFilterableProps struct {
	Categories        []types.SkillCategory
	ActiveCategory    string
	ActiveProficiency string
}

const conceptsCategoryName = "Concepts & Practices"

func buildFilterURL(category, proficiency string) string {
	params := url.Values{}
	if category != "" {
		params.Set("category", category)
	}
	if proficiency != "" {
		params.Set("proficiency", proficiency)
	}
	q := params.Encode()
	if q == "" {
		return "/skills/filtered"
	}
	return "/skills/filtered?" + q
}

// catSlug normalizes a category name for visual variant mapping.
func catSlug(name string) string {
	s := strings.ToLower(name)
	s = strings.ReplaceAll(s, " & ", "-")
	s = strings.ReplaceAll(s, "/", "")
	s = strings.ReplaceAll(s, " ", "-")
	return s
}

func categoryTagClasses(category string) string {
	base := "inline-flex rounded-full border px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-[0.06em]"
	switch catSlug(category) {
	case "languages-scripting":
		return base + " border-secondary-500/25 bg-secondary-500/12 text-secondary-100"
	case "cloud-platforms":
		return base + " border-primary-500/26 bg-primary-500/12 text-primary-100"
	case "security-identity":
		return base + " border-secondary-500/24 bg-secondary-500/12 text-secondary-100"
	case "containers-orchestration":
		return base + " border-primary-400/25 bg-primary-500/12 text-primary-100"
	case "cicd-automation":
		return base + " border-secondary-500/22 bg-secondary-900/60 text-secondary-100"
	case "infrastructure-as-code":
		return base + " border-secondary-500/24 bg-secondary-500/10 text-secondary-100"
	case "development-tools":
		return base + " border-carbon-black-400/24 bg-carbon-black-700/60 text-carbon-black-100"
	case "operating-systems":
		return base + " border-primary-500/20 bg-primary-950 text-primary-100"
	default:
		return base + " border-white/10 bg-white/5 text-copy-secondary"
	}
}

func filterTabClasses(active bool) string {
	base := "inline-flex min-h-10 items-center gap-2 rounded-full border px-3.5 py-2 text-xs font-medium tracking-[0.02em] transition duration-150 ease-out focus-ring"
	if active {
		return base + " border-secondary-400/55 bg-secondary-500 text-primary-950 shadow-[0_10px_30px_rgba(255,166,0,0.16)]"
	}
	return base + " border-white/10 bg-white/[0.03] text-copy-secondary hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary"
}

func proficiencyBadgeClasses(proficiency string, compact bool) string {
	base := "inline-flex items-center rounded-full border uppercase tracking-[0.05em]"
	if compact {
		base += " px-2 py-0.5 text-[0.6rem] font-medium"
	} else {
		base += " px-2.5 py-1 text-xs font-medium"
	}

	switch proficiency {
	case "expert":
		return base + " border-primary-500/30 bg-primary-500/15 text-primary-100"
	case "advanced":
		return base + " border-secondary-500/28 bg-secondary-500/15 text-secondary-100"
	case "intermediate":
		return base + " border-secondary-500/28 bg-secondary-500/14 text-secondary-100"
	case "familiar":
		return base + " border-carbon-black-400/24 bg-carbon-black-700/60 text-carbon-black-100"
	default:
		return base + " border-white/10 bg-white/5 text-copy-secondary"
	}
}

func shouldInvertSkillIcon(name string) bool {
	switch name {
	case "GitHub", "GitHub Codespaces", "Bash", "Markdown", "SSH", "Splunk", "SQL Server", "CircleCI", "Flask", "Jenkins", "npm", "Node.js":
		return true
	default:
		return false
	}
}

func skillImageClasses(name, size string) string {
	base := size + " object-contain drop-shadow-[0_4px_10px_rgba(0,0,0,0.28)]"
	if shouldInvertSkillIcon(name) {
		return base + " invert"
	}
	return base
}

func skillCardClasses(proficiency string) string {
	base := "group flex min-h-36 w-full flex-col rounded-2xl border p-4 text-left transition duration-200 ease-out hover:-translate-y-1 hover:shadow-panel focus-ring"
	switch proficiency {
	case "expert":
		return base + " border-primary-500/28 bg-[linear-gradient(160deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.88)_48%,rgba(0,149,255,0.14)_100%)] hover:border-primary-400/50"
	case "advanced":
		return base + " border-secondary-500/26 bg-[linear-gradient(160deg,rgba(11,16,24,0.96)_0%,rgba(36,0,14,0.9)_50%,rgba(255,0,98,0.14)_100%)] hover:border-secondary-400/48"
	case "intermediate":
		return base + " border-secondary-500/24 bg-[linear-gradient(160deg,rgba(11,16,24,0.96)_0%,rgba(36,23,0,0.9)_52%,rgba(255,166,0,0.14)_100%)] hover:border-secondary-400/46"
	case "familiar":
		return base + " border-white/10 bg-[linear-gradient(160deg,rgba(11,16,24,0.98)_0%,rgba(19,28,41,0.92)_56%,rgba(159,173,193,0.08)_100%)] hover:border-carbon-black-300/32"
	default:
		return base + " border-white/10 bg-[linear-gradient(160deg,rgba(11,16,24,0.96)_0%,rgba(0,60,102,0.14)_100%)] hover:border-primary-400/35"
	}
}

func skillIconFrameClasses(proficiency string) string {
	base := "mb-3 flex h-12 w-12 items-center justify-center rounded-xl border shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]"
	switch proficiency {
	case "expert":
		return base + " border-primary-400/30 bg-primary-500/12 text-primary-50"
	case "advanced":
		return base + " border-secondary-400/28 bg-secondary-500/12 text-secondary-50"
	case "intermediate":
		return base + " border-secondary-400/28 bg-secondary-500/12 text-secondary-50"
	case "familiar":
		return base + " border-carbon-black-300/22 bg-carbon-black-700/55 text-carbon-black-50"
	default:
		return base + " border-white/10 bg-white/5 text-copy-primary"
	}
}

func proficiencyFilterDotClasses(proficiency string) string {
	base := "inline-block h-2 w-2 shrink-0 rounded-full"
	switch proficiency {
	case "expert":
		return base + " bg-primary-400"
	case "advanced":
		return base + " bg-secondary-400"
	case "intermediate":
		return base + " bg-secondary-400"
	case "familiar":
		return base + " bg-carbon-black-300"
	default:
		return base + " bg-white/40"
	}
}

func skillLevelDotClasses(proficiency string) string {
	base := "pointer-events-none absolute bottom-2 right-2 h-2.5 w-2.5 rounded-full border-2 border-carbon-black-950/80"
	switch proficiency {
	case "expert":
		return base + " bg-primary-400 shadow-[0_0_8px_rgba(0,149,255,0.5)]"
	case "advanced":
		return base + " bg-secondary-400 shadow-[0_0_8px_rgba(255,0,98,0.4)]"
	case "intermediate":
		return base + " bg-secondary-400 shadow-[0_0_8px_rgba(255,166,0,0.42)]"
	case "familiar":
		return base + " bg-carbon-black-300 shadow-[0_0_8px_rgba(171,155,135,0.32)]"
	default:
		return base + " bg-white/40"
	}
}

func proficiencyFillClasses(proficiency string) string {
	base := "h-full rounded-[3px] transition-[width] duration-300 ease-out"
	switch proficiency {
	case "expert":
		return base + " w-full bg-primary-400"
	case "advanced":
		return base + " w-3/4 bg-secondary-400"
	case "intermediate":
		return base + " w-1/2 bg-secondary-400"
	case "familiar":
		return base + " w-1/4 bg-carbon-black-300"
	default:
		return base + " w-1/3 bg-white/40"
	}
}

func countCategorySkills(skills []types.Skill, proficiency string) int {
	c := 0
	for _, s := range skills {
		if proficiency != "" && s.Proficiency != proficiency {
			continue
		}
		c++
	}
	return c
}

func shouldShowSkill(skill types.Skill, proficiency string) bool {
	if proficiency != "" && skill.Proficiency != proficiency {
		return false
	}
	return true
}

func hasVisibleSkills(categories []types.SkillCategory, activeCategory, activeProficiency string) bool {
	for _, cat := range categories {
		if cat.Name == conceptsCategoryName {
			continue
		}
		if activeCategory != "" && cat.Name != activeCategory {
			continue
		}
		if countCategorySkills(cat.Skills, activeProficiency) > 0 {
			return true
		}
	}
	return false
}

templ skillAsset(skill types.Skill, altText string, wrapperClass string, imageClass string) {
	<span class={ wrapperClass }>
	if skill.IconPath != "" {
		<img class={ skillImageClasses(skill.Name, imageClass) } src={ skill.IconPath } alt={ altText } loading="lazy" width="56" height="56"/>
	} else if skill.Icon != "" {
		<span class={ imageClass + " flex items-center justify-center [&>svg]:h-full [&>svg]:w-full" }>
			@templ.Raw(skill.Icon)
		</span>
	}
	</span>
}

templ featuredSkillCardContent(skill types.Skill) {
	@skillAsset(skill, skill.Name, "mb-4 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-white/5", "h-10 w-10")
	<div class="flex w-full flex-1 flex-col items-center gap-2 text-center">
		<h3 class="text-base font-semibold text-copy-primary">{ skill.Name }</h3>
		if skill.Category != "" {
			<span class={ categoryTagClasses(skill.Category) }>{ skill.Category }</span>
		}
		if skill.Description != "" {
			<p class="text-xs leading-relaxed text-copy-muted">{ skill.Description }</p>
		}
		<div class={ proficiencyBadgeClasses(skill.Proficiency, false) }>{ skill.Proficiency }</div>
	</div>
}

templ conceptCardContent(skill types.Skill) {
	@skillAsset(skill, "", "flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5", "h-7 w-7")
	<div class="min-w-0 flex-1">
		<span class="block text-sm font-semibold leading-snug text-copy-primary">{ skill.Name }</span>
		<div class={ proficiencyBadgeClasses(skill.Proficiency, true) }>
			{ skill.Proficiency }
		</div>
	</div>
}

templ SkillsGrid(props SkillsGridProps) {
	<div class="mx-auto flex max-w-[var(--container-site)] flex-col gap-10">
		<!-- Core Competencies -->
		if len(props.FeaturedSkills) > 0 {
			<div class="rounded-[1.75rem] border border-primary-500/18 bg-[linear-gradient(145deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.74)_46%,rgba(255,0,98,0.16)_100%)] px-6 py-8 shadow-panel sm:px-8 sm:py-10">
				<div class="mb-8 text-center">
					<h2 class="inline-block text-2xl font-bold uppercase tracking-[0.08em] text-primary-100 after:mx-auto after:mt-3 after:block after:h-[3px] after:w-16 after:rounded-full after:bg-[linear-gradient(135deg,#33aaff_0%,#ffa600_100%)]">Core Competencies</h2>
					<p class="mt-4 text-base font-medium text-copy-muted">My strongest areas of expertise</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
					for i, skill := range props.FeaturedSkills {
						<div class="animate-[card-fade-in_0.4s_ease-out_both]" style={ fmt.Sprintf("animation-delay: %dms;", i*50) }>
							if skill.Link != "" {
								<a href={ templ.SafeURL(skill.Link) } target="_blank" rel="noopener noreferrer" class="group relative flex h-full min-h-0 flex-col items-center rounded-2xl border border-white/10 bg-[linear-gradient(155deg,rgba(0,21,36,0.72)_0%,rgba(0,60,102,0.28)_40%,rgba(255,255,255,0.03)_100%)] px-5 py-6 text-inherit transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/40 hover:bg-[linear-gradient(155deg,rgba(0,21,36,0.82)_0%,rgba(0,60,102,0.44)_45%,rgba(255,0,98,0.14)_100%)] hover:shadow-panel focus-ring">
									@featuredSkillCardContent(skill)
									<div class="absolute right-4 top-4 text-sm text-copy-muted opacity-0 transition group-hover:opacity-100" aria-hidden="true">↗</div>
								</a>
							} else {
								<div class="flex h-full min-h-0 flex-col items-center rounded-2xl border border-white/10 bg-[linear-gradient(155deg,rgba(0,21,36,0.72)_0%,rgba(0,60,102,0.28)_40%,rgba(255,255,255,0.03)_100%)] px-5 py-6 opacity-95">
									@featuredSkillCardContent(skill)
								</div>
							}
						</div>
					}
				</div>
			</div>
		}
		<!-- Concepts & Practices (elevated position) -->
		for _, cat := range props.Categories {
			if cat.Name == conceptsCategoryName {
				<div class="rounded-[1.75rem] border border-secondary-500/18 bg-[linear-gradient(145deg,rgba(0,21,36,0.94)_0%,rgba(0,30,51,0.62)_44%,rgba(36,0,14,0.36)_100%)] px-6 py-8 shadow-panel sm:px-8 sm:py-10">
					<div class="mb-8 text-center">
						<h2 class="inline-block text-2xl font-bold uppercase tracking-[0.08em] text-primary-100 after:mx-auto after:mt-3 after:block after:h-[3px] after:w-16 after:rounded-full after:bg-[linear-gradient(135deg,#33aaff_0%,#ff0062_100%)]">Concepts &amp; Practices</h2>
						<p class="mt-4 text-base font-medium text-copy-muted">Engineering principles that guide my approach</p>
					</div>
					<div class="grid gap-3 lg:grid-cols-2 xl:grid-cols-3">
						for i, skill := range cat.Skills {
							if skill.Link != "" {
								<a
									href={ templ.SafeURL(skill.Link) }
									target="_blank"
									rel="noopener noreferrer"
									class="group grid min-h-[5.5rem] grid-cols-[auto_1fr_auto] items-center gap-4 rounded-2xl border border-white/10 bg-[linear-gradient(155deg,rgba(0,30,51,0.26)_0%,rgba(255,0,98,0.08)_100%)] px-4 py-4 text-inherit transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/34 hover:shadow-panel focus-ring"
									style={ fmt.Sprintf("animation-delay: %dms;", i*60) }
								>
									@conceptCardContent(skill)
									<span class="text-sm text-copy-muted opacity-0 transition group-hover:opacity-100" aria-hidden="true">↗</span>
								</a>
							} else {
								<div
									class="grid min-h-[5.5rem] grid-cols-[auto_1fr] items-center gap-4 rounded-2xl border border-white/10 bg-[linear-gradient(155deg,rgba(0,30,51,0.26)_0%,rgba(255,0,98,0.08)_100%)] px-4 py-4"
									style={ fmt.Sprintf("animation-delay: %dms;", i*60) }
								>
									@conceptCardContent(skill)
								</div>
							}
						}
					</div>
				</div>
			}
		}
		<!-- Filterable Skills Section -->
		@SkillsFilterableSection(SkillsFilterableProps{
			Categories:        props.Categories,
			ActiveCategory:    "",
			ActiveProficiency: "",
		})
	</div>
}

templ SkillsFilterableSection(props SkillsFilterableProps) {
	<div id="skills-filterable" class="rounded-[1.75rem] border border-white/10 bg-[linear-gradient(145deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.3)_42%,rgba(36,0,14,0.42)_100%)] px-6 py-8 shadow-panel sm:px-8 sm:py-10">
    <!-- Section Heading -->
		<div class="mb-8 text-center">
			<h2 class="inline-block text-2xl font-bold uppercase tracking-[0.08em] text-primary-100 after:mx-auto after:mt-3 after:block after:h-[3px] after:w-16 after:rounded-full after:bg-[linear-gradient(135deg,#33aaff_0%,#ffa600_100%)]">All Technical Skills</h2>
      <p class="mt-4 text-base font-medium text-copy-muted">A filterable list of my technical toolkit</p>
		</div>
		<!-- Filter Bar -->
		<div class="mb-8 rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] sm:p-5">
			<div class="flex flex-col gap-6">
				<div class="flex flex-col gap-3 lg:flex-row lg:items-start">
					<span class="min-w-20 pt-1 text-xs font-semibold uppercase tracking-[0.08em] text-copy-muted">Category</span>
					<div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
					<button
						type="button"
							class={ filterTabClasses(props.ActiveCategory == "") }
						hx-get={ buildFilterURL("", props.ActiveProficiency) }
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
						aria-pressed={ fmt.Sprintf("%t", props.ActiveCategory == "") }
					>
						All
					</button>
					for _, cat := range props.Categories {
						if cat.Name != conceptsCategoryName {
							<button
								type="button"
									class={ filterTabClasses(props.ActiveCategory == cat.Name) }
								hx-get={ buildFilterURL(cat.Name, props.ActiveProficiency) }
								hx-target="#skills-filterable"
								hx-swap="outerHTML"
								aria-pressed={ fmt.Sprintf("%t", props.ActiveCategory == cat.Name) }
							>
								{ cat.Name }
							</button>
						}
					}
				</div>
			</div>
				<div class="flex flex-col gap-3 lg:flex-row lg:items-start">
					<span class="min-w-20 pt-1 text-xs font-semibold uppercase tracking-[0.08em] text-copy-muted">Proficiency</span>
					<div class="flex flex-wrap gap-2" role="group" aria-label="Filter by proficiency">
					<button
						type="button"
						class={ filterTabClasses(props.ActiveProficiency == "") }
						hx-get={ buildFilterURL(props.ActiveCategory, "") }
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
						aria-pressed={ fmt.Sprintf("%t", props.ActiveProficiency == "") }
					>
						All
					</button>
					<button
						type="button"
						class={ filterTabClasses(props.ActiveProficiency == "expert") }
						hx-get={ buildFilterURL(props.ActiveCategory, "expert") }
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
						aria-pressed={ fmt.Sprintf("%t", props.ActiveProficiency == "expert") }
					>
						<span class={ proficiencyFilterDotClasses("expert") } aria-hidden="true"></span> Expert
					</button>
					<button
						type="button"
						class={ filterTabClasses(props.ActiveProficiency == "advanced") }
						hx-get={ buildFilterURL(props.ActiveCategory, "advanced") }
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
						aria-pressed={ fmt.Sprintf("%t", props.ActiveProficiency == "advanced") }
					>
						<span class={ proficiencyFilterDotClasses("advanced") } aria-hidden="true"></span> Advanced
					</button>
					<button
						type="button"
						class={ filterTabClasses(props.ActiveProficiency == "intermediate") }
						hx-get={ buildFilterURL(props.ActiveCategory, "intermediate") }
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
						aria-pressed={ fmt.Sprintf("%t", props.ActiveProficiency == "intermediate") }
					>
						<span class={ proficiencyFilterDotClasses("intermediate") } aria-hidden="true"></span> Intermediate
					</button>
					<button
						type="button"
						class={ filterTabClasses(props.ActiveProficiency == "familiar") }
						hx-get={ buildFilterURL(props.ActiveCategory, "familiar") }
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
						aria-pressed={ fmt.Sprintf("%t", props.ActiveProficiency == "familiar") }
					>
						<span class={ proficiencyFilterDotClasses("familiar") } aria-hidden="true"></span> Familiar
					</button>
				</div>
			</div>
			</div>
		</div>
		<!-- Skills Grid -->
		<div class="space-y-8">
			if hasVisibleSkills(props.Categories, props.ActiveCategory, props.ActiveProficiency) {
				for catIndex, cat := range props.Categories {
					if cat.Name != conceptsCategoryName && (props.ActiveCategory == "" || props.ActiveCategory == cat.Name) {
						if countCategorySkills(cat.Skills, props.ActiveProficiency) > 0 {
							<div class="animate-[card-fade-in_0.45s_ease-out_both] rounded-2xl border border-white/8 bg-black/10 p-4 sm:p-5" style={ fmt.Sprintf("animation-delay: %dms;", catIndex*80) }>
								<h3 class="mb-4 flex items-center gap-3 border-l-4 border-l-primary-400 pl-3 text-base font-semibold uppercase tracking-[0.05em] text-copy-primary sm:text-lg">
									{ cat.Name }

								</h3>
								<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
									for skillIndex, skill := range cat.Skills {
										if shouldShowSkill(skill, props.ActiveProficiency) {
											<button
												type="button"
												class={ skillCardClasses(skill.Proficiency) }
												data-proficiency={ skill.Proficiency }
												data-skill-id={ fmt.Sprintf("%d", skill.ID) }
												hx-get={ fmt.Sprintf("/skills/detail?id=%d", skill.ID) }
												hx-target={ fmt.Sprintf("#detail-slot-%d", catIndex) }
												hx-swap="innerHTML"
												style={ fmt.Sprintf("animation-delay: %dms;", skillIndex*30) }
												aria-label={ skill.Name }
												aria-expanded="false"
												aria-controls={ fmt.Sprintf("detail-slot-%d", catIndex) }
											>
												@skillAsset(skill, skill.Name, skillIconFrameClasses(skill.Proficiency), "h-8 w-8")
												<span class="text-sm font-semibold leading-snug text-copy-primary">{ skill.Name }</span>
												<div class="mt-auto flex w-full items-center justify-between gap-2 pt-3">
													<span class={ proficiencyBadgeClasses(skill.Proficiency, true) }>{ skill.Proficiency }</span>
													<span class="inline-flex items-center gap-1 text-[0.68rem] font-medium uppercase tracking-[0.05em] text-copy-muted transition group-hover:text-copy-primary">
														Details
														<span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
													</span>
												</div>
											</button>
										}
									}
								</div>
								<div id={ fmt.Sprintf("detail-slot-%d", catIndex) } class="mt-4 overflow-hidden"></div>
							</div>
						}
					}
				}
			} else {
				<div class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-6 text-center">
					<p class="text-sm text-copy-secondary">No skills match the selected filters.</p>
					<button
						type="button"
						class="btn btn-secondary btn-sm"
						hx-get="/skills/filtered"
						hx-target="#skills-filterable"
						hx-swap="outerHTML"
					>
						Clear Filters
					</button>
				</div>
			}
		</div>
	</div>
}
