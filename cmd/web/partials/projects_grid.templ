package partials

import "fmt"
import "portfolio/types"

type ProjectsGridProps struct {
	Projects []types.Project
}

func projectDossierClasses(project types.Project) string {
	classes := "project-dossier"
	if project.Featured {
		return classes + " project-dossier-lead"
	}
	return classes + " project-dossier-support"
}

func projectImageIntrinsicHeight(ratio types.ProjectImageRatio) string {
	if ratio == types.ProjectImagePortrait {
		return "1200"
	}
	return "534"
}

func projectImageLoading(project types.Project) string {
	if project.Featured {
		return "eager"
	}
	return "lazy"
}

templ ProjectDossier(dossier projectDossier) {
	<article
		class={ projectDossierClasses(dossier.Project) }
		data-project-dossier
		data-featured={ fmt.Sprintf("%t", dossier.Project.Featured) }
		data-image-ratio={ dossier.Project.ImageRatio }
		aria-labelledby={ fmt.Sprintf("project-title-%d", dossier.Project.ID) }
	>
		<figure class="project-dossier-media" data-image-ratio={ dossier.Project.ImageRatio }>
			<span class="project-dossier-image-fallback" data-image-fallback aria-hidden="true">
				<span>Project file</span>
				<strong>{ dossier.Project.Name }</strong>
			</span>
			if dossier.Project.Image != "" {
				<img
					src={ dossier.Project.Image }
					alt={ fmt.Sprintf("Preview of %s", dossier.Project.Name) }
					loading={ projectImageLoading(dossier.Project) }
					width="800"
					height={ projectImageIntrinsicHeight(dossier.Project.ImageRatio) }
					class="project-dossier-image"
					data-remote-image
				/>
			}
		</figure>
		<div class="project-dossier-body">
			<header class="project-dossier-header">
				<div class="project-dossier-meta">
					<span class="page-kit-chip">{ dossier.Project.Category }</span>
					<span>{ fmt.Sprintf("%d technologies", len(dossier.Project.Technologies)) }</span>
				</div>
				<h3 id={ fmt.Sprintf("project-title-%d", dossier.Project.ID) } class="project-dossier-title">{ dossier.Project.Name }</h3>
			</header>
			<div class="project-dossier-notes">
				<section class="project-dossier-note project-dossier-problem">
					<h4>Problem</h4>
					<p>{ dossier.Project.Problem }</p>
				</section>
				<section class="project-dossier-note project-dossier-approach">
					<h4>Approach</h4>
					<p>{ dossier.Project.Approach }</p>
				</section>
				<section class="project-dossier-note project-dossier-outcome">
					<h4>Outcome</h4>
					<p>{ dossier.Project.Outcome }</p>
				</section>
			</div>
			<section class="project-dossier-technology">
				<h4>Technology</h4>
				<div class="project-dossier-tech-list">
					for _, tech := range dossier.Project.Technologies {
						<span class="tech-pill">{ tech }</span>
					}
				</div>
			</section>
			if len(dossier.Destinations) > 0 {
				<section class="project-dossier-destination">
					<h4>Destination</h4>
					<div class="project-dossier-actions">
						for _, destination := range dossier.Destinations {
							@ActionLink(projectDestinationAction(destination))
						}
					</div>
				</section>
			}
		</div>
	</article>
}

templ ProjectsGrid(props ProjectsGridProps) {
	{{ dossiers := buildProjectDossiers(props.Projects) }}
	<div class="project-dossier-composition">
		@SignalTrail(SignalTrailProps{Variant: TrailDossier, ExtraClass: "projects-dossier-signal"})
		<div class="project-dossier-lead-region" data-region="lead">
			if len(dossiers) > 0 {
				@ProjectDossier(dossiers[0])
			}
		</div>
		<div class="project-dossier-support-grid" data-region="support">
			if len(dossiers) > 1 {
				for _, dossier := range dossiers[1:] {
					@ProjectDossier(dossier)
				}
			}
		</div>
	</div>
}
