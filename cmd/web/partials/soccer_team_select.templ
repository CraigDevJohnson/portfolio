package partials

import (
	"fmt"
	"portfolio/types"
)

type SoccerTeamSelectProps struct {
	PlayerGroups []types.PlayerTeamGroup
	PlayerIDs    []int
}

templ SoccerTeamSelect(props SoccerTeamSelectProps) {
	<form
		id="soccer-team-select-form"
		class="soccer-team-select-form"
		hx-post="/soccer/fetch"
		hx-target="#games-container"
		hx-swap="innerHTML"
		hx-indicator="#loading-indicator, .soccer-team-submit-indicator"
		hx-disabled-elt="find button[type='submit']"
	>
		for _, playerID := range props.PlayerIDs {
			<input type="hidden" name="player_ids" value={ fmt.Sprintf("%d", playerID) }/>
		}
		<fieldset class="soccer-team-fieldset">
			<legend>Select teams to include</legend>
			<p class="soccer-team-hint">
				Choose which teams to fetch schedules for. Teams marked <span class="team-badge team-badge--sub" aria-label="Sub">Sub</span> were not on your account at session start.
			</p>
			for _, group := range props.PlayerGroups {
				<div class="soccer-team-player-group">
					<span class="soccer-team-player-name">{ group.Player.FirstName } { group.Player.LastName }</span>
					<div class="soccer-team-list">
						for _, team := range group.Teams {
							<label
								class="soccer-team-option"
								title={ fmt.Sprintf("Team ID: %d | Season: %d", team.TeamID, team.Season) }
							>
								<input
									type="checkbox"
									name="team_ids"
									value={ fmt.Sprintf("%d", team.TeamID) }
									if !team.IsSubTeam {
										checked
									}
									aria-label={ team.TeamName }
								/>
								<span class="soccer-team-option-copy">
									<span class="soccer-team-name">{ team.TeamName }</span>
									if team.IsSubTeam {
										<span class="team-badge team-badge--sub" aria-label="Sub team">Sub</span>
									}
								</span>
							</label>
						}
					</div>
				</div>
			}
			<button type="submit" class="btn btn-primary soccer-team-submit btn-loading" data-loading-button>
				<span class="btn-text">Fetch Schedules</span>
				<span class="btn-loading-indicator soccer-team-submit-indicator htmx-indicator" aria-hidden="true"></span>
			</button>
		</fieldset>
	</form>
}
