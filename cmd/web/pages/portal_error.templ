package pages

import "portfolio/cmd/web/layouts"
import "portfolio/cmd/web/partials"

templ PortalError(props ErrorPageProps) {
	@layouts.Base(layouts.BaseProps{Title: props.PageTitle(), Page: "portal", Shell: layouts.ShellOperator}) {
		<div class="page-kit-page portal-error-page portal-console-error-page" data-layout="operator-interruption">
			<section class="portal-error-card portal-console-error-card" aria-labelledby="portal-error-heading">
				<div class="portal-error-code" aria-label={ props.StatusLabel() }>{ props.StatusText() }</div>
				<div class="portal-error-copy">
					<p class="page-kit-eyebrow">Management portal</p>
					<h1 id="portal-error-heading" class="page-section-title">{ props.Heading() }</h1>
					@partials.Feedback(partials.FeedbackProps{
						Kind:       partials.FeedbackError,
						Title:      props.FeedbackTitle(),
						Message:    props.Message,
						ExtraClass: "portal-error-feedback",
					})
					@partials.ActionLink(partials.ActionLinkProps{
						Href:       "/",
						Label:      "Back to portfolio",
						Variant:    partials.ActionPrimary,
						ShowArrow:  true,
						ExtraClass: "portal-error-action",
					})
				</div>
				@partials.SignalTrail(partials.SignalTrailProps{Variant: partials.TrailInterruption, ExtraClass: "portal-interruption-trail"})
			</section>
		</div>
	}
}
