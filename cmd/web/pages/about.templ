package pages

import (
	"fmt"
	"portfolio/cmd/web/layouts"
	"portfolio/cmd/web/partials"
)

type AboutProps struct {
	YearsInTech    int
	Certifications int
	TechUsed       int
	CupsOfCoffee   string
}

func aboutCoreValueCards() []partials.FeatureCardProps {
	return []partials.FeatureCardProps{
		{Icon: "🔄", Title: "Continuous Improvement", Description: "Always iterating, always learning — there&apos;s always a better way to build.", Tone: "accent", ExtraClass: "stagger-enter"},
		{Icon: "🤝", Title: "Collaboration", Description: "The best solutions come from diverse perspectives working together.", Tone: "primary", ExtraClass: "stagger-enter"},
		{Icon: "🧩", Title: "Problem Solving", Description: "Breaking down complex challenges into elegant, maintainable solutions.", Tone: "secondary", ExtraClass: "stagger-enter"},
		{Icon: "📝", Title: "Documentation", Description: "If it isn&apos;t documented, it doesn&apos;t exist — clear docs enable great teams.", Tone: "accent", ExtraClass: "stagger-enter"},
	}
}

func aboutStatCards(props AboutProps) []partials.StatCardProps {
	return []partials.StatCardProps{
		{Value: fmt.Sprintf("%d", props.YearsInTech), Label: "Years in Tech", AriaLabel: fmt.Sprintf("%d years in tech", props.YearsInTech), ExtraClass: "stagger-enter relative"},
		{Value: fmt.Sprintf("%d", props.Certifications), Label: "Certifications", AriaLabel: fmt.Sprintf("%d certifications", props.Certifications), ExtraClass: "stagger-enter relative"},
		{Value: fmt.Sprintf("%d", props.TechUsed), Label: "Technologies", AriaLabel: fmt.Sprintf("%d technologies", props.TechUsed), ExtraClass: "stagger-enter relative"},
		{Value: props.CupsOfCoffee, Label: "Cups of Coffee", AriaLabel: fmt.Sprintf("%s cups of coffee", props.CupsOfCoffee), CornerIcon: "☕", ExtraClass: "stagger-enter relative"},
	}
}

func aboutQuickFacts() []partials.InfoRowProps {
	return []partials.InfoRowProps{
		{Icon: "📍", Text: "Originally from Alaska"},
		{Icon: "👨‍👩‍👧‍👦", Text: "Family of 4 + 2 dogs"},
		{Icon: "⚽", Text: "Lifelong soccer enthusiast"},
		{Icon: "🎓", Text: "BS in Cloud Computing"},
		{Icon: "☁️", Text: "Cloud & automation specialist"},
		{Icon: "📚", Text: "Continuous learner"},
	}
}

templ About(props AboutProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "About Me - Craig Johnson",
		Page:  "about",
	}) {
		<div class="page-kit-page">
		@partials.PageHero(partials.PageHeroProps{
			ImageURL:     "/static/images/backgrounds/about-hero.jpg",
			ContentClass: "flex min-h-full flex-col justify-center",
		}) {
			@partials.PageHeroIntro(partials.PageHeroIntroProps{Eyebrow: "About", Title: "About Me", MaxWidthClass: "max-w-3xl"}) {
				<p class="page-hero-description max-w-3xl">A journey from the frosty expanses of Alaska to building cloud infrastructure at scale.</p>
			}
		}
		<section class="page-stats-section">
			@partials.StatCardGrid(partials.StatCardGridProps{Cards: aboutStatCards(props)})
		</section>
		<section class="page-section">
			<div class="grid gap-8 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] xl:items-start">
				<div class="space-y-6">
					@partials.SectionLabel("My Story")
					<h2 class="page-section-title">From the Last Frontier to the Cloud</h2>
					<div class="space-y-5 text-base leading-7 text-copy-secondary sm:text-lg sm:leading-8">
						<p>
							I'm a passionate tech enthusiast who has journeyed from the frosty expanses of Alaska to
							embrace new opportunities and challenges. I'm happily married with two wonderful kids,
							and our family is rounded out by our two beloved dogs.
						</p>
						<blockquote class="page-kit-panel-strong border-l-4 border-accent-400 px-6 py-5 text-lg italic text-copy-primary shadow-panel">
							"The decision to move out of Alaska was driven by a desire for greater opportunities and the chance to expand my horizons."
						</blockquote>
						<p>
							My tech career began at the local university as a Service Desk Student Analyst, where I
							laid the foundations of my skills and knowledge. This journey led me into the health care
							sector, providing tech support and ensuring that technology enhances patient care and
							operational efficiency.
						</p>
						<p>
							Soccer has been a lifelong love of mine, keeping me active and connected with the
							community. I'm always eager to learn new tools and technologies and am thrilled by the
							endless possibilities ahead.
						</p>
					</div>
				</div>
				<div class="page-kit-panel-strong p-6 xl:sticky xl:top-[calc(var(--header-height)+1.5rem)]">
					<h3 class="text-gradient-brand text-xl font-semibold">Quick Facts</h3>
					<div class="mt-5 grid gap-3">
						for _, fact := range aboutQuickFacts() {
							@partials.InfoRow(fact)
						}
					</div>
				</div>
			</div>
		</section>
		<section class="page-section">
			@partials.SectionLabel("Career Timeline")
			<h2 class="page-section-title">The Journey So Far</h2>
			<div class="page-kit-panel-strong relative pl-7">
				<div class="absolute bottom-0 left-2 top-0 w-px bg-linear-to-b from-accent-400 to-accent-400/20"></div>
				<div class="relative pb-8 pl-6">
					<div class="page-kit-timeline-dot"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2012</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Started in Tech</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Service Desk Student Analyst — first steps into IT support and troubleshooting.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="page-kit-timeline-dot"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2016</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Healthcare IT</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Moved into healthcare technology — ensuring systems enhance patient care.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="page-kit-timeline-dot"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2018</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Microsoft Certified</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Earned MCSA and MCSE certifications — a deep dive into enterprise infrastructure.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="page-kit-timeline-dot"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2021</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Cloud Transition</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Pivoted to cloud engineering — AWS, Azure, and infrastructure as code.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="page-kit-timeline-dot"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2023</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">BS in Cloud Computing</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Completed the degree at Western Governors University with multiple cloud certifications.</p>
				</div>
				<div class="relative pl-6">
					<div class="page-kit-timeline-dot-current"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">Now</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Cloud Engineer Principal</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Leading cloud infrastructure, automation, and DevOps practices.</p>
				</div>
			</div>
		</section>
		<section class="page-section">
			@partials.SectionLabel("Beyond the Code")
			<h2 class="page-section-title">Outside of work</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<div class="page-kit-feature-card stagger-enter">
					<span class="mb-4 block text-3xl">⚽</span>
					<h3 class="text-lg font-semibold text-copy-primary">Soccer</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Playing and coaching — plus building tools to manage match schedules.</p>
				</div>
				<div class="page-kit-feature-card stagger-enter">
					<span class="mb-4 block text-3xl">🏔️</span>
					<h3 class="text-lg font-semibold text-copy-primary">Outdoors</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Alaska roots mean a love for hiking, fishing, and exploring nature.</p>
				</div>
				<div class="page-kit-feature-card stagger-enter">
					<span class="mb-4 block text-3xl">🎮</span>
					<h3 class="text-lg font-semibold text-copy-primary">Gaming</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Strategy and building games exercise the same problem-solving muscles as engineering.</p>
				</div>
				<div class="page-kit-feature-card stagger-enter">
					<span class="mb-4 block text-3xl">🐕</span>
					<h3 class="text-lg font-semibold text-copy-primary">Dog Dad</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">A lively home office comes with four paws, plenty of opinions, and zero calendar discipline.</p>
				</div>
			</div>
		</section>
		<section class="page-section">
			@partials.SectionLabel("What Drives Me")
			<h2 class="page-section-title">Core Values</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				for _, card := range aboutCoreValueCards() {
					@partials.FeatureCard(card)
				}
			</div>
		</section>
		@partials.PageCTA(
			"Want to know more?",
			"Check out my experience or reach out directly",
			partials.CTALink{Href: "/experience", Label: "View My Experience"},
			partials.CTALink{Href: "/contact", Label: "Get in Touch"},
		)
		</div>
	}
}
