package pages

import (
	"portfolio/cmd/web/layouts"
	"fmt"
)

type AboutProps struct {
	YearsInTech    int
	Certifications int
	TechUsed       int
	CupsOfCoffee   string
}

templ About(props AboutProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "About Me - Craig Johnson",
		Page:  "about",
	}) {
		<section class="relative isolate overflow-hidden rounded-[2rem] border border-carbon-black-800 bg-carbon-black-950 bg-cover bg-center px-6 py-14 shadow-panel-strong sm:px-8 lg:px-12 lg:py-20" style="background-image: url('/static/images/backgrounds/about-hero.jpg')">
			<div class="absolute inset-0 bg-linear-to-br from-carbon-black-950/92 via-carbon-black-950/78 to-secondary-950/68"></div>
			<div class="relative max-w-3xl space-y-5">
				<h1 class="text-4xl font-bold tracking-tight text-copy-primary sm:text-5xl">About Me</h1>
				<p class="max-w-3xl text-base leading-7 text-copy-secondary sm:text-lg sm:leading-8">A journey from the frosty expanses of Alaska to building cloud infrastructure at scale.</p>
			</div>
		</section>

		<section class="about-stats py-10 sm:py-12">
			<div class="stats-grid grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
				<div class="surface-card stagger-enter relative px-5 py-6 text-center">
					<span class="about-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ fmt.Sprintf("%d", props.YearsInTech) } aria-label={ fmt.Sprintf("%d years in tech", props.YearsInTech) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Years in Tech</span>
				</div>
				<div class="surface-card stagger-enter relative px-5 py-6 text-center">
					<span class="about-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ fmt.Sprintf("%d", props.Certifications) } aria-label={ fmt.Sprintf("%d certifications", props.Certifications) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Certifications</span>
				</div>
				<div class="surface-card stagger-enter relative px-5 py-6 text-center">
					<span class="about-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ fmt.Sprintf("%d", props.TechUsed) } aria-label={ fmt.Sprintf("%d technologies", props.TechUsed) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Technologies</span>
				</div>
				<div class="surface-card stagger-enter relative px-5 py-6 text-center">
					<span class="about-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ props.CupsOfCoffee } aria-label={ fmt.Sprintf("%s cups of coffee", props.CupsOfCoffee) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Cups of Coffee</span>
					<span class="absolute right-4 top-4 text-2xl opacity-50" aria-hidden="true">☕</span>
				</div>
			</div>
		</section>

		<section class="py-12 sm:py-14">
			<div class="grid gap-8 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] xl:items-start">
				<div class="space-y-6">
					<div class="section-label">
						<span class="label-line" aria-hidden="true"></span>
						<span>My Story</span>
					</div>
					<h2 class="text-3xl font-bold tracking-tight text-copy-primary">From the Last Frontier to the Cloud</h2>
					<div class="space-y-5 text-base leading-7 text-copy-secondary sm:text-lg sm:leading-8">
						<p>
							I'm a passionate tech enthusiast who has journeyed from the frosty expanses of Alaska to
							embrace new opportunities and challenges. I'm happily married with two wonderful kids,
							and our family is rounded out by our two beloved dogs.
						</p>
						<blockquote class="rounded-r-2xl border-l-4 border-accent-400/80 bg-linear-to-br from-accent-500/10 to-primary-500/5 px-6 py-5 text-lg italic text-copy-primary shadow-panel">
							"The decision to move out of Alaska was driven by a desire for greater opportunities and the chance to expand my horizons."
						</blockquote>
						<p>
							My tech career began at the local university as a Service Desk Student Analyst, where I
							laid the foundations of my skills and knowledge. This journey led me into the health care
							sector, providing tech support and ensuring that technology enhances patient care and
							operational efficiency.
						</p>
						<p>
							Soccer has been a lifelong love of mine, keeping me active and connected with the
							community. I'm always eager to learn new tools and technologies and am thrilled by the
							endless possibilities ahead.
						</p>
					</div>
				</div>

				<div class="surface-card-strong p-6 xl:sticky xl:top-[calc(var(--header-height)+1.5rem)]">
					<h3 class="text-gradient-brand text-xl font-semibold">Quick Facts</h3>
					<div class="mt-5 grid gap-3">
						<div class="flex items-center gap-3 rounded-xl bg-carbon-black-950/55 px-4 py-3 text-sm font-medium text-copy-secondary transition duration-200 hover:bg-accent-500/10 hover:text-copy-primary">
							<span class="text-xl" aria-hidden="true">📍</span>
							<span>Originally from Alaska</span>
						</div>
						<div class="flex items-center gap-3 rounded-xl bg-carbon-black-950/55 px-4 py-3 text-sm font-medium text-copy-secondary transition duration-200 hover:bg-accent-500/10 hover:text-copy-primary">
							<span class="text-xl" aria-hidden="true">👨‍👩‍👧‍👦</span>
							<span>Family of 4 + 2 dogs</span>
						</div>
						<div class="flex items-center gap-3 rounded-xl bg-carbon-black-950/55 px-4 py-3 text-sm font-medium text-copy-secondary transition duration-200 hover:bg-accent-500/10 hover:text-copy-primary">
							<span class="text-xl" aria-hidden="true">⚽</span>
							<span>Lifelong soccer enthusiast</span>
						</div>
						<div class="flex items-center gap-3 rounded-xl bg-carbon-black-950/55 px-4 py-3 text-sm font-medium text-copy-secondary transition duration-200 hover:bg-accent-500/10 hover:text-copy-primary">
							<span class="text-xl" aria-hidden="true">🎓</span>
							<span>BS in Cloud Computing</span>
						</div>
						<div class="flex items-center gap-3 rounded-xl bg-carbon-black-950/55 px-4 py-3 text-sm font-medium text-copy-secondary transition duration-200 hover:bg-accent-500/10 hover:text-copy-primary">
							<span class="text-xl" aria-hidden="true">☁️</span>
							<span>Cloud &amp; automation specialist</span>
						</div>
						<div class="flex items-center gap-3 rounded-xl bg-carbon-black-950/55 px-4 py-3 text-sm font-medium text-copy-secondary transition duration-200 hover:bg-accent-500/10 hover:text-copy-primary">
							<span class="text-xl" aria-hidden="true">📚</span>
							<span>Continuous learner</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="space-y-6 py-12 sm:py-14">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Career Timeline</span>
			</div>
			<h2 class="text-3xl font-bold tracking-tight text-copy-primary">The Journey So Far</h2>
			<div class="relative pl-7">
				<div class="absolute bottom-0 left-2 top-0 w-px bg-linear-to-b from-accent-400 to-accent-400/20"></div>
				<div class="relative pb-8 pl-6">
					<div class="absolute left-[-1.15rem] top-1 h-4 w-4 rounded-full border-2 border-accent-400 bg-carbon-black-950 shadow-[0_0_0_4px_rgba(214,191,41,0.12)]"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2012</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Started in Tech</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Service Desk Student Analyst — first steps into IT support and troubleshooting.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="absolute left-[-1.15rem] top-1 h-4 w-4 rounded-full border-2 border-accent-400 bg-carbon-black-950 shadow-[0_0_0_4px_rgba(214,191,41,0.12)]"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2016</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Healthcare IT</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Moved into healthcare technology — ensuring systems enhance patient care.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="absolute left-[-1.15rem] top-1 h-4 w-4 rounded-full border-2 border-accent-400 bg-carbon-black-950 shadow-[0_0_0_4px_rgba(214,191,41,0.12)]"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2018</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Microsoft Certified</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Earned MCSA and MCSE certifications — a deep dive into enterprise infrastructure.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="absolute left-[-1.15rem] top-1 h-4 w-4 rounded-full border-2 border-accent-400 bg-carbon-black-950 shadow-[0_0_0_4px_rgba(214,191,41,0.12)]"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2021</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Cloud Transition</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Pivoted to cloud engineering — AWS, Azure, and infrastructure as code.</p>
				</div>
				<div class="relative pb-8 pl-6">
					<div class="absolute left-[-1.15rem] top-1 h-4 w-4 rounded-full border-2 border-accent-400 bg-carbon-black-950 shadow-[0_0_0_4px_rgba(214,191,41,0.12)]"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">2023</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">BS in Cloud Computing</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Completed the degree at Western Governors University with multiple cloud certifications.</p>
				</div>
				<div class="relative pl-6">
					<div class="absolute left-[-1.2rem] top-1 h-5 w-5 rounded-full border-2 border-primary-300 bg-primary-500 shadow-[0_0_0_4px_rgba(62,193,190,0.18)]"></div>
					<span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-200">Now</span>
					<h3 class="mt-2 text-xl font-semibold text-copy-primary">Cloud Engineer Principal</h3>
					<p class="mt-2 text-base leading-7 text-copy-secondary">Leading cloud infrastructure, automation, and DevOps practices.</p>
				</div>
			</div>
		</section>

		<section class="space-y-6 py-12 sm:py-14">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Beyond the Code</span>
			</div>
			<h2 class="text-3xl font-bold tracking-tight text-copy-primary">When I'm Not in the Terminal</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<div class="surface-card stagger-enter p-6 text-center">
					<span class="mb-4 block text-3xl">⚽</span>
					<h3 class="text-lg font-semibold text-copy-primary">Soccer</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Playing and coaching — plus building tools to manage match schedules.</p>
				</div>
				<div class="surface-card stagger-enter p-6 text-center">
					<span class="mb-4 block text-3xl">🏔️</span>
					<h3 class="text-lg font-semibold text-copy-primary">Outdoors</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Alaska roots mean a love for hiking, fishing, and exploring nature.</p>
				</div>
				<div class="surface-card stagger-enter p-6 text-center">
					<span class="mb-4 block text-3xl">🎮</span>
					<h3 class="text-lg font-semibold text-copy-primary">Gaming</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Strategy and building games exercise the same problem-solving muscles as engineering.</p>
				</div>
				<div class="surface-card stagger-enter p-6 text-center">
					<span class="mb-4 block text-3xl">🐕</span>
					<h3 class="text-lg font-semibold text-copy-primary">Dog Dad</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">A lively home office comes with four paws, plenty of opinions, and zero calendar discipline.</p>
				</div>
			</div>
		</section>

		<section class="space-y-6 py-12 sm:py-14">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>What Drives Me</span>
			</div>
			<h2 class="text-3xl font-bold tracking-tight text-copy-primary">Core Values</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<div class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-700/70 bg-accent-950/60 text-3xl shadow-panel">🔄</div>
					<h3 class="text-lg font-semibold text-copy-primary">Continuous Improvement</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Always iterating, always learning — there&apos;s always a better way to build.</p>
				</div>
				<div class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-700/70 bg-primary-950/60 text-3xl shadow-panel">🤝</div>
					<h3 class="text-lg font-semibold text-copy-primary">Collaboration</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">The best solutions come from diverse perspectives working together.</p>
				</div>
				<div class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-700/70 bg-secondary-950/70 text-3xl shadow-panel">🧩</div>
					<h3 class="text-lg font-semibold text-copy-primary">Problem Solving</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Breaking down complex challenges into elegant, maintainable solutions.</p>
				</div>
				<div class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-700/70 bg-accent-950/60 text-3xl shadow-panel">📝</div>
					<h3 class="text-lg font-semibold text-copy-primary">Documentation</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">If it isn&apos;t documented, it doesn&apos;t exist — clear docs enable great teams.</p>
				</div>
			</div>
		</section>
		<section class="page-cta-section">
			<div class="cta-glow" aria-hidden="true"></div>
			<h2>Want to know more?</h2>
			<p class="cta-subtitle">Check out my experience or reach out directly</p>
			<div class="cta-buttons">
				<a href="/experience" class="btn btn-primary">
					<span>View My Experience</span>
					<span class="btn-icon" aria-hidden="true">→</span>
				</a>
				<a href="/contact" class="btn btn-secondary">Get in Touch</a>
			</div>
		</section>
	}
}
