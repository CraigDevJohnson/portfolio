package pages

import "portfolio/cmd/web/layouts"
import "portfolio/cmd/web/partials"

templ Contact() {
	@layouts.Base(layouts.BaseProps{
		Title: "Get in Touch - Craig Johnson",
		Page:  "contact",
	}) {
		<section
			class="relative overflow-hidden rounded-3xl border border-carbon-black-800 bg-carbon-black-950 bg-[url('/static/images/backgrounds/contact-hero.jpg')] bg-cover bg-center px-6 py-14 shadow-panel-strong sm:px-8 lg:px-12 lg:py-20"
		>
			<div class="absolute inset-0 bg-linear-to-br from-carbon-black-950/95 via-carbon-black-950/85 to-secondary-950/80"></div>
			<div class="relative mx-auto flex max-w-3xl flex-col gap-5">
				<div class="inline-flex w-fit items-center gap-3 rounded-full border border-primary-700 bg-primary-950/80 px-4 py-2 text-sm font-medium text-primary-100 shadow-panel">
					<span class="h-2.5 w-2.5 rounded-full bg-accent-400" aria-hidden="true"></span>
					Open to opportunities
				</div>
				<h1 class="text-4xl font-bold tracking-tight text-copy-primary sm:text-5xl">Get in Touch</h1>
				<p class="max-w-3xl text-base leading-7 text-copy-secondary sm:text-lg sm:leading-8">
					Whether it&apos;s cloud architecture, DevOps strategy, or your next big idea — let&apos;s connect and build something meaningful together.
				</p>
			</div>
		</section>
		<section class="space-y-6 py-10 sm:py-12">
			@partials.SectionLabel("Ways to Connect")
			<h2 class="text-2xl font-semibold tracking-tight text-copy-primary sm:text-3xl">Choose the easiest way to reach me</h2>
			<div class="grid gap-4">
				<a
					href="mailto:opportunity@craigdevjohnson.com"
					class="surface-card focus-ring group flex flex-col gap-4 p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-accent-400 hover:shadow-panel-strong sm:flex-row sm:items-center"
					aria-label="Email opportunity@craigdevjohnson.com"
				>
					<div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-700/70 bg-accent-950/70 text-3xl shadow-panel">
						<span aria-hidden="true">✉️</span>
					</div>
					<div class="min-w-0 flex-1 space-y-1">
						<h3 class="text-lg font-semibold text-copy-primary">Email</h3>
						<p class="break-words text-sm font-medium text-accent-300">opportunity@craigdevjohnson.com</p>
						<p class="text-sm leading-6 text-copy-secondary">Best for professional inquiries and new opportunities.</p>
					</div>
					<span class="text-2xl text-copy-muted transition duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-1 group-hover:text-accent-300" aria-hidden="true">↗</span>
				</a>
				<a
					href="https://linkedin.com/in/craigdevjohnson"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card focus-ring group flex flex-col gap-4 p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong sm:flex-row sm:items-center"
					aria-label="LinkedIn profile for Craig Johnson"
				>
					<div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-700/70 bg-primary-950/70 text-3xl shadow-panel">
						<span aria-hidden="true">💼</span>
					</div>
					<div class="min-w-0 flex-1 space-y-1">
						<h3 class="text-lg font-semibold text-copy-primary">LinkedIn</h3>
						<p class="break-words text-sm font-medium text-primary-200">linkedin.com/in/craigdevjohnson</p>
						<p class="text-sm leading-6 text-copy-secondary">Connect for networking, platform engineering, and career conversations.</p>
					</div>
					<span class="text-2xl text-copy-muted transition duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-1 group-hover:text-primary-200" aria-hidden="true">↗</span>
				</a>
				<a
					href="https://github.com/CraigDevJohnson"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card focus-ring group flex flex-col gap-4 p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-secondary-400 hover:shadow-panel-strong sm:flex-row sm:items-center"
					aria-label="GitHub profile for Craig Johnson"
				>
					<div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-700/70 bg-secondary-950/80 text-3xl shadow-panel">
						<span aria-hidden="true">🛠️</span>
					</div>
					<div class="min-w-0 flex-1 space-y-1">
						<h3 class="text-lg font-semibold text-copy-primary">GitHub</h3>
						<p class="break-words text-sm font-medium text-secondary-200">github.com/CraigDevJohnson</p>
						<p class="text-sm leading-6 text-copy-secondary">Explore technical collaborations, experiments, and open-source work.</p>
					</div>
					<span class="text-2xl text-copy-muted transition duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-1 group-hover:text-secondary-200" aria-hidden="true">↗</span>
				</a>
			</div>
		</section>
		<section class="space-y-6 py-10 sm:py-12">
			@partials.SectionLabel("What I Bring")
			<h2 class="text-2xl font-semibold tracking-tight text-copy-primary sm:text-3xl">Expertise that delivers</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<div class="surface-card p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-700/70 bg-accent-950/70 text-3xl shadow-panel">☁️</div>
					<h3 class="text-lg font-semibold text-copy-primary">Cloud Architecture</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Design and deploy scalable cloud solutions on AWS and Azure with infrastructure as code.</p>
				</div>
				<div class="surface-card p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-700/70 bg-primary-950/70 text-3xl shadow-panel">🔄</div>
					<h3 class="text-lg font-semibold text-copy-primary">CI/CD Pipelines</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Build automated deployment workflows that ship reliable code faster and more safely.</p>
				</div>
				<div class="surface-card p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-700/70 bg-secondary-950/70 text-3xl shadow-panel">🔒</div>
					<h3 class="text-lg font-semibold text-copy-primary">Security First</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Embed security into every layer — from IAM policies to compliance automation.</p>
				</div>
				<div class="surface-card p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-700/70 bg-secondary-950/80 text-3xl shadow-panel">📈</div>
					<h3 class="text-lg font-semibold text-copy-primary">Growth Mindset</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Continuous learner who stays current with evolving cloud and DevOps best practices.</p>
				</div>
			</div>
		</section>
		<section class="py-10 sm:py-12">
			<div class="surface-card-strong overflow-hidden p-6 sm:p-8">
				<div class="flex flex-col gap-4 border-b border-carbon-black-700/80 pb-6 sm:flex-row sm:items-center sm:justify-between">
					<div class="flex items-center gap-3">
						<span class="h-3 w-3 rounded-full bg-accent-400 motion-safe:animate-pulse" aria-hidden="true"></span>
						<span class="text-base font-semibold text-accent-300 sm:text-lg">Currently available</span>
					</div>
					<span class="text-sm text-copy-secondary">⏱ Response within 24-48 hours</span>
				</div>
				<div class="grid gap-5 pt-6 md:grid-cols-3">
					<div class="space-y-1">
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-copy-muted">Looking for</span>
						<span class="block text-base font-semibold text-copy-primary">Full-time &amp; contract roles</span>
					</div>
					<div class="space-y-1">
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-copy-muted">Location</span>
						<span class="block text-base font-semibold text-copy-primary">Remote / Hybrid</span>
					</div>
					<div class="space-y-1">
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-copy-muted">Focus areas</span>
						<span class="block text-base font-semibold text-copy-primary">Cloud, DevOps, Platform Engineering</span>
					</div>
				</div>
			</div>
		</section>
		@partials.PageCTA(
			"Want to see my work first?",
			"Explore my projects and experience before reaching out",
			partials.CTALink{Href: "/projects", Label: "View Projects"},
			partials.CTALink{Href: "/experience", Label: "See Experience"},
		)
	}
}
