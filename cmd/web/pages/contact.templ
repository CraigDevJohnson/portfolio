package pages

import "portfolio/cmd/web/layouts"
import "portfolio/cmd/web/partials"

func contactExpertiseCards() []partials.FeatureCardProps {
	return []partials.FeatureCardProps{
		{Icon: "☁️", Title: "Cloud Architecture", Description: "Design and deploy scalable cloud solutions on AWS and Azure with infrastructure as code.", Tone: "accent"},
		{Icon: "🔄", Title: "CI/CD Pipelines", Description: "Build automated deployment workflows that ship reliable code faster and more safely.", Tone: "primary"},
		{Icon: "🔒", Title: "Security First", Description: "Embed security into every layer — from IAM policies to compliance automation.", Tone: "secondary"},
		{Icon: "📈", Title: "Growth Mindset", Description: "Continuous learner who stays current with evolving cloud and DevOps best practices.", Tone: "secondary"},
	}
}

func contactMethodCards() []partials.LinkPanelRowProps {
	return []partials.LinkPanelRowProps{
		{Href: "mailto:opportunity@craigdevjohnson.com", Title: "Email", Label: "opportunity@craigdevjohnson.com", Description: "Best for professional inquiries and new opportunities.", Icon: "✉️", Tone: "accent", AriaLabel: "Email opportunity@craigdevjohnson.com"},
		{Href: "https://linkedin.com/in/craigdevjohnson", Title: "LinkedIn", Label: "linkedin.com/in/craigdevjohnson", Description: "Connect for networking, platform engineering, and career conversations.", Icon: "💼", Tone: "primary", AriaLabel: "LinkedIn profile for Craig Johnson", External: true},
		{Href: "https://github.com/CraigDevJohnson", Title: "GitHub", Label: "github.com/CraigDevJohnson", Description: "Explore technical collaborations, experiments, and open-source work.", Icon: "🛠️", Tone: "secondary", AriaLabel: "GitHub profile for Craig Johnson", External: true},
	}
}

templ Contact() {
	@layouts.Base(layouts.BaseProps{
		Title: "Get in Touch - Craig Johnson",
		Page:  "contact",
	}) {
		<div class="page-kit-page">
		@partials.PageHero(partials.PageHeroProps{
			ImageURL:     "/static/images/backgrounds/contact-hero.jpg",
			ExtraClass:   "min-h-[16rem] sm:min-h-[18rem]",
			ContentClass: "flex min-h-full flex-col justify-center",
		}) {
			<div class="mx-auto flex max-w-3xl flex-col gap-5">
				<div class="page-kit-status-pill">
					<span class="page-kit-status-dot" aria-hidden="true"></span>
					Open to opportunities
				</div>
				<h1 class="page-hero-title">Get in Touch</h1>
				<p class="page-hero-description max-w-3xl">
					Whether it&apos;s cloud architecture, DevOps strategy, or your next big idea — let&apos;s connect and build something meaningful together.
				</p>
			</div>
		}
		<section class="page-section-tight">
			@partials.SectionLabel("Ways to Connect")
			<h2 class="page-section-title">Choose the easiest way to reach me</h2>
			<div class="grid gap-4">
				for _, card := range contactMethodCards() {
					@partials.LinkPanelRow(card)
				}
			</div>
		</section>
		<section class="page-section-tight">
			@partials.SectionLabel("What I Bring")
			<h2 class="page-section-title">Expertise that delivers</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				for _, card := range contactExpertiseCards() {
					@partials.FeatureCard(card)
				}
			</div>
		</section>
		<section class="page-section-tight pt-0">
			<div class="page-kit-panel-strong overflow-hidden p-6 sm:p-8">
				<div class="flex flex-col gap-4 border-b border-carbon-black-700/80 pb-6 sm:flex-row sm:items-center sm:justify-between">
					<div class="flex items-center gap-3">
						<span class="page-kit-status-dot motion-safe:animate-pulse" aria-hidden="true"></span>
						<span class="text-base font-semibold text-accent-300 sm:text-lg">Currently available</span>
					</div>
					<span class="text-sm text-copy-secondary">⏱ Response within 24-48 hours</span>
				</div>
				<div class="grid gap-5 pt-6 md:grid-cols-3">
					<div class="space-y-1">
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-copy-muted">Looking for</span>
						<span class="block text-base font-semibold text-copy-primary">Full-time &amp; contract roles</span>
					</div>
					<div class="space-y-1">
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-copy-muted">Location</span>
						<span class="block text-base font-semibold text-copy-primary">Remote / Hybrid</span>
					</div>
					<div class="space-y-1">
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-copy-muted">Focus areas</span>
						<span class="block text-base font-semibold text-copy-primary">Cloud, DevOps, Platform Engineering</span>
					</div>
				</div>
			</div>
		</section>
		@partials.PageCTA(
			"Want to see my work first?",
			"Explore my projects and experience before reaching out",
			partials.CTALink{Href: "/projects", Label: "View Projects"},
			partials.CTALink{Href: "/experience", Label: "See Experience"},
		)
		</div>
	}
}
