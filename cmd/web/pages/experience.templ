package pages

import (
	"portfolio/cmd/web/layouts"
	"portfolio/cmd/web/partials"
	"portfolio/types"
)

type ExperienceProps struct {
	Experiences []types.Experience
}

templ Experience(props ExperienceProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Career Journey - Craig Johnson",
		Page:  "experience",
	}) {
      <section class="page-hero relative isolate overflow-hidden [--page-hero-overlay-start:rgb(0_21_36_/_0.44)] [--page-hero-overlay-end:rgb(36_0_14_/_0.84)]" style="background-image:url('/static/images/backgrounds/experience-hero.jpg');">
      <div class="hero-header text-center">
				<h1>Career Journey</h1>
				<p class="lead">A decade of growth in system engineering, automation, and cloud technologies</p>
        <p class="mx-auto mt-2 max-w-[34rem] text-base leading-relaxed text-copy-muted">From service desk to principal cloud engineer — building, automating, and scaling enterprise infrastructure.</p>
			</div>
		</section>
    <section class="experience-summary pb-12">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div class="group flex flex-col items-center rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.24)_42%,rgba(255,0,98,0.08)_100%)] p-5 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/30 hover:shadow-panel-strong">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-400/22 bg-secondary-500/10 text-2xl shadow-[0_0_24px_rgba(255,166,0,0.18)] transition duration-200 group-hover:scale-105 group-hover:shadow-[0_0_28px_rgba(255,166,0,0.3)]">
            <span class="exp-icon" aria-hidden="true">🚀</span>
					</div>
            <span class="exp-stat-value mb-1 bg-[linear-gradient(135deg,#cceaff_0%,#33aaff_48%,#ffb833_100%)] bg-clip-text text-2xl font-extrabold text-transparent" data-counter data-target-year="2012">0</span>
          <span class="text-sm text-copy-muted">Years in Tech</span>
				</div>
          <div class="group flex flex-col items-center rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.24)_42%,rgba(255,0,98,0.08)_100%)] p-5 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/30 hover:shadow-panel-strong">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/22 bg-primary-500/10 text-2xl shadow-[0_0_24px_rgba(0,149,255,0.16)] transition duration-200 group-hover:scale-105 group-hover:shadow-[0_0_28px_rgba(0,149,255,0.28)]">
            <span class="exp-icon" aria-hidden="true">🏢</span>
					</div>
            <span class="exp-stat-value mb-1 bg-[linear-gradient(135deg,#cceaff_0%,#33aaff_48%,#ffb833_100%)] bg-clip-text text-2xl font-extrabold text-transparent" data-counter data-target="4">0</span>
          <span class="text-sm text-copy-muted">Companies</span>
				</div>
          <div class="group flex flex-col items-center rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.24)_42%,rgba(255,0,98,0.08)_100%)] p-5 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/30 hover:shadow-panel-strong">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-400/22 bg-secondary-500/10 text-2xl shadow-[0_0_24px_rgba(255,0,98,0.16)] transition duration-200 group-hover:scale-105 group-hover:shadow-[0_0_28px_rgba(255,0,98,0.28)]">
            <span class="exp-icon" aria-hidden="true">📋</span>
					</div>
            <span class="exp-stat-value mb-1 bg-[linear-gradient(135deg,#cceaff_0%,#33aaff_48%,#ffb833_100%)] bg-clip-text text-2xl font-extrabold text-transparent" data-counter data-target="7">0</span>
          <span class="text-sm text-copy-muted">Positions Held</span>
				</div>
          <div class="group flex flex-col items-center rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.24)_42%,rgba(255,0,98,0.08)_100%)] p-5 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/30 hover:shadow-panel-strong">
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/22 bg-primary-500/10 text-2xl shadow-[0_0_24px_rgba(0,149,255,0.16)] transition duration-200 group-hover:scale-105 group-hover:shadow-[0_0_28px_rgba(0,149,255,0.28)]">
            <span class="exp-icon" aria-hidden="true">☁️</span>
					</div>
            <span class="exp-stat-value mb-1 bg-[linear-gradient(135deg,#cceaff_0%,#33aaff_48%,#ffb833_100%)] bg-clip-text text-2xl font-extrabold text-transparent" data-counter data-target="3">0</span>
          <span class="text-sm text-copy-muted">Cloud Platforms</span>
				</div>
			</div>
		</section>
    <section class="pb-10">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Career Highlights</span>
			</div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div class="group rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.94)_0%,rgba(0,60,102,0.18)_48%,rgba(255,0,98,0.08)_100%)] p-6 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/28 hover:shadow-panel-strong">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-400/22 bg-secondary-500/10 text-2xl shadow-[0_0_24px_rgba(255,166,0,0.16)] transition duration-200 group-hover:scale-105">
            <span class="exp-icon" aria-hidden="true">🔧</span>
					</div>
          <h3 class="mb-2 text-base font-semibold text-copy-primary">Automation Pioneer</h3>
          <p class="text-sm leading-relaxed text-copy-muted">Built enterprise automation reducing manual work by 80% through PowerShell, Ansible, and Terraform.</p>
				</div>
          <div class="group rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.94)_0%,rgba(0,60,102,0.18)_48%,rgba(255,0,98,0.08)_100%)] p-6 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/28 hover:shadow-panel-strong">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/22 bg-primary-500/10 text-2xl shadow-[0_0_24px_rgba(0,149,255,0.16)] transition duration-200 group-hover:scale-105">
            <span class="exp-icon" aria-hidden="true">☁️</span>
					</div>
          <h3 class="mb-2 text-base font-semibold text-copy-primary">Cloud Migration Lead</h3>
          <p class="text-sm leading-relaxed text-copy-muted">Led infrastructure migrations across AWS and Azure, modernizing legacy systems for the cloud.</p>
				</div>
          <div class="group rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.94)_0%,rgba(0,60,102,0.18)_48%,rgba(255,0,98,0.08)_100%)] p-6 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/28 hover:shadow-panel-strong">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-400/22 bg-secondary-500/10 text-2xl shadow-[0_0_24px_rgba(255,0,98,0.16)] transition duration-200 group-hover:scale-105">
            <span class="exp-icon" aria-hidden="true">🛡️</span>
					</div>
          <h3 class="mb-2 text-base font-semibold text-copy-primary">Security Champion</h3>
          <p class="text-sm leading-relaxed text-copy-muted">Implemented compliance and security frameworks including zero-trust architecture and IAM policies.</p>
				</div>
          <div class="group rounded-2xl border border-white/8 bg-[linear-gradient(155deg,rgba(0,21,36,0.94)_0%,rgba(0,60,102,0.18)_48%,rgba(255,0,98,0.08)_100%)] p-6 text-center shadow-panel transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400/28 hover:shadow-panel-strong">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/22 bg-primary-500/10 text-2xl shadow-[0_0_24px_rgba(0,149,255,0.16)] transition duration-200 group-hover:scale-105">
            <span class="exp-icon" aria-hidden="true">📈</span>
					</div>
          <h3 class="mb-2 text-base font-semibold text-copy-primary">Scale Builder</h3>
          <p class="text-sm leading-relaxed text-copy-muted">Managed infrastructure supporting thousands of users with high availability and reliability.</p>
				</div>
			</div>
		</section>
    <section class="mb-12 rounded-[1.75rem] border border-white/10 bg-[linear-gradient(145deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.22)_52%,rgba(36,0,14,0.34)_100%)] px-6 py-8 shadow-panel sm:px-8 sm:py-10">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Refine Results</span>
			</div>
			<h2 class="sr-only">Refine Results</h2>
      <p class="max-w-[52rem] text-sm leading-relaxed text-copy-muted sm:text-base">Use the filters below to explore positions by role, technology, or skill area. Select multiple options to narrow your results.</p>
      <div class="filter-section mt-6 border-b border-white/10 pb-4" id="position-section">
        <h3 class="text-base font-semibold text-copy-primary">
					<button
						type="button"
            class="collapsible-button flex w-full items-center gap-3 rounded-xl px-2 py-2 text-left transition duration-150 ease-out hover:text-primary-100 focus-ring"
						aria-expanded="false"
						aria-controls="position-filters"
					>
						Filter by Position
            <span class="filter-count text-xs font-semibold text-secondary-300" id="position-count"></span>
            <span class="collapse-icon ml-auto -rotate-90 text-xs text-copy-muted transition-transform duration-150 ease-out" aria-hidden="true">▼</span>
					</button>
				</h3>
        <div class="filter-pills hidden flex-wrap gap-2 px-2 pt-3" id="position-filters">
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="Cloud Engineer Principal" type="button">
						Cloud Engineer Principal
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="System Administrator" type="button">
						System Administrator
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="IT Systems Engineer Sr" type="button">
						IT Systems Engineer Sr
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="IT Systems Engineer" type="button">
						IT Systems Engineer
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="IT Desktop Engineer" type="button">
						IT Desktop Engineer
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="IT Service Desk Associate" type="button">
						IT Service Desk Associate
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="position" data-value="Service Desk Student Analyst" type="button">
						Service Desk Student Analyst
					</button>
				</div>
			</div>
      <div class="filter-section border-b border-white/10 py-4" id="tech-section">
        <h3 class="text-base font-semibold text-copy-primary">
					<button
						type="button"
            class="collapsible-button flex w-full items-center gap-3 rounded-xl px-2 py-2 text-left transition duration-150 ease-out hover:text-primary-100 focus-ring"
						aria-expanded="false"
						aria-controls="tech-filters"
					>
						Filter by Technology
            <span class="filter-count text-xs font-semibold text-secondary-300" id="tech-count"></span>
            <span class="collapse-icon ml-auto -rotate-90 text-xs text-copy-muted transition-transform duration-150 ease-out" aria-hidden="true">▼</span>
					</button>
				</h3>
        <div class="filter-pills hidden flex-wrap gap-2 px-2 pt-3" id="tech-filters">
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="PowerShell" type="button">PowerShell</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Ansible" type="button">Ansible</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Terraform" type="button">Terraform</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="AWS" type="button">AWS</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Azure" type="button">Azure</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="AD DS" type="button">AD DS</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="RHEL" type="button">RHEL</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Bash" type="button">Bash</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Python" type="button">Python</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="O365/Exchange" type="button">
						O365/Exchange
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Docker" type="button">Docker</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="SCCM" type="button">SCCM</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="Intune" type="button">Intune</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="tech" data-value="ServiceNow" type="button">ServiceNow</button>
				</div>
			</div>
      <div class="filter-section pt-4" id="skill-section">
        <h3 class="text-base font-semibold text-copy-primary">
					<button
						type="button"
            class="collapsible-button flex w-full items-center gap-3 rounded-xl px-2 py-2 text-left transition duration-150 ease-out hover:text-primary-100 focus-ring"
						aria-expanded="false"
						aria-controls="skill-filters"
					>
						Filter by Skill Area
            <span class="filter-count text-xs font-semibold text-secondary-300" id="skill-count"></span>
            <span class="collapse-icon ml-auto -rotate-90 text-xs text-copy-muted transition-transform duration-150 ease-out" aria-hidden="true">▼</span>
					</button>
				</h3>
        <div class="filter-pills hidden flex-wrap gap-2 px-2 pt-3" id="skill-filters">
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="skill" data-value="cloud" type="button">
						Cloud Infrastructure
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="skill" data-value="automation" type="button">
						Automation & IaC
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="skill" data-value="systems" type="button">
						Systems Administration
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="skill" data-value="security" type="button">
						Security & Compliance
					</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="skill" data-value="devops" type="button">DevOps & CI/CD</button>
          <button class="filter-pill inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-medium tracking-[0.02em] text-copy-secondary transition duration-150 ease-out hover:-translate-y-0.5 hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" aria-pressed="false" data-filter="skill" data-value="scripting" type="button">
						Scripting & Programming
					</button>
				</div>
			</div>
      <div class="active-filters hidden flex-wrap items-center gap-3 border-t border-white/10 pt-5" id="active-filters">
        <span class="text-xs font-semibold uppercase tracking-[0.08em] text-copy-muted">Active Filters</span>
        <span class="active-filter-tags flex flex-wrap gap-2" id="active-filter-tags"></span>
        <button class="clear-filters-btn ml-auto inline-flex min-h-10 items-center rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-xs font-semibold uppercase tracking-[0.06em] text-copy-secondary transition duration-150 ease-out hover:border-primary-400/35 hover:bg-primary-500/10 hover:text-copy-primary focus-ring" id="clear-filters" type="button">Clear All</button>
			</div>
		</section>
    <section class="pb-12">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Career Timeline</span>
			</div>
			<section class="career-section">
				@partials.ExperienceTimeline(partials.ExperienceTimelineProps{Experiences: props.Experiences})
			</section>
		</section>
		<section class="page-cta-section">
			<div class="cta-glow" aria-hidden="true"></div>
			<h2>Want to see what I've built?</h2>
			<p class="cta-subtitle">Check out my projects or view my technical skills in detail</p>
			<div class="cta-buttons">
				<a href="/projects" class="btn btn-primary">
					<span>View Projects</span>
					<span class="btn-icon" aria-hidden="true">→</span>
				</a>
				<a href="/skills" class="btn btn-secondary">See Skills</a>
			</div>
		</section>
		<script>
  // Filter functionality with collapsible sections and multi-select
  document.addEventListener('DOMContentLoaded', function () {
    const filterPills = document.querySelectorAll('.filter-pill')
    const activeFiltersContainer = document.getElementById('active-filter-tags')
    const clearFiltersBtn = document.getElementById('clear-filters')
    const collapsibleButtons = document.querySelectorAll('.collapsible-button')
        const activeFiltersSection = document.getElementById('active-filters')

        const inactiveFilterPillClasses = [
          'border-white/10',
          'bg-white/[0.03]',
          'text-copy-secondary',
          'hover:border-primary-400/35',
          'hover:bg-primary-500/10',
          'hover:text-copy-primary',
        ]
        const activeFilterPillClasses = [
          'border-secondary-400',
          'bg-secondary-500',
          'text-primary-950',
          'shadow-lg',
          'hover:border-secondary-300',
          'hover:bg-secondary-400',
          'hover:text-primary-950',
        ]
        const highlightedCardClasses = [
          'ring-2',
          'ring-primary-400/45',
          'border-primary-300/55',
          'shadow-panel-strong',
        ]

    // Track active filters - now arrays for multi-select
    let activeFilters = {
      position: [],
      tech: [],
      skill: [],
    }

    // Skill labels for display
    const skillLabels = {
      cloud: 'Cloud Infrastructure',
      automation: 'Automation & IaC',
      systems: 'Systems Admin',
      security: 'Security',
      devops: 'DevOps',
      scripting: 'Scripting',
    }

    function setFilterPillState(pill, isActive) {
      pill.classList.toggle('active', isActive)
      pill.setAttribute('aria-pressed', isActive ? 'true' : 'false')

      inactiveFilterPillClasses.forEach(className => {
        pill.classList.toggle(className, !isActive)
      })
      activeFilterPillClasses.forEach(className => {
        pill.classList.toggle(className, isActive)
      })
    }

    function setCollapsibleState(button, expanded) {
      const targetId = button.getAttribute('aria-controls')
      const target = targetId ? document.getElementById(targetId) : null
      const icon = button.querySelector('.collapse-icon')

      button.setAttribute('aria-expanded', expanded ? 'true' : 'false')
      if (target) {
        target.classList.toggle('hidden', !expanded)
      }
      if (icon) {
        icon.classList.toggle('-rotate-90', !expanded)
      }
    }

    function setCardHighlight(card, isHighlighted) {
      highlightedCardClasses.forEach(className => {
        card.classList.toggle(className, isHighlighted)
      })
    }

    // Collapsible section handlers
    collapsibleButtons.forEach(button => {
      setCollapsibleState(button, false)
      button.addEventListener('click', function () {
        const isExpanded = this.getAttribute('aria-expanded') === 'true'
        setCollapsibleState(this, !isExpanded)
      })
    })

    // Filter pill click handlers - toggle behavior with multi-select
    filterPills.forEach(pill => {
      setFilterPillState(pill, pill.classList.contains('active'))
      pill.addEventListener('click', function () {
        const filterType = this.dataset.filter
        const filterValue = this.dataset.value
        const isActive = this.classList.contains('active')

        // Toggle active state for this pill
        if (isActive) {
          // Un-select this filter
          const index = activeFilters[filterType].indexOf(filterValue)
          if (index > -1) {
            activeFilters[filterType].splice(index, 1)
          }
        } else {
          // Select this filter (add to existing selections)
          if (!activeFilters[filterType].includes(filterValue)) {
            activeFilters[filterType].push(filterValue)
          }
        }

        setFilterPillState(this, !isActive)

        // Apply filters to cards
        applyFilters()

        // Update active filters display and counts
        updateActiveFiltersDisplay()
        updateFilterCounts()
      })
    })

    // Clear all filters
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', function () {
        activeFilters = {position: [], tech: [], skill: []}

        // Reset all filter pills
        document.querySelectorAll('.filter-pill').forEach(pill => {
          setFilterPillState(pill, false)
        })

        applyFilters()
        updateActiveFiltersDisplay()
        updateFilterCounts()
      })
    }

    function applyFilters() {
      const cards = document.querySelectorAll('.career-card')
      const noResults = document.getElementById('no-results')
      const hasPositionFilters = activeFilters.position.length > 0
      const hasTechFilters = activeFilters.tech.length > 0
      const hasSkillFilters = activeFilters.skill.length > 0
      const hasAnyFilters = hasPositionFilters || hasTechFilters || hasSkillFilters
      let visibleCount = 0

      cards.forEach(card => {
        let showCard = true
        let highlightCard = false

        const cardPosition = card.dataset.position || ''
        const cardTechs = (card.dataset.technologies || '')
          .split(',')
          .map(t => t.trim())
          .filter(t => t)
        const cardSkills = (card.dataset.skills || '')
          .split(',')
          .map(s => s.trim())
          .filter(s => s)

        // Check position filters (OR logic - show card if position matches any selected)
        if (hasPositionFilters) {
          if (!activeFilters.position.includes(cardPosition)) {
            showCard = false
          } else {
            highlightCard = true
          }
        }

        // Check technology filters (AND within category, must match ALL selected)
        if (hasTechFilters && showCard) {
          const hasAllTechs = activeFilters.tech.every(tech => cardTechs.includes(tech))
          if (!hasAllTechs) {
            showCard = false
          } else {
            highlightCard = true
          }
        }

        // Check skill area filters (AND within category, must match ALL selected)
        if (hasSkillFilters && showCard) {
          const hasAllSkills = activeFilters.skill.every(skill => cardSkills.includes(skill))
          if (!hasAllSkills) {
            showCard = false
          } else {
            highlightCard = true
          }
        }

        // Apply visibility and highlight
        if (showCard) {
          visibleCount += 1
          card.classList.remove('hidden')
          setCardHighlight(card, highlightCard && hasAnyFilters)
          card.style.opacity = '1'
          card.style.transform = ''
        } else {
          card.classList.add('hidden')
          setCardHighlight(card, false)
        }
      })

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0)
      }

      // Animate visible cards
      requestAnimationFrame(() => {
        const visibleCards = document.querySelectorAll('.career-card:not(.hidden)')
        visibleCards.forEach((card, index) => {
          card.style.animationDelay = `${index * 50}ms`
        })
      })
    }

    function updateActiveFiltersDisplay() {
      if (!activeFiltersContainer) {
        return
      }

      const tags = []

      activeFilters.position.forEach(pos => {
        tags.push({type: 'position', value: pos, label: pos})
      })
      activeFilters.tech.forEach(tech => {
        tags.push({type: 'tech', value: tech, label: tech})
      })
      activeFilters.skill.forEach(skill => {
        tags.push({type: 'skill', value: skill, label: skillLabels[skill] || skill})
      })

      activeFiltersContainer.innerHTML = tags
        .map(
          tag =>
            `<span class="active-filter-tag inline-flex items-center gap-2 rounded-full border border-primary-400/25 bg-primary-500/12 px-3 py-1 text-xs font-medium text-primary-100" data-type="${tag.type}">
        ${tag.label}
        <button class="remove-filter inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary-200/15 text-[0.65rem] leading-none text-primary-50 transition hover:bg-primary-200/25" type="button" data-type="${tag.type}" data-value="${tag.value}" aria-label="Remove ${tag.label} filter">&times;</button>
      </span>`
        )
        .join('')

      // Show/hide the active filters section
      if (activeFiltersSection) {
        activeFiltersSection.classList.toggle('hidden', tags.length === 0)
      }

      // Add remove handlers
      document.querySelectorAll('.remove-filter').forEach(btn => {
        btn.addEventListener('click', function (e) {
          e.stopPropagation()
          const type = this.dataset.type
          const value = this.dataset.value

          // Remove this specific filter
          const index = activeFilters[type].indexOf(value)
          if (index > -1) {
            activeFilters[type].splice(index, 1)
          }

          // Update the corresponding filter pill
          const group = document.getElementById(type + '-filters')
          if (group) {
            const pill = group.querySelector(`.filter-pill[data-value="${value}"]`)
            if (pill) {
              setFilterPillState(pill, false)
            }
          }

          applyFilters()
          updateActiveFiltersDisplay()
          updateFilterCounts()
        })
      })
    }

    function updateFilterCounts() {
      const posCount = document.getElementById('position-count')
      const techCount = document.getElementById('tech-count')
      const skillCount = document.getElementById('skill-count')

      if (posCount) {
        posCount.textContent =
          activeFilters.position.length > 0 ? `(${activeFilters.position.length})` : ''
      }
      if (techCount) {
        techCount.textContent =
          activeFilters.tech.length > 0 ? `(${activeFilters.tech.length})` : ''
      }
      if (skillCount) {
        skillCount.textContent =
          activeFilters.skill.length > 0 ? `(${activeFilters.skill.length})` : ''
      }
    }

    // Hide active filters section initially (no filters selected)
    if (activeFiltersSection) {
      activeFiltersSection.classList.add('hidden')
    }

    updateFilterCounts()
  })
</script>
	}
}
