package pages

import "portfolio/cmd/web/layouts"
import "portfolio/cmd/web/partials"

type SkillsProps struct {
	Grid partials.SkillsGridProps
}

templ Skills(props SkillsProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Technical Proficiencies - Craig Johnson",
		Page:  "skills",
	}) {
		<div class="page-kit-page skills-page" data-layout="skills-workbench">
			@partials.PageHero(partials.PageHeroProps{
				ImageURL:      "/static/images/backgrounds/skills-hero.jpg",
				ImagePosition: "center 30%",
				Caption:       "Tools in service of systems",
				Variant:       partials.HeroCatalog,
			}) {
				@partials.PageHeroIntro(partials.PageHeroIntroProps{Eyebrow: "Skills", Title: "Cloud & Platform Toolkit"}) {
					<p class="page-hero-description">Tools, platforms, and operating practices I use to build and improve production infrastructure.</p>
				}
			}
			<section class="page-section skills-toolkit-section">
				@partials.SkillsGrid(props.Grid)
			</section>
			@partials.PageCTA(partials.PageCTAProps{
				Title:     "Interested in my expertise?",
				Subtitle:  "View my projects or get in touch to discuss how I can help with your infrastructure needs.",
				Primary:   partials.ActionLinkProps{Href: "/projects", Label: "View Projects", Variant: partials.ActionPrimary},
				Secondary: &partials.ActionLinkProps{Href: "/contact", Label: "Contact Me", Variant: partials.ActionSecondary},
			})
		</div>
	}
}
