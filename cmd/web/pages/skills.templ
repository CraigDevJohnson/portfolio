package pages

import "portfolio/cmd/web/layouts"
import "portfolio/cmd/web/partials"

templ Skills() {
	@layouts.Base(layouts.BaseProps{
		Title: "Technical Proficiencies - Craig Johnson",
		Page:  "skills",
	}) {
		<section class="relative isolate mb-6 grid min-h-[clamp(18rem,42vw,28rem)] place-items-center overflow-hidden rounded-[2rem] border border-carbon-black-800 bg-carbon-black-950 bg-[url('/static/images/backgrounds/skills-hero.jpg')] bg-cover bg-[center_30%] px-6 pb-12 pt-[calc(var(--header-height)+3rem)] text-center shadow-panel-strong sm:px-8 lg:px-12 lg:pt-[calc(var(--header-height)+4rem)]">
			<div class="absolute inset-0 bg-linear-to-b from-primary-950/50 to-secondary-950/85"></div>
			<div class="relative z-10 mx-auto w-[min(44rem,100%)]">
				<h1 class="mb-4 bg-[linear-gradient(135deg,var(--color-primary-100)_0%,var(--color-primary-300)_40%,var(--color-accent-300)_100%)] bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl">Technical Proficiencies</h1>
				<p class="mx-auto max-w-[38rem] text-base leading-7 text-copy-muted sm:text-xl sm:leading-8">A comprehensive toolkit for cloud infrastructure, automation, and security.</p>
			</div>
		</section>
		<section class="mt-8" hx-get="/skills/grid" hx-trigger="revealed" hx-swap="innerHTML">
			<div class="mx-auto flex max-w-[var(--container-site)] flex-col gap-10">
				<!-- Featured skeleton -->
				<div class="pointer-events-none rounded-[1.75rem] border border-primary-500/18 bg-[linear-gradient(145deg,rgba(0,21,36,0.96)_0%,rgba(0,60,102,0.74)_46%,rgba(255,0,98,0.16)_100%)] px-6 py-8 shadow-panel sm:px-8 sm:py-10">
					<div class="mb-8 text-center">
						<div class="skeleton mx-auto mb-3 h-7 w-56"></div>
						<div class="skeleton mx-auto h-4 w-72 max-w-full"></div>
					</div>
					<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
						for j := 1; j <= 8; j++ {
							<div class="skeleton h-56 rounded-2xl"></div>
						}
					</div>
				</div>
				<!-- Concepts skeleton -->
				<div class="pointer-events-none rounded-[1.75rem] border border-secondary-500/18 bg-[linear-gradient(145deg,rgba(0,21,36,0.94)_0%,rgba(0,30,51,0.62)_44%,rgba(36,0,14,0.36)_100%)] px-6 py-8 shadow-panel sm:px-8 sm:py-10">
					<div class="mb-8 text-center">
						<div class="skeleton mx-auto h-7 w-52"></div>
					</div>
					<div class="grid gap-3 lg:grid-cols-2 xl:grid-cols-3">
						for j := 1; j <= 6; j++ {
							<div class="skeleton h-[5.5rem] rounded-2xl"></div>
						}
					</div>
				</div>
				<!-- All skills bar skeleton -->
				<div class="skeleton h-28 rounded-2xl"></div>
				<!-- Category skeletons -->
				for i := 1; i <= 3; i++ {
					<div class="pointer-events-none rounded-2xl border border-white/8 bg-black/10 p-4 sm:p-5">
						<div class="skeleton mb-4 h-5 w-44"></div>
						<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
							for j := 1; j <= 8; j++ {
								<div class="skeleton h-36 rounded-2xl"></div>
							}
						</div>
					</div>
				}
			</div>
		</section>
		@partials.PageCTA(
			"Interested in my expertise?",
			"View my projects or get in touch to discuss how I can help with your infrastructure needs.",
			partials.CTALink{Href: "/projects", Label: "View Projects"},
			partials.CTALink{Href: "/contact", Label: "Contact Me"},
		)
	}
}
