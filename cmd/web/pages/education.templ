package pages

import (
	"fmt"
	"portfolio/cmd/web/layouts"
	"portfolio/cmd/web/partials"
)

type EducationProps struct {
	TotalCerts      int
	Providers       int
	YearsCertifying int
}

func educationStatCards(props EducationProps) []partials.StatCardProps {
	return []partials.StatCardProps{
		{Value: "1", Label: "Degree", AriaLabel: "1 degree", ExtraClass: "stagger-enter"},
		{Value: fmt.Sprintf("%d", props.TotalCerts), Label: "Certifications", AriaLabel: fmt.Sprintf("%d certifications", props.TotalCerts), ExtraClass: "stagger-enter"},
		{Value: fmt.Sprintf("%d", props.Providers), Label: "Providers", AriaLabel: fmt.Sprintf("%d providers", props.Providers), ExtraClass: "stagger-enter"},
		{Value: fmt.Sprintf("%d", props.YearsCertifying), Label: "Years Certifying", AriaLabel: fmt.Sprintf("%d years certifying", props.YearsCertifying), ExtraClass: "stagger-enter"},
	}
}

func educationCredentialCards() []partials.CredentialCardProps {
	return []partials.CredentialCardProps{
		{Href: "https://www.credly.com/badges/c35d4426-9abe-4965-9eb2-9599498e1b5e/", ImageSrc: "/static/images/certs/awscloudpract.png", ImageAlt: "AWS Certified Cloud Practitioner", Title: "AWS Certified Cloud Practitioner", Provider: "Amazon Web Services", Year: "2023", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/8bbdc1c8-71d9-4764-b47f-b9f66de1b103", ImageSrc: "/static/images/certs/azure.png", ImageAlt: "Microsoft Certified: Azure Fundamentals", Title: "Microsoft Certified: Azure Fundamentals", Provider: "Microsoft", Year: "2020", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/c5406a0d-c4d2-41f7-b897-e12c01182f9f", ImageSrc: "/static/images/certs/MCSE-Cloud-Platform-Infrastructure-2018.png", ImageAlt: "MCSE: Cloud Platform and Infrastructure", Title: "MCSE: Cloud Platform and Infrastructure", Provider: "Microsoft", Year: "2018", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/c2187483-a746-4268-be1a-ea0e5b9281a1", ImageSrc: "/static/images/certs/MCSA-Windows-Server-2016-2018.png", ImageAlt: "MCSA: Windows Server 2016", Title: "MCSA: Windows Server 2016", Provider: "Microsoft", Year: "2018", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/f8416144-c1cb-4388-bc53-8f622fc7e302", ImageSrc: "/static/images/certs/lpi.png", ImageAlt: "Linux Essentials Certificate", Title: "Linux Essentials Certificate", Provider: "Linux Professional Institute", Year: "2021", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/72ce956a-0c40-485b-8af6-52f7d8652c71", ImageSrc: "/static/images/certs/CompTIA_Cloud_2Bce.png", ImageAlt: "CompTIA Cloud+ ce Certification", Title: "CompTIA Cloud+ ce", Provider: "CompTIA", Year: "2023", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/276cd921-2315-4136-ae6a-342b477ab6d5", ImageSrc: "/static/images/certs/CompTIA_Security_2Bce.png", ImageAlt: "CompTIA Security+ ce Certification", Title: "CompTIA Security+ ce", Provider: "CompTIA", Year: "2022", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/4eca7af7-c7e3-4ad5-ad95-b90379c33e52", ImageSrc: "/static/images/certs/CompTIA_Network_2Bce.png", ImageAlt: "CompTIA Network+ ce Certification", Title: "CompTIA Network+ ce", Provider: "CompTIA", Year: "2021", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/a3c22ccb-3e16-4564-af65-c540ae38e99d", ImageSrc: "/static/images/certs/CompTIA_Project_2B.png", ImageAlt: "CompTIA Project+ Certification", Title: "CompTIA Project+", Provider: "CompTIA", Year: "2022", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
		{Href: "https://www.credly.com/badges/b4c88402-4ce7-4d98-a6dd-d0a468d4ac15", ImageSrc: "/static/images/certs/CompTIA_A_2Bce.png", ImageAlt: "CompTIA A+ ce Certification", Title: "CompTIA A+ ce", Provider: "CompTIA", Year: "2021", Loading: "eager", External: true, ExtraClass: "stagger-enter hover:border-primary-400"},
	}
}

templ Education(props EducationProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Education & Certifications - Craig Johnson",
		Page:  "education",
	}) {
		<div class="page-kit-page">
		@partials.PageHero(partials.PageHeroProps{
			ImageURL:     "/static/images/backgrounds/education-hero.jpg",
			ExtraClass:   "min-h-[16rem] sm:min-h-[18rem]",
			ContentClass: "flex min-h-full flex-col justify-center",
		}) {
			<div class="flex max-w-3xl flex-col gap-5">
				<p class="page-kit-eyebrow">Education</p>
				<h1 class="page-hero-title">Education &amp; Certifications</h1>
				<p class="page-hero-description max-w-3xl">
					Academic foundation and professional certifications powering a career in cloud technology
				</p>
			</div>
		}
		<!-- Stats -->
		<section class="page-stats-section">
			@partials.StatCardGrid(partials.StatCardGridProps{Cards: educationStatCards(props)})
		</section>
		<!-- Featured Degree -->
		<section class="page-section">
			@partials.SectionLabel("Academic Foundation")
			<a
				href="https://www.wgu.edu/online-it-degrees/cloud-computing-bachelors-program.html"
				target="_blank"
				rel="noopener noreferrer"
				class="page-kit-panel-strong group grid gap-6 overflow-hidden p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-accent-400 hover:shadow-panel-strong lg:grid-cols-[12rem_minmax(0,1fr)_auto] lg:items-center"
			>
				<div class="flex justify-center">
					<img
						src="/static/images/edu/wgu.png"
						alt="Western Governor University"
						loading="lazy"
						class="h-40 w-40 rounded-3xl border border-carbon-black-700 bg-carbon-black-950/60 object-contain p-4 shadow-panel"
						width="200"
						height="200"
					/>
				</div>
				<div class="space-y-3">
					<div class="page-kit-chip gap-2 px-4 py-2 text-sm">🎓 Bachelor&apos;s Degree</div>
					<h2 class="text-2xl font-bold tracking-tight text-copy-primary">Bachelor of Science</h2>
					<h3 class="text-xl font-semibold text-primary-200">Cloud Computing</h3>
					<p class="text-base font-medium text-copy-secondary">Western Governor University</p>
					<p class="text-sm uppercase tracking-[0.2em] text-copy-muted">Completed 2023</p>
					<p class="text-base leading-7 text-copy-secondary">
						Competency-based program covering cloud architecture, security, networking, and systems administration across AWS and Azure platforms.
					</p>
				</div>
				<span class="hidden text-3xl text-accent-300 transition duration-200 group-hover:translate-x-1 lg:inline" aria-hidden="true">↗</span>
			</a>
		</section>
		<!-- Certifications Grid -->
		<section class="page-section">
			@partials.SectionLabel("Professional Certifications")
			<h2 class="page-section-title">Industry Recognized Credentials</h2>
			<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
				for _, credential := range educationCredentialCards() {
					@partials.CredentialCard(credential)
				}
			</div>
		</section>
		@partials.PageCTA(
			"See how education translates to experience",
			"Explore how these credentials are applied in real-world cloud engineering",
			partials.CTALink{Href: "/experience", Label: "View Experience"},
			partials.CTALink{Href: "/skills", Label: "View Skills"},
		)
		</div>
	}
}
