			</div>
			<h2 class="text-3xl font-bold tracking-tight text-copy-primary">Industry Recognized Credentials</h2>
			<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
				<a
					href="https://www.credly.com/badges/c35d4426-9abe-4965-9eb2-9599498e1b5e/"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card stagger-enter group flex h-full flex-col items-center gap-4 p-6 text-center text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong"
				>
					<div class="flex h-44 w-full items-center justify-center rounded-2xl border border-carbon-black-700 bg-carbon-black-950/65 p-4 shadow-panel">
						<img
							src="/static/images/certs/awscloudpract.png"
							alt="AWS Certified Cloud Practitioner"
							loading="lazy"
							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">AWS Certified Cloud Practitioner</h3>
						<p class="text-sm font-medium text-copy-secondary">Amazon Web Services</p>
						<span class="mt-1 inline-flex rounded-full border border-accent-700/70 bg-accent-950/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-200">2023</span>
					</div>
				</a>
				<a
					href="https://www.credly.com/badges/8bbdc1c8-71d9-4764-b47f-b9f66de1b103"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card stagger-enter group flex h-full flex-col items-center gap-4 p-6 text-center text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong"
				>
					<div class="flex h-44 w-full items-center justify-center rounded-2xl border border-carbon-black-700 bg-carbon-black-950/65 p-4 shadow-panel">
						<img
							src="/static/images/certs/azure.png"
							alt="Microsoft Certified: Azure Fundamentals"
							loading="lazy"
							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">Microsoft Certified: Azure Fundamentals</h3>
						<p class="text-sm font-medium text-copy-secondary">Microsoft</p>
						<span class="mt-1 inline-flex rounded-full border border-accent-700/70 bg-accent-950/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-200">2020</span>
					</div>
				</a>
				<a
					href="https://www.credly.com/badges/c5406a0d-c4d2-41f7-b897-e12c01182f9f"
