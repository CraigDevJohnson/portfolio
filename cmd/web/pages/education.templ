				>
					<div class="flex h-44 w-full items-center justify-center rounded-2xl border border-carbon-black-700 bg-carbon-black-950/65 p-4 shadow-panel">
						<img
							src="/static/images/certs/CompTIA_Cloud_2Bce.png"
							alt="CompTIA Cloud+ ce Certification"
							loading="lazy"
							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">CompTIA Cloud+ ce</h3>
						<p class="text-sm font-medium text-copy-secondary">CompTIA</p>
						<span class="mt-1 inline-flex rounded-full border border-accent-700/70 bg-accent-950/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-200">2023</span>
					</div>
				</a>
				<a
					href="https://www.credly.com/badges/276cd921-2315-4136-ae6a-342b477ab6d5"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card stagger-enter group flex h-full flex-col items-center gap-4 p-6 text-center text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong"
				>
					<div class="flex h-44 w-full items-center justify-center rounded-2xl border border-carbon-black-700 bg-carbon-black-950/65 p-4 shadow-panel">
						<img
							src="/static/images/certs/CompTIA_Security_2Bce.png"
							alt="CompTIA Security+ ce Certification"
							loading="lazy"
							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">CompTIA Security+ ce</h3>
						<p class="text-sm font-medium text-copy-secondary">CompTIA</p>
						<span class="mt-1 inline-flex rounded-full border border-accent-700/70 bg-accent-950/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-200">2022</span>
					</div>
				</a>
				<a
					href="https://www.credly.com/badges/4eca7af7-c7e3-4ad5-ad95-b90379c33e52"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card stagger-enter group flex h-full flex-col items-center gap-4 p-6 text-center text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong"
				>
					<div class="flex h-44 w-full items-center justify-center rounded-2xl border border-carbon-black-700 bg-carbon-black-950/65 p-4 shadow-panel">
						<img
							src="/static/images/certs/CompTIA_Network_2Bce.png"
							alt="CompTIA Network+ ce Certification"
							loading="lazy"
							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">CompTIA Network+ ce</h3>
						<p class="text-sm font-medium text-copy-secondary">CompTIA</p>
						<span class="mt-1 inline-flex rounded-full border border-accent-700/70 bg-accent-950/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-200">2021</span>
					</div>
				</a>
				<a
					href="https://www.credly.com/badges/a3c22ccb-3e16-4564-af65-c540ae38e99d"
					target="_blank"
					rel="noopener noreferrer"
					class="surface-card stagger-enter group flex h-full flex-col items-center gap-4 p-6 text-center text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong"
				>
					<div class="flex h-44 w-full items-center justify-center rounded-2xl border border-carbon-black-700 bg-carbon-black-950/65 p-4 shadow-panel">
						<img
							src="/static/images/certs/CompTIA_Project_2B.png"
							alt="CompTIA Project+ Certification"
							loading="lazy"
							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">CompTIA Project+</h3>
						<p class="text-sm font-medium text-copy-secondary">CompTIA</p>
