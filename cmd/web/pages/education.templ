package pages

import (
	"portfolio/cmd/web/layouts"
	"fmt"
)

type EducationProps struct {
	TotalCerts    int
	Providers     int
	YearsCertifying int
}

templ Education(props EducationProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Education & Certifications - Craig Johnson",
		Page:  "education",
	}) {
		<section
			class="relative isolate overflow-hidden rounded-[2rem] border border-carbon-black-800 bg-carbon-black-950 bg-cover bg-center px-6 py-14 shadow-panel-strong sm:px-8 lg:px-12 lg:py-20"
			style="background-image: url('/static/images/backgrounds/education-hero.jpg')"
		>
			<div class="absolute inset-0 bg-linear-to-br from-carbon-black-950/92 via-carbon-black-950/76 to-secondary-950/70"></div>
			<div class="relative max-w-3xl space-y-5">
				<h1 class="text-4xl font-bold tracking-tight text-copy-primary sm:text-5xl">Education &amp; Certifications</h1>
				<p class="max-w-3xl text-base leading-7 text-copy-secondary sm:text-lg sm:leading-8">
					Academic foundation and professional certifications powering a career in cloud technology
				</p>
			</div>
		</section>
		<!-- Stats -->
		<section class="edu-stats py-10 sm:py-12">
			<div class="stats-grid grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
				<div class="surface-card stagger-enter px-5 py-6 text-center">
					<span class="edu-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target="1" aria-label="1 degree">0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Degree</span>
				</div>
				<div class="surface-card stagger-enter px-5 py-6 text-center">
					<span class="edu-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ fmt.Sprintf("%d", props.TotalCerts) } aria-label={ fmt.Sprintf("%d certifications", props.TotalCerts) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Certifications</span>
				</div>
				<div class="surface-card stagger-enter px-5 py-6 text-center">
					<span class="edu-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ fmt.Sprintf("%d", props.Providers) } aria-label={ fmt.Sprintf("%d providers", props.Providers) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Providers</span>
				</div>
				<div class="surface-card stagger-enter px-5 py-6 text-center">
					<span class="edu-stat-value text-gradient-brand block text-4xl font-extrabold" data-counter data-target={ fmt.Sprintf("%d", props.YearsCertifying) } aria-label={ fmt.Sprintf("%d years certifying", props.YearsCertifying) }>0</span>
					<span class="mt-2 block text-sm font-medium text-copy-muted">Years Certifying</span>
				</div>
			</div>
		</section>
		<!-- Featured Degree -->
		<section class="space-y-6 py-12 sm:py-14">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Academic Foundation</span>
			</div>
			<a
				href="https://www.wgu.edu/online-it-degrees/cloud-computing-bachelors-program.html"
				target="_blank"
				rel="noopener noreferrer"
				class="surface-card-strong group grid gap-6 overflow-hidden p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-accent-400 hover:shadow-panel-strong lg:grid-cols-[12rem_minmax(0,1fr)_auto] lg:items-center"
			>
				<div class="flex justify-center">
					<img
						src="/static/images/edu/wgu.png"
						alt="Western Governor University"
						loading="lazy"
						class="h-40 w-40 rounded-3xl border border-carbon-black-700 bg-carbon-black-950/60 object-contain p-4 shadow-panel"
						width="200"
						height="200"
					/>
				</div>
				<div class="space-y-3">
					<div class="inline-flex items-center gap-2 rounded-full border border-accent-700/70 bg-accent-950/70 px-4 py-2 text-sm font-semibold text-accent-200 shadow-panel">🎓 Bachelor&apos;s Degree</div>
					<h2 class="text-2xl font-bold tracking-tight text-copy-primary">Bachelor of Science</h2>
					<h3 class="text-xl font-semibold text-primary-200">Cloud Computing</h3>
					<p class="text-base font-medium text-copy-secondary">Western Governor University</p>
					<p class="text-sm uppercase tracking-[0.2em] text-copy-muted">Completed 2023</p>
					<p class="text-base leading-7 text-copy-secondary">
						Competency-based program covering cloud architecture, security, networking, and systems administration across AWS and Azure platforms.
					</p>
				</div>
				<span class="hidden text-3xl text-accent-300 transition duration-200 group-hover:translate-x-1 lg:inline" aria-hidden="true">↗</span>
			</a>
		</section>
