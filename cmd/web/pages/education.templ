							class="h-32 w-32 object-contain"
							width="200"
							height="200"
						/>
					</div>
					<div class="flex flex-1 flex-col items-center gap-2">
						<h3 class="text-lg font-semibold text-copy-primary">MCSA: Windows Server 2016</h3>
						<p class="text-sm font-medium text-copy-secondary">Microsoft</p>
						<span class="mt-1 inline-flex rounded-full border border-accent-700/70 bg-accent-950/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent-200">2018</span>
					</div>
				</a>
				<a
					href="https://www.credly.com/badges/f8416144-c1cb-4388-bc53-8f622fc7e302"
