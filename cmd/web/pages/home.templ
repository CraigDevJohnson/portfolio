package pages

import (
	"fmt"
	"portfolio/cmd/web/layouts"
	"portfolio/cmd/web/partials"
)

type HomeProps struct {
	Name               string
	Role               string
	AvatarURL          string
	Description        string
	YearsInTech        int
	Certifications     int
	AutomationProjects string
}

func homeFeatureCards() []partials.FeatureCardProps {
	return []partials.FeatureCardProps{
		{IconName: partials.UIIconArchitecture, Title: "Cloud Architecture", Description: "Designing secure, scalable infrastructure across AWS and Azure.", Tone: partials.ToneMint, ExtraClass: "home-capability-card home-capability-cloud stagger-enter"},
		{IconName: partials.UIIconInfrastructure, Title: "Infrastructure as Code", Description: "Turning environments into repeatable, reviewable systems with Terraform, CloudFormation, and Ansible.", Tone: partials.ToneApricot, ExtraClass: "home-capability-card home-capability-infrastructure stagger-enter"},
		{IconName: partials.UIIconAutomation, Title: "Delivery Automation", Description: "Building delivery pipelines with GitHub Actions and GitOps practices that teams can trust.", Tone: partials.ToneRose, ExtraClass: "home-capability-card home-capability-delivery stagger-enter"},
		{IconName: partials.UIIconSecurity, Title: "Security & Operations", Description: "Embedding identity, observability, and compliance into the platform instead of bolting them on later.", Tone: partials.ToneMint, ExtraClass: "home-capability-card home-capability-operations stagger-enter"},
	}
}

func homeStatCards(props HomeProps) []partials.StatCardProps {
	return []partials.StatCardProps{
		{Value: fmt.Sprintf("%d", props.YearsInTech), Label: "Years Experience", AriaLabel: fmt.Sprintf("%d plus years experience", props.YearsInTech), Suffix: "+", ExtraClass: "home-stat home-stat-years stagger-enter", ValueClass: "home-stat-value", LabelClass: "home-stat-label"},
		{Value: fmt.Sprintf("%d", props.Certifications), Label: "Certifications", AriaLabel: fmt.Sprintf("%d plus certifications", props.Certifications), Suffix: "+", ExtraClass: "home-stat home-stat-certifications stagger-enter", ValueClass: "home-stat-value", LabelClass: "home-stat-label"},
		{Value: props.AutomationProjects, Label: "Automation Projects", AriaLabel: fmt.Sprintf("%s plus automation projects", props.AutomationProjects), Suffix: "+", ExtraClass: "home-stat home-stat-automation stagger-enter", ValueClass: "home-stat-value", LabelClass: "home-stat-label"},
	}
}

templ Home(props HomeProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Craig Johnson - Cloud Engineer Principal",
		Page:  "home",
	}) {
		<div class="page-kit-page home-page" data-layout="systems-overlook">
			<section class="home-overlook-hero" aria-label="Craig Johnson introduction">
				<figure class="home-build-portal" data-region="photo">
					<div class="home-build-portal-visual" aria-hidden="true">
						<img src="/static/images/backgrounds/home-hero.jpg" alt="" class="home-build-environment" width="1920" height="1280" loading="eager"/>
						<span class="home-build-portal-shade"></span>
					</div>
					<figcaption class="home-build-caption">A warm place to build</figcaption>
					<a
						href="https://gravatar.com/craigdevjohnson1"
						target="_blank"
						rel="noopener noreferrer"
						class="home-portrait-link focus-ring"
						aria-label="View Craig Johnson's Gravatar profile (opens in new tab)"
					>
						<span class="home-portrait-visual">
							<span class="home-portrait-fallback" data-image-fallback aria-hidden="true">CJ</span>
							<img
								src={ props.AvatarURL }
								alt={ props.Name }
								class="home-portrait-image"
								width="275"
								height="275"
								loading="eager"
								data-remote-image
							/>
						</span>
					</a>
				</figure>
				<div class="home-overlook-intro" data-region="intro">
					@partials.PageHeroIntro(partials.PageHeroIntroProps{
						Eyebrow:        "Hi, I'm",
						Title:          props.Name,
						Status:         "Available for opportunities",
						AnimatedStatus: true,
						TitleClass:     "text-gradient-brand",
					}) {
						<p class="page-hero-description">
							<span class="home-hero-role">{ props.Role }</span>
							<span>{ props.Description }</span>
						</p>
						<div class="page-hero-actions home-overlook-actions">
							<a href="/experience" class="page-kit-action page-kit-action-primary">
								<span>View Experience</span>
								<span class="btn-icon" aria-hidden="true">→</span>
							</a>
							<a href="/projects" class="page-kit-action home-overlook-secondary-action">
								<span>See Projects</span>
							</a>
							<a href="/contact" class="page-kit-action home-overlook-secondary-action">
								Get in Touch
							</a>
						</div>
						@partials.StatCardGrid(partials.StatCardGridProps{
							Cards:     homeStatCards(props),
							GridClass: "hero-stats home-overlook-stats",
						})
					}
				</div>
			</section>
			<section class="page-section home-capabilities-section" data-region="topology">
				@partials.SectionIntro(partials.SectionIntroProps{
					Label:      "How I Work",
					Title:      "Reliable systems, clear handoffs",
					ExtraClass: "home-section-intro",
				})
				<div class="home-topology-map">
					@partials.SignalTrail(partials.SignalTrailProps{Variant: partials.TrailTopology, ExtraClass: "home-topology-trail"})
					<div class="home-capabilities-grid home-capabilities-path">
						for _, card := range homeFeatureCards() {
							@partials.FeatureCard(card)
						}
					</div>
				</div>
			</section>
		</div>
	}
}
