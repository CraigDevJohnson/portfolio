package pages

import (
	"fmt"
	"portfolio/cmd/web/layouts"
	"portfolio/cmd/web/partials"
)

type HomeProps struct {
	Name               string
	Role               string
	AvatarURL          string
	Description        string
	YearsInTech        int
	Certifications     int
	AutomationProjects string
}

func homeFeatureCards() []partials.FeatureCardProps {
	return []partials.FeatureCardProps{
		{Icon: "☁️", Title: "Cloud Architecture", Description: "Designing and implementing scalable, secure cloud infrastructure on AWS and Azure.", Tone: "accent", ExtraClass: "stagger-enter"},
		{Icon: "⚙️", Title: "Infrastructure as Code", Description: "Automating infrastructure with Terraform, CloudFormation, and Ansible for repeatable deployments.", Tone: "primary", ExtraClass: "stagger-enter"},
		{Icon: "🔄", Title: "CI/CD & DevOps", Description: "Building pipelines with GitHub Actions and implementing GitOps for continuous delivery.", Tone: "secondary", ExtraClass: "stagger-enter"},
		{Icon: "🔒", Title: "Security & Compliance", Description: "Implementing zero-trust architecture, IAM policies, and security automation.", Tone: "secondary", ExtraClass: "stagger-enter"},
	}
}

func homeStatCards(props HomeProps) []partials.StatCardProps {
	return []partials.StatCardProps{
		{Value: fmt.Sprintf("%d", props.YearsInTech), Label: "Years Experience", AriaLabel: fmt.Sprintf("%d plus years experience", props.YearsInTech), Suffix: "+", ExtraClass: "stagger-enter px-4 py-5", ValueClass: "text-3xl sm:text-4xl"},
		{Value: fmt.Sprintf("%d", props.Certifications), Label: "Certifications", AriaLabel: fmt.Sprintf("%d plus certifications", props.Certifications), Suffix: "+", ExtraClass: "stagger-enter px-4 py-5", ValueClass: "text-3xl sm:text-4xl"},
		{Value: props.AutomationProjects, Label: "Automation Projects", AriaLabel: fmt.Sprintf("%s plus automation projects", props.AutomationProjects), Suffix: "+", ExtraClass: "stagger-enter px-4 py-5", ValueClass: "text-3xl sm:text-4xl"},
	}
}

func homeExploreCards() []partials.LinkPanelCardProps {
	return []partials.LinkPanelCardProps{
		{Href: "/experience", Icon: "💼", Title: "Experience", Description: "View my professional journey through cloud engineering and IT.", CTA: "Explore", Tone: "accent", ExtraClass: "stagger-enter"},
		{Href: "/skills", Icon: "🛠️", Title: "Skills", Description: "The tools and technologies I use to build, automate, and ship reliably.", CTA: "Explore", Tone: "primary", ExtraClass: "stagger-enter"},
		{Href: "/projects", Icon: "🚀", Title: "Projects", Description: "Real-world applications, automation, and infrastructure tools I've built.", CTA: "Explore", Tone: "secondary", ExtraClass: "stagger-enter"},
		{Href: "/soccer", Icon: "⚽", Title: "Soccer Tool", Description: "A schedule download utility built to streamline match-day planning.", CTA: "Explore", Tone: "accent", ExtraClass: "stagger-enter"},
	}
}

templ Home(props HomeProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Craig Johnson - Cloud Engineer Principal",
		Page:  "home",
	}) {
		<div class="page-kit-page">
			@partials.PageHero(partials.PageHeroProps{
				ImageURL:     "/static/images/backgrounds/home-hero.jpg",
				ImagePosition: "center",
				ImageFilter:   "saturate(0.76) contrast(0.84) brightness(0.54) blur(1.25px)",
				ContentClass:  "lg:py-14",
			}) {
					<div class="grid gap-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-center lg:gap-10">
						<div class="flex justify-center lg:justify-start">
							<a
								href="https://gravatar.com/craigdevjohnson1"
								target="_blank"
								rel="noopener noreferrer"
								class="focus-ring group relative inline-flex rounded-full"
								aria-label="View Craig Johnson's Gravatar profile (opens in new tab)"
							>
								<span class="absolute inset-[-0.5rem] rounded-full bg-[image:var(--accent-primary-gradient)] opacity-70 blur-[1px] transition duration-300 group-hover:scale-[1.02]" aria-hidden="true"></span>
								<span class="absolute inset-[-2rem] rounded-full bg-radial from-accent-400/25 via-accent-300/10 to-transparent" aria-hidden="true"></span>
								<img
									src={ props.AvatarURL }
									alt={ props.Name }
									class="relative h-[13rem] w-[13rem] rounded-full border-4 border-carbon-black-950 object-cover shadow-panel-strong transition duration-300 group-hover:scale-[1.02] sm:h-[15rem] sm:w-[15rem] lg:h-[17.25rem] lg:w-[17.25rem]"
									width="275"
									height="275"
									loading="eager"
								/>
							</a>
						</div>
						<div class="flex flex-col gap-6">
							<div class="page-kit-status-pill">
								<span class="page-kit-status-dot motion-safe:animate-pulse" aria-hidden="true"></span>
								Available for opportunities
							</div>
							<h1 class="flex flex-col gap-2">
								<span class="text-xl font-medium text-copy-muted sm:text-2xl">Hi, I'm</span>
								<span class="text-gradient-brand text-5xl font-extrabold leading-none sm:text-6xl lg:text-7xl">{ props.Name }</span>
							</h1>
							<h2 class="text-2xl font-semibold text-copy-secondary sm:text-3xl">{ props.Role }</h2>
							<p class="max-w-2xl text-sm leading-7 text-copy-secondary sm:text-lg sm:leading-8">{ props.Description }</p>
							<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
								<a href="/experience" class="page-kit-action page-kit-action-primary w-full gap-2 sm:w-auto sm:min-w-[11rem]">
									<span>View Experience</span>
									<span class="btn-icon" aria-hidden="true">→</span>
								</a>
								<a href="/projects" class="page-kit-action w-full sm:w-auto sm:min-w-[11rem]">
									<span>See Projects</span>
								</a>
								<a href="/contact" class="page-kit-action w-full sm:w-auto sm:min-w-[11rem]">
									Get in Touch
								</a>
							</div>
							@partials.StatCardGrid(partials.StatCardGridProps{
								Cards:     homeStatCards(props),
								GridClass: "hero-stats grid gap-3 border-t border-carbon-black-700 pt-5 sm:grid-cols-3 sm:gap-4 sm:pt-6",
							})
						</div>
					</div>
			}
		<!-- What I Do -->
		<section class="page-section">
			@partials.SectionLabel("What I Do")
			<h2 class="page-section-title">Building the future of infrastructure</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				for _, card := range homeFeatureCards() {
					@partials.FeatureCard(card)
				}
			</div>
		</section>
		<!-- Explore -->
		<section class="page-section">
			@partials.SectionLabel("Explore")
			<h2 class="page-section-title">Dive deeper</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				for _, card := range homeExploreCards() {
					@partials.LinkPanelCard(card)
				}
			</div>
		</section>
		</div>
	}
}
