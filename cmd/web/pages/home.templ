package pages

import (
	"portfolio/cmd/web/layouts"
	"fmt"
)

type HomeProps struct {
	Name          string
	Role          string
	AvatarURL     string
	Description   string
	YearsInTech   int
	Certifications int
	AutomationProjects string
}

templ Home(props HomeProps) {
	@layouts.Base(layouts.BaseProps{
		Title: "Craig Johnson - Cloud Engineer Principal",
		Page:  "home",
	}) {
		<section
			class="relative isolate min-h-[calc(100vh-var(--header-height))] overflow-hidden rounded-[2rem] border border-carbon-black-800 bg-carbon-black-950 bg-cover bg-center px-6 py-10 shadow-panel-strong sm:px-8 lg:px-12 lg:py-16"
			style="background-image: url('/static/images/backgrounds/home-hero.jpg')"
		>
			<div class="absolute inset-0 bg-linear-to-br from-carbon-black-950/92 via-carbon-black-950/78 to-secondary-950/70"></div>
			<div class="relative z-10 grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-center">
				<div class="flex justify-center lg:justify-start">
					<a
						href="https://gravatar.com/craigdevjohnson1"
						target="_blank"
						rel="noopener noreferrer"
						class="focus-ring group relative inline-flex rounded-full"
						aria-label="View Craig Johnson's Gravatar profile (opens in new tab)"
					>
						<span class="absolute inset-[-0.5rem] rounded-full bg-[image:var(--accent-primary-gradient)] opacity-70 blur-[1px] transition duration-300 group-hover:scale-[1.02]" aria-hidden="true"></span>
						<span class="absolute inset-[-2rem] rounded-full bg-radial from-accent-400/25 via-accent-300/10 to-transparent" aria-hidden="true"></span>
						<img
							src={ props.AvatarURL }
							alt={ props.Name }
							class="relative h-[16rem] w-[16rem] rounded-full border-4 border-carbon-black-950 object-cover shadow-panel-strong transition duration-300 group-hover:scale-[1.02] sm:h-[17.25rem] sm:w-[17.25rem]"
							width="275"
							height="275"
							loading="eager"
						/>
					</a>
				</div>
				<div class="flex flex-col gap-6">
					<div class="inline-flex w-fit items-center gap-3 rounded-full border border-primary-700 bg-primary-950/70 px-4 py-2 text-sm font-semibold text-primary-100 shadow-panel">
						<span class="h-2.5 w-2.5 rounded-full bg-accent-400 motion-safe:animate-pulse" aria-hidden="true"></span>
						Available for opportunities
					</div>
					<h1 class="flex flex-col gap-2">
						<span class="text-xl font-medium text-copy-muted sm:text-2xl">Hi, I'm</span>
						<span class="text-gradient-brand text-5xl font-extrabold leading-none sm:text-6xl lg:text-7xl">{ props.Name }</span>
					</h1>
					<h2 class="text-2xl font-semibold text-copy-secondary sm:text-3xl">{ props.Role }</h2>
					<p class="max-w-2xl text-base leading-7 text-copy-secondary sm:text-lg sm:leading-8">{ props.Description }</p>
					<div class="flex flex-wrap items-center gap-3">
						<a href="/experience" class="btn btn-primary">
							<span>View Experience</span>
							<span class="btn-icon" aria-hidden="true">→</span>
						</a>
						<a href="/projects" class="btn btn-secondary">
							<span>See Projects</span>
						</a>
						<a href="/contact" class="focus-ring inline-flex items-center rounded-xl border border-carbon-black-700 px-4 py-3 text-sm font-semibold text-copy-secondary transition duration-200 hover:border-primary-400 hover:bg-primary-950/40 hover:text-copy-primary">
							Get in Touch
						</a>
					</div>
					<div class="hero-stats grid gap-4 border-t border-carbon-black-700 pt-6 sm:grid-cols-3">
						<div class="surface-card px-4 py-5 text-center">
							<span
								class="text-gradient-brand block text-3xl font-extrabold sm:text-4xl"
								data-counter
								data-target={ fmt.Sprintf("%d", props.YearsInTech) }
								data-suffix="+"
								aria-label={ fmt.Sprintf("%d plus years experience", props.YearsInTech) }
							>0</span>
							<span class="mt-2 block text-sm font-medium text-copy-muted">Years Experience</span>
						</div>
						<div class="surface-card px-4 py-5 text-center">
							<span
								class="text-gradient-brand block text-3xl font-extrabold sm:text-4xl"
								data-counter
								data-target={ fmt.Sprintf("%d", props.Certifications) }
								data-suffix="+"
								aria-label={ fmt.Sprintf("%d plus certifications", props.Certifications) }
							>0</span>
							<span class="mt-2 block text-sm font-medium text-copy-muted">Certifications</span>
						</div>
						<div class="surface-card px-4 py-5 text-center">
							<span
								class="text-gradient-brand block text-3xl font-extrabold sm:text-4xl"
								data-counter
								data-target={ props.AutomationProjects }
								data-suffix="+"
								aria-label={ fmt.Sprintf("%s plus automation projects", props.AutomationProjects) }
							>0</span>
							<span class="mt-2 block text-sm font-medium text-copy-muted">Automation Projects</span>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- What I Do -->
		<section class="space-y-6 py-12 sm:py-14">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>What I Do</span>
			</div>
			<h2 class="text-3xl font-bold tracking-tight text-copy-primary">Building the future of infrastructure</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<article class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-700/70 bg-accent-950/60 text-3xl shadow-panel">
						<span aria-hidden="true">☁️</span>
					</div>
					<h3 class="text-lg font-semibold text-copy-primary">Cloud Architecture</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Designing and implementing scalable, secure cloud infrastructure on AWS and Azure.</p>
				</article>
				<article class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-700/70 bg-primary-950/60 text-3xl shadow-panel">
						<span aria-hidden="true">⚙️</span>
					</div>
					<h3 class="text-lg font-semibold text-copy-primary">Infrastructure as Code</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Automating infrastructure with Terraform, CloudFormation, and Ansible for repeatable deployments.</p>
				</article>
				<article class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-700/70 bg-secondary-950/70 text-3xl shadow-panel">
						<span aria-hidden="true">🔄</span>
					</div>
					<h3 class="text-lg font-semibold text-copy-primary">CI/CD &amp; DevOps</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Building pipelines with GitHub Actions and implementing GitOps for continuous delivery.</p>
				</article>
				<article class="surface-card stagger-enter p-6 text-center">
					<div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-secondary-700/60 bg-secondary-950/60 text-3xl shadow-panel">
						<span aria-hidden="true">🔒</span>
					</div>
					<h3 class="text-lg font-semibold text-copy-primary">Security &amp; Compliance</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Implementing zero-trust architecture, IAM policies, and security automation.</p>
				</article>
			</div>
		</section>
		<!-- Explore -->
		<section class="space-y-6 py-12 sm:py-14">
			<div class="section-label">
				<span class="label-line" aria-hidden="true"></span>
				<span>Explore</span>
			</div>
			<h2 class="text-3xl font-bold tracking-tight text-copy-primary">Dive deeper</h2>
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<a href="/experience" class="surface-card stagger-enter group block p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-accent-400 hover:shadow-panel-strong">
					<span class="mb-4 block text-3xl" aria-hidden="true">💼</span>
					<h3 class="text-lg font-semibold text-copy-primary">Experience</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">View my professional journey through cloud engineering and IT.</p>
					<span class="mt-5 inline-flex items-center text-sm font-semibold text-accent-300 transition duration-200 group-hover:translate-x-1">Explore<span class="ml-2" aria-hidden="true">→</span></span>
				</a>
				<a href="/skills" class="surface-card stagger-enter group block p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-primary-400 hover:shadow-panel-strong">
					<span class="mb-4 block text-3xl" aria-hidden="true">🛠️</span>
					<h3 class="text-lg font-semibold text-copy-primary">Skills</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">The tools and technologies I use to build, automate, and ship reliably.</p>
					<span class="mt-5 inline-flex items-center text-sm font-semibold text-primary-200 transition duration-200 group-hover:translate-x-1">Explore<span class="ml-2" aria-hidden="true">→</span></span>
				</a>
				<a href="/projects" class="surface-card stagger-enter group block p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-secondary-400 hover:shadow-panel-strong">
					<span class="mb-4 block text-3xl" aria-hidden="true">🚀</span>
					<h3 class="text-lg font-semibold text-copy-primary">Projects</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">Real-world applications, automation, and infrastructure tools I&apos;ve built.</p>
					<span class="mt-5 inline-flex items-center text-sm font-semibold text-secondary-200 transition duration-200 group-hover:translate-x-1">Explore<span class="ml-2" aria-hidden="true">→</span></span>
				</a>
				<a href="/soccer" class="surface-card stagger-enter group block p-6 text-copy-primary no-underline transition duration-200 ease-out hover:-translate-y-1 hover:border-accent-400 hover:shadow-panel-strong">
					<span class="mb-4 block text-3xl" aria-hidden="true">⚽</span>
					<h3 class="text-lg font-semibold text-copy-primary">Soccer Tool</h3>
					<p class="mt-3 text-sm leading-6 text-copy-secondary">A schedule download utility built to streamline match-day planning.</p>
					<span class="mt-5 inline-flex items-center text-sm font-semibold text-accent-300 transition duration-200 group-hover:translate-x-1">Explore<span class="ml-2" aria-hidden="true">→</span></span>
				</a>
			</div>
		</section>
	}
}
