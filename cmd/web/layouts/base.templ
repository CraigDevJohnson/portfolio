package layouts

import "portfolio/cmd/web/partials"

type BaseProps struct {
	Title       string
	Page        string
	Description string
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta
				name="description"
				if props.Description != "" {
					content={ props.Description }
				} else {
					content="Craig Johnson - Cloud Engineer Principal specializing in cloud infrastructure, automation, and DevOps."
				}
			/>
			<meta name="author" content="Craig Johnson"/>
			<meta name="theme-color" content="#1c1917"/>
			<title>{ props.Title }</title>
			<!-- Favicons -->
			<link rel="icon" type="image/png" sizes="32x32" href="/static/images/favicon-32x32.png?v=20260405b"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/static/images/favicon-16x16.png?v=20260405b"/>
			<link rel="icon" type="image/x-icon" href="/static/images/favicon.ico?v=20260405b"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/images/apple-touch-icon.png?v=20260405b"/>
			<link rel="manifest" href="/static/images/site.webmanifest?v=20260405c"/>
			<!-- Fonts -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
				rel="stylesheet"
			/>
			<!-- Styles -->
			<link rel="stylesheet" href="/static/css/tailwind.css?v=20260428a"/>
			<!-- HTMX with integrity check -->
			<script
				src="https://unpkg.com/htmx.org@1.9.10"
				integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC"
				crossorigin="anonymous"
			></script>
			<script src="/static/js/main.js?v=20260423a" defer></script>
		</head>
		<body
			if props.Page == "soccer" {
				class="soccer-theme"
			}
		>
			<a href="#maincontent" class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded-lg focus:border focus:border-white/15 focus:bg-primary-950 focus:px-4 focus:py-2 focus:text-copy-primary">Skip to main content</a>
			@partials.Header(props.Page)
			<main id="maincontent" class="main-content flex-1 pt-[var(--header-height)]" tabindex="-1">
				<div class="container mx-auto w-full max-w-[var(--container-max)] px-6 max-[480px]:px-4">
					{ children... }
				</div>
			</main>
			@partials.Footer()
		</body>
	</html>
}
