package layouts

import "portfolio/cmd/web/partials"

type BaseProps struct {
	Title       string
	Page        string
	Description string
	Shell       ShellVariant
}

type ShellVariant string

const (
	ShellPublic   ShellVariant = "public"
	ShellOperator ShellVariant = "operator"
)

func normalizedShell(shell ShellVariant) ShellVariant {
	if shell == ShellOperator {
		return ShellOperator
	}
	return ShellPublic
}

func baseBodyClasses(page string) string {
	classes := "site-body"
	if page != "" {
		classes += " page-" + page
	}
	if page == "soccer" {
		classes += " soccer-theme"
	}
	return classes
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta
				name="description"
				if props.Description != "" {
					content={ props.Description }
				} else {
					content="Craig Johnson - Cloud Engineer Principal specializing in cloud infrastructure, automation, and DevOps."
				}
			/>
			<meta name="author" content="Craig Johnson"/>
			<meta name="theme-color" content="#17121B"/>
			<title>{ props.Title }</title>
			<!-- Favicons -->
			<link rel="icon" type="image/svg+xml" href="/static/images/favicon.svg?v=20260819a"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/images/favicon-32x32.png?v=20260819a"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/static/images/favicon-16x16.png?v=20260819a"/>
			<link rel="icon" type="image/x-icon" href="/static/images/favicon.ico?v=20260819a"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/images/apple-touch-icon.png?v=20260819a"/>
			<link rel="manifest" href="/static/images/site.webmanifest?v=20260819a"/>
			<!-- Fonts -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
				rel="stylesheet"
			/>
			<!-- Styles -->
			<link rel="stylesheet" href="/static/css/tailwind.css?v=20260818c"/>
			<!-- HTMX with integrity check -->
			<script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
			<script src="/static/js/main.js?v=20260810d" defer></script>
		</head>
		<body class={ baseBodyClasses(props.Page) } data-shell={ string(normalizedShell(props.Shell)) }>
			<a href="#maincontent" class="site-skip-link">Skip to main content</a>
			@partials.Header(props.Page)
			<main id="maincontent" class="main-content flex-1 pt-[var(--header-height)]" tabindex="-1">
				<div class="site-page-shell container mx-auto w-full px-4 sm:px-6">
					{ children... }
				</div>
			</main>
			if normalizedShell(props.Shell) == ShellOperator {
				@partials.OperatorFooter()
			} else {
				@partials.Footer()
			}
		</body>
	</html>
}
