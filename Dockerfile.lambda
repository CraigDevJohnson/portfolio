FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /bootstrap ./cmd/lambda

FROM public.ecr.aws/lambda/provided:al2023

WORKDIR /var/task

COPY --from=builder /bootstrap ./bootstrap
COPY cmd/web/static ./cmd/web/static

CMD [ "bootstrap" ]
